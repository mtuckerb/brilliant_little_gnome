#!/bin/sh

# Brilliant CLI Wrapper
# Isolates the portable Ruby environment from system Ruby pollution

BASE_DIR=$(cd "$(dirname "$0")" && pwd)
PLATFORM_DIR="macos-arm64"
PORTABLE_ROOT="$BASE_DIR/bin/ruby_dist/$PLATFORM_DIR"
PORTABLE_RUBY="$PORTABLE_ROOT/bin/ruby"
BUNDLE_BIN="$PORTABLE_ROOT/bin/bundle"

if [ ! -f "$PORTABLE_RUBY" ]; then
    echo "Error: Portable Ruby not found at $PORTABLE_RUBY"
    exit 1
fi

# 1. Clear out system Ruby variables to prevent leaks
unset GEM_HOME
unset GEM_PATH
unset RUBYLIB
unset RUBYOPT

# 2. Configure Bundler environment
export BUNDLE_GEMFILE="$BASE_DIR/Gemfile"
export BUNDLE_PATH="$BASE_DIR/vendor/bundle"
export BUNDLE_DEPLOYMENT="true"

# Detect Ruby version directory
if [ -d "$BASE_DIR/vendor/bundle/ruby" ]; then
    RUBY_VER_DIR=$(ls -1 "$BASE_DIR/vendor/bundle/ruby" | head -n 1)
else
    RUBY_VER_DIR="3.4.0"
fi

# 3. Force Ruby to only look at our portable dist and vendor bundle
# Standard internal paths
INTERNAL_GEMS="$PORTABLE_ROOT/lib/ruby/gems/$RUBY_VER_DIR"
VENDOR_GEMS="$BASE_DIR/vendor/bundle/ruby/$RUBY_VER_DIR"

export GEM_PATH="$VENDOR_GEMS:$INTERNAL_GEMS"
export GEM_HOME="$VENDOR_GEMS"

echo "Using Ruby version directory: $RUBY_VER_DIR"

# 4. Update PATH so the portable 'ruby' is found first if any gems spawn sub-processes
export PATH="$PORTABLE_ROOT/bin:$PATH"

# If no command is provided, show help
if [ $# -eq 0 ]; then
    echo "Brilliant Portable CLI (Ruby 3.4.5)"
    echo "Usage: ./brilliant [command] [args...]"
    exit 0
fi

COMMAND=$1
shift

case "$COMMAND" in
    rake)
        exec "$PORTABLE_RUBY" "$BUNDLE_BIN" exec rake "$@"
        ;;
    bundle)
        exec "$PORTABLE_RUBY" "$BUNDLE_BIN" "$@"
        ;;
    ruby)
        exec "$PORTABLE_RUBY" "$@"
        ;;
    *)
        exec "$PORTABLE_RUBY" "$BUNDLE_BIN" exec "$COMMAND" "$@"
        ;;
esac
