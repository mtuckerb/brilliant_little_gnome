<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for physical-device iOS/iPadOS dev builds that load the Vite dev server over the LAN/TUN address. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Brilliant needs local network access during development to connect to the Tauri/Vite dev server running on your Mac.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_http._tcp</string>
    <string>_https._tcp</string>
  </array>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoadsInWebContent</key>
    <true/>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
</dict>
</plist>
