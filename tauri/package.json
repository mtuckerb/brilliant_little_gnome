{
  "name": "brilliant-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "ensure:deps": "node scripts/ensure-frontend-deps.mjs",
    "dev": "npm run ensure:deps && vite",
    "dev:ios": "npm run ensure:deps && tauri ios dev --host 127.0.0.1",
    "dev:ios:remote": "npm run ensure:deps && BRILLIANT_TAURI_REMOTE_DEV=1 tauri ios dev --force-ip-prompt",
    "test:config": "node scripts/assert-dev-host-config.mjs",
    "test:rust": "mkdir -p dist && cd src-tauri && cargo test downloads",
    "check:rust": "mkdir -p dist && cd src-tauri && cargo test",
    "prebuild": "npm run ensure:deps",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "npm run ensure:deps && tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.4.2"
  }
}
