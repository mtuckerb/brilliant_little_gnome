<%= erb :'partials/course_detail_header' %>
<div class="columns">
  <div class="column is-3">
    <%= erb :'partials/sidebar' %>
  </div>
  <div class="column is-9" id="discussions-root">
    <div class="is-flex is-justify-content-center is-align-items-center" style="min-height: 400px;">
      <div class="has-text-centered">
        <span class="icon is-large has-text-primary mb-4">
          <i class="fas fa-circle-notch fa-spin fa-3x"></i>
        </span>
        <p class="is-size-5 has-text-grey">Loading Discussions...</p>
      </div>
    </div>
  </div>
</div>

<script>
  const COURSE_ID = "<%= @course_id %>";

  async function loadDiscussions() {
    const root = document.getElementById('discussions-root');
    try {
      const response = await fetch(`/api/v1/courses/${COURSE_ID}/discussions`);
      if (!response.ok) throw new Error("Failed to fetch discussions");
      const data = await response.json();
      renderDiscussions(data);
    } catch (err) {
      console.error(err);
      root.innerHTML = `
        <div class="notification is-danger">
          <h3 class="title is-5">Error Connection Lost</h3>
          <p>Failed to load discussions. Please ensure the backend is running.</p>
          <button class="button is-white is-small mt-2" onclick="location.reload()">Retry</button>
        </div>
      `;
    }
  }

  function renderDiscussions(data) {
    const root = document.getElementById('discussions-root');
    const { topics } = data;

    if (!topics || topics.length === 0) {
      root.innerHTML = `
        <div class="box">
          <h4 class="title is-4"><i class="fas fa-comments mr-2"></i> Discussions</h4>
          <p class="has-text-grey">No discussion topics found for this course.</p>
        </div>
      `;
      return;
    }

    // Sort by last post date
    const sortedTopics = [...topics].sort((a, b) => {
      const dateA = a.last_post_date ? new Date(a.last_post_date) : new Date(0);
      const dateB = b.last_post_date ? new Date(b.last_post_date) : new Date(0);
      return dateB - dateA;
    });

    let html = `
      <div class="box">
        <div class="level">
          <div class="level-left">
            <h4 class="title is-4"><i class="fas fa-comments mr-2"></i> Discussion Topics</h4>
          </div>
        </div>
        
        <table class="table is-fullwidth is-hoverable">
          <thead>
            <tr>
              <th>Topic</th>
              <th class="has-text-centered">Threads</th>
              <th class="has-text-centered">Posts</th>
              <th>Last Post</th>
            </tr>
          </thead>
          <tbody>
            ${sortedTopics.map(topic => `
              <tr>
                <td>
                  <a href="/course/${COURSE_ID}/discussions/${topic.forum_id}/topics/${topic.brightspace_id}" class="has-text-weight-bold">
                    ${topic.name}
                  </a>
                  <div class="is-size-7 has-text-grey">
                    ${topic.created_at ? 'Created: ' + new Date(topic.created_at).toLocaleDateString() : ''}
                  </div>
                </td>
                <td class="has-text-centered">
                    ${topic.display_thread_count || 0}
                </td>
                <td class="has-text-centered">
                    ${topic.display_post_count || 0}
                </td>
                <td class="is-size-7">
                  ${topic.last_post_date ? `
                    ${new Date(topic.last_post_date).toLocaleDateString()}<br>
                    <span class="has-text-grey">${new Date(topic.last_post_date).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>
                  ` : '<span class="has-text-grey-light">Never</span>'}
                </td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `;

    root.innerHTML = html;
  }

  document.addEventListener('DOMContentLoaded', () => loadDiscussions());
</script>
