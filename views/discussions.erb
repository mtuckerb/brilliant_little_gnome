<%= erb :'partials/course_detail_header' %>
<div class="columns">
  <div class="column is-3">
    <%= erb :'partials/sidebar' %>
  </div>
  <div class="column is-9">
    <div class="box">
      <div class="level">
        <div class="level-left">
          <h4 class="title is-4"><i class="fas fa-comments mr-2"></i> Discussion Topics</h4>
        </div>
      </div>
      
      <% if @topics && @topics.any? %>
        <table class="table is-fullwidth is-hoverable">
          <thead>
            <tr>
              <th>Topic</th>
              <th class="has-text-centered">Threads</th>
              <th class="has-text-centered">Posts</th>
              <th>Last Post</th>
            </tr>
          </thead>
          <tbody>
            <% 
               # Normalize and sort by last post date
               sorted_topics = @topics.sort_by do |t| 
                 date = if t.is_a?(DiscussionTopic)
                   t.last_post_date
                 else
                   t['LastPostDate'] ? Time.parse(t['LastPostDate']) : nil
                 end
                 date || Time.at(0)
               end.reverse
               
               sorted_topics.each do |topic| 
                  is_obj = topic.is_a?(DiscussionTopic)
                  topic_id = is_obj ? topic.brightspace_id : topic['TopicId']
                 forum_id = is_obj ? topic.forum_id : topic['ForumId']
                 name = is_obj ? topic.name : topic['Name']
                 thread_count = is_obj ? topic.thread_count : topic['ThreadCount']
                 post_count = is_obj ? topic.post_count : topic['PostCount']
                 last_post_date = is_obj ? topic.last_post_date : (topic['LastPostDate'] ? Time.parse(topic['LastPostDate']) : nil)
                 created_date = is_obj ? topic.created_at : topic['StartDate']
            %>
              <tr>
                <td>
                  <a href="/course/<%= @course_id %>/discussions/<%= forum_id %>/topics/<%= topic_id %>" class="has-text-weight-bold">
                    <%= name %>
                  </a>
                  <div class="is-size-7 has-text-grey">
                    <% if created_date %>
                        Created: <%= format_date(created_date, "%b %d, %Y") %>
                    <% end %>
                  </div>
                </td>
                <td class="has-text-centered">
                    <%= thread_count || 0 %>
                </td>
                <td class="has-text-centered">
                    <%= post_count || 0 %>
                </td>
                <td class="is-size-7">
                  <% if last_post_date %>
                    <%= format_date(last_post_date, "%b %d, %Y") %><br>
                    <span class="has-text-grey"><%= format_date(last_post_date, "%I:%M %p") %></span>
                  <% else %>
                    <span class="has-text-grey-light">Never</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="has-text-grey">No discussion topics found for this course.</p>
      <% end %>
    </div>
  </div>
</div>
