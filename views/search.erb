<%= erb :'partials/course_detail_header' %>
<div class="columns">
  <div class="column is-3">
    <%= erb :'partials/sidebar' %>
  </div>
  <div class="column is-9">
    <div class="box">
      <h4 class="title is-4"><i class="fas fa-search mr-2"></i> Search Results for "<%= @query %>"</h4>
      
      <% if @results && (@results[:modules].any? || @results[:topics].any?) %>
        
        <% if @results[:modules].any? %>
          <h5 class="subtitle is-5 mt-5">Modules</h5>
          <div class="list is-hoverable">
            <% @results[:modules].each do |m| %>
              <a href="/course/<%= @course_id %>/module/<%= m[:id] %>" class="list-item">
                <span class="icon is-small has-text-primary mr-2"><i class="fas fa-folder"></i></span>
                <%= m[:title] %>
              </a>
            <% end %>
          </div>
        <% end %>

        <% if @results[:topics].any? %>
          <h5 class="subtitle is-5 mt-5">Topics / Files</h5>
          <div class="list is-hoverable">
            <% @results[:topics].each do |t| %>
              <div class="list-item">
                <div class="is-flex is-justify-content-space-between is-align-items-center">
                  <div>
                    <span class="topic-icon mr-2">
                      <% if t[:type] == 1 %>
                        <i class="fas fa-file"></i>
                      <% elsif t[:type] == 3 %>
                        <i class="fas fa-link"></i>
                      <% else %>
                        <i class="fas fa-info-circle"></i>
                      <% end %>
                    </span>
                    <a href="/course/<%= @course_id %>/module/<%= t[:module_id] %>" class="has-text-weight-medium"><%= t[:title] %></a>
                  </div>
                  <% if t[:is_downloadable] %>
                    <a href="/course/<%= @course_id %>/topic/<%= t[:id] %>/download" class="button is-small is-link is-outlined" target="_blank">
                      <i class="fas fa-download mr-1"></i> Download
                    </a>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

      <% else %>
        <div class="notification is-light">
          No results found matching your query.
        </div>
      <% end %>
    </div>
  </div>
</div>
