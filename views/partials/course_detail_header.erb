<%= erb :'partials/notification_banner' %>

<nav class="breadcrumb mb-4" aria-label="breadcrumbs">
  <ul>
    <li>
      <a href="/dashboard">
        <span class="icon is-small" style="margin-top: 5px;">
          <i class="fas fa-home"></i>
        </span>
      </a>
    </li>
    <li><a href="/dashboard">Courses</a></li>
    <li><a href="/course/<%= @course_id %>" title="<%= @course_name %>"><%= truncate_text(@course_name) %></a></li>
    
    <% if @breadcrumb_trail %>
      <% @breadcrumb_trail.each_with_index do |crumb, index| %>
        <li class="<%= 'is-active' if index == @breadcrumb_trail.size - 1 %>">
          <a href="<%= crumb[:url] %>" <%= 'aria-current="page"' if index == @breadcrumb_trail.size - 1 %> title="<%= crumb[:title] %>">
            <%= truncate_text(crumb[:title]) %>
          </a>
        </li>
      <% end %>
    <% elsif @breadcrumbs %>
      <% @breadcrumbs.each_with_index do |crumb, index| %>
        <li class="<%= 'is-active' if index == @breadcrumbs.size - 1 %>">
          <a href="/course/<%= @course_id %>/module/<%= crumb[:id] %>" <%= 'aria-current="page"' if index == @breadcrumbs.size - 1 %> title="<%= crumb[:title] %>">
            <%= truncate_text(crumb[:title]) %>
          </a>
        </li>
      <% end %>
    <% end %>
  </ul>
</nav>

<% course_code = @course.code.to_s if @course && @course.respond_to?(:code) && !@course.code.to_s.empty? %>
<% title_overridden = @course&.custom_name.present? %>
<% banner_url = @course.banner_url.to_s if @course && @course.respond_to?(:banner_url) && !@course.banner_url.to_s.empty? %>
<% hero_style = "border-radius: 12px; overflow: hidden; position: relative; border: 1px solid #739AC3; box-shadow: 0 4px 15px rgba(0,0,0,0.1);" %>
<% if banner_url %>
  <% hero_style += " background: url('/api/proxy/banner?url=#{ERB::Util.url_encode(banner_url)}') center center; background-size: cover;" %>
<% else %>
  <% hero_style += " background: linear-gradient(135deg, #2f4f6f 0%, #739AC3 100%);" %>
<% end %>

<section class="hero is-small mb-6" style="<%= hero_style %>">
  <div class="hero-body" style="background: linear-gradient(to right, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.1) 100%); padding: 3rem 2rem;">
    <div class="container">
      <div id="course-title-display" class="is-flex is-align-items-center mb-2" style="gap: 0.75rem;">
        <h1 class="title is-2 has-text-white mb-0" style="text-shadow: 0 2px 10px rgba(0,0,0,0.8); line-height: 1.1;">
          <%= @course_name %>
        </h1>
        <button class="button is-small is-light is-outlined" type="button" title="Edit course title" onclick="document.getElementById('course-title-display').style.display='none'; document.getElementById('course-title-form').classList.remove('is-hidden'); document.getElementById('course-title-input').focus();">
          <span class="icon"><i class="fas fa-pencil-alt"></i></span>
        </button>
      </div>
      <form id="course-title-form" action="/course/<%= @course_id %>/update_name" method="post" class="mb-2 is-hidden" style="max-width: 900px;">
        <div class="field has-addons is-align-items-center">
          <div class="control is-expanded">
            <input
              id="course-title-input"
              class="input is-large"
              type="text"
              name="name"
              value="<%= @course_name %>"
              placeholder="Course title"
              aria-label="Course title"
            >
          </div>
          <div class="control"><button class="button is-light is-large" type="submit">Save</button></div>
          <div class="control"><button class="button is-dark is-large" type="button" onclick="document.getElementById('course-title-form').classList.add('is-hidden'); document.getElementById('course-title-display').style.display='flex';">Cancel</button></div>
        </div>
        <% if title_overridden %>
          <p class="help has-text-white">Clear this field and save to revert to the Brightspace title.</p>
        <% end %>
      </form>
      <% if course_code %>
        <div style="position: absolute; bottom: 10px; right: 20px; opacity: 0.75;">
          <p class="is-size-7 has-text-white is-uppercase" style="letter-spacing: 1.5px; text-shadow: 0 1px 2px rgba(0,0,0,0.5);">
            <%= course_code %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</section>
