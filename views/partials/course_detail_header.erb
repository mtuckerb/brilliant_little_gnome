<nav class="breadcrumb" aria-label="breadcrumbs">
  <ul>
    <li><a href="/dashboard">Courses</a></li>
    <li><a href="/course/<%= @course_id %>"><%= @course_name %></a></li>
    <% if @breadcrumbs %>
      <% @breadcrumbs.each_with_index do |crumb, index| %>
        <li class="<%= 'is-active' if index == @breadcrumbs.size - 1 %>">
          <a href="/course/<%= @course_id %>/module/<%= crumb[:id] %>" <%= 'aria-current="page"' if index == @breadcrumbs.size - 1 %>><%= crumb[:title] %></a>
        </li>
      <% end %>
    <% end %>
  </ul>
</nav>
<h1 class="title mb-5"><%= @course_name %></h1>
