<% if params[:from_notification] %>
  <div class="notification is-info is-light mb-4 py-2" id="notification-banner">
    <div class="level is-mobile px-3">
      <div class="level-left">
        <p class="is-size-7">
          <i class="fas fa-info-circle mr-2"></i>
          Marked as read.
        </p>
      </div>
      <div class="level-right">
        <form action="/notifications/<%= params[:from_notification] %>/mark_unread" method="post" class="mr-2">
          <button type="submit" class="button is-small is-info is-outlined">
            Keep Unread
          </button>
        </form>
        <button class="delete is-small" onclick="document.getElementById('notification-banner').remove()"></button>
      </div>
    </div>
  </div>
<% end %>
