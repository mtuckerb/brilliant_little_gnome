<aside class="menu">
  <p class="menu-label">General</p>
  <ul class="menu-list">
    <li><a href="/course/<%= @course_id %>" class="<%= 'is-active' if @active_tab == 'overview' %>">
      <span class="icon is-small mr-2"><i class="fas fa-info-circle"></i></span> Syllabus / Overview</a>
    </li>
    <li><a href="/notifications?course_id=<%= @course_id %>" class="<%= 'is-active' if @active_tab == 'notifications' %>">
      <span class="icon is-small mr-2"><i class="fas fa-bell"></i></span> Course Notifications</a>
    </li>
    <li><a href="/course/<%= @course_id %>/announcements" class="<%= 'is-active' if @active_tab == 'announcements' %>">
      <span class="icon is-small mr-2"><i class="fas fa-bullhorn"></i></span> Announcements</a>
    </li>
    <li><a href="/course/<%= @course_id %>/assignments" class="<%= 'is-active' if @active_tab == 'assignments' %>">
      <span class="icon is-small mr-2"><i class="fas fa-tasks"></i></span> Assignments</a>
    </li>
    <li><a href="/course/<%= @course_id %>/grades" class="<%= 'is-active' if @active_tab == 'grades' %>">
      <span class="icon is-small mr-2"><i class="fas fa-poll"></i></span> Grades</a>
    </li>
    <li><a href="/course/<%= @course_id %>/discussions" class="<%= 'is-active' if @active_tab == 'discussions' %>">
      <span class="icon is-small mr-2"><i class="fas fa-comments"></i></span> Discussions</a>
    </li>
  </ul>
  
  <div class="is-flex is-justify-content-space-between is-align-items-center mt-4 mb-2">
    <p class="menu-label mb-0">Table of Contents</p>
    <div class="buttons">
      <button id="toc-toggle-btn" class="button is-ghost is-small p-0 h-auto" onclick="toggleAllTOC()" title="Expand/Collapse All">
        <span class="icon is-small"><i id="toc-toggle-icon" class="fas fa-expand-arrows-alt"></i></span>
      </button>
    </div>
  </div>

  <div class="px-2 mb-4">
    <form action="/course/<%= @course_id %>/search" method="GET">
      <div class="field has-addons">
        <div class="control is-expanded">
          <input class="input is-small" type="text" name="q" placeholder="Search course..." value="<%= params[:q] %>">
        </div>
        <div class="control">
          <button type="submit" class="button is-small is-primary">
            <i class="fas fa-search"></i>
          </button>
        </div>
      </div>
    </form>
  </div>

  <ul class="menu-list" style="list-style-type: none; margin-left: 0;">
    <% if @toc && @toc['Modules'] %>
      <% @toc['Modules'].each do |mod| %>
        <%= erb :'partials/toc_recursive', locals: { mod: mod, depth: 0 } %>
      <% end %>
    <% else %>
      <li><span class="has-text-grey-light">No modules found.</span></li>
    <% end %>
  </ul>
</aside>

<script>
  function toggleAllTOC() {
    const details = document.querySelectorAll('.toc-details');
    // If any are closed, open them all. Otherwise close them all.
    const anyClosed = Array.from(details).some(d => !d.open);
    const newState = anyClosed; 
    
    details.forEach(d => d.open = newState);
    
    // Update button icon/title
    const btnIcon = document.querySelector('#toc-toggle-icon');
    if (newState) {
      btnIcon.className = 'fas fa-compress-arrows-alt';
    } else {
      btnIcon.className = 'fas fa-expand-arrows-alt';
    }
  }
</script>

<style>
  .h-auto { height: auto !important; }
</style>
