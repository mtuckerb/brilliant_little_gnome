<% if  !@notifications || @notifications.empty? %>
  <div class="box has-text-centered py-6">
    <span class="icon is-large has-text-grey-light mb-4">
      <i class="fas fa-bell-slash fa-2x"></i>
    </span>
    <p class="has-text-grey">No notifications found with these filters.</p>
  </div>
  <% elsif @notifications && @notifications.count > 0 %>
  <div class="notification-list">
    <% @notifications.each do |n| %>
      <div class="box mb-3 notification-card p-4 <%= 'is-read' if n.is_read %>" id="notification-<%= n.id %>" style="cursor: pointer; border-left: 5px solid <%= n.urgency == 3 ? '#ff3860' : (n.urgency == 2 ? '#ffdd57' : '#3273dc') %>;">
        <div class="columns is-mobile is-vcentered is-gapless mb-0">
          <div class="column">
            <div class="is-flex is-align-items-center mb-1">
              <span class="tag is-small is-rounded mr-2 <%= n.notification_type == 'Grade' ? 'is-success' : (n.notification_type == 'Discussion' ? 'is-warning' : 'is-link') %> is-light">
                <%= n.notification_type %>
              </span>
              <span class="has-text-grey-light is-size-7 mr-2" title="Notification ID">#<%= n.id %></span>
              <span class="is-size-7 has-text-weight-bold has-text-grey-darker">
                <% 
                   c_name = n.is_a?(Hash) ? n['course_name'] : (n.respond_to?(:course_name) ? n.course_name : nil)
                   c_id = n.is_a?(Hash) ? n['course_id'] : (n.respond_to?(:course_id) ? n.course_id : nil)
                %>
                <% info = extract_course_info(c_name || "", c_id) %>
                <% if info[:prefix] %><span class="px-1 mr-2" style="border-radius: 3px; font-size: 0.65rem; font-weight: bold; <%= info[:pill_style] %>"><%= info[:prefix] %></span><% end %>
                <% if c_name.present? %>
                  <%= info[:short_name] || c_name %>
                <% else %>
                   <%= c_id ? "Course #{c_id}" : "General" %>
                <% end %>
              </span>
              <% if n.semester %><span class="tag is-white is-small has-text-grey ml-1" style="font-size: 0.65rem;"><%= n.semester %></span><% end %>
            </div>
            <h3 class="title is-6 mb-1" onclick="window.location='/notifications/<%= n.id %>/view'"><%= render_markdown_inline(clean_notification_title(n.title, n.course_name)) %></h3>
            <div class="content is-size-7 has-text-grey-dark mb-0" onclick="event.stopPropagation()">
              <%= n.body ? render_markdown_inline(truncate_text(n.body, 150)) : "No description" %>
            </div>
          </div>
          <div class="column is-narrow has-text-right">
            <p class="is-size-7 has-text-grey mb-1">
              <%= format_date(n.date, "%b %d, %Y %H:%M") rescue "Recently" %>
            </p>
            <% if n.is_personal %>
              <span class="icon is-small has-text-danger" title="Directly for you">
                <i class="fas fa-user-circle"></i>
              </span>
            <% end %>
            <div>
              <button type="button" 
                      class="button is-ghost p-0 is-small hov-success mark-read-btn <%= 'is-hidden' if n.is_read %>" 
                      onclick="updateNotificationReadStatus(event, <%= n.id %>, true)" 
                      title="Mark as Read">
                <span class="icon is-small"><i class="far fa-circle"></i></span>
              </button>
              <button type="button" 
                      class="button is-ghost p-0 is-small hov-unread mark-unread-btn <%= 'is-hidden' unless n.is_read %>" 
                      onclick="updateNotificationReadStatus(event, <%= n.id %>, false)" 
                      title="Mark as Unread">
                <span class="icon is-small has-text-link"><i class="fas fa-check-circle"></i></span>
              </button>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @total_pages > 1 %>
    <nav class="pagination is-centered mt-6" role="navigation" aria-label="pagination">
      <% if @page > 1 %>
        <a href="<%= page_url(@page - 1) %>" class="pagination-previous">Previous</a>
      <% else %>
        <a class="pagination-previous" disabled>Previous</a>
      <% end %>

      <% if @page < @total_pages %>
        <a href="<%= page_url(@page + 1) %>" class="pagination-next">Next page</a>
      <% else %>
        <a class="pagination-next" disabled>Next page</a>
      <% end %>

      <ul class="pagination-list">
        <% (1..@total_pages).each do |p| %>
          <% if p == 1 || p == @total_pages || (p >= @page - 2 && p <= @page + 2) %>
            <li>
              <a href="<%= page_url(p) %>" class="pagination-link <%= 'is-current' if p == @page %>" aria-label="Goto page <%= p %>">
                <%= p %>
              </a>
            </li>
          <% elsif p == @page - 3 || p == @page + 3 %>
            <li><span class="pagination-ellipsis">&hellip;</span></li>
          <% end %>
        <% end %>
      </ul>
    </nav>
  <% end %>
<% end %>

<script>
function updateNotificationReadStatus(event, id, isRead) {
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }

  const url = isRead ? `/notifications/${id}/mark_read` : `/notifications/${id}/mark_unread`;
  
  fetch(url, {
    method: 'POST',
    headers: { 'X-Requested-With': 'XMLHttpRequest' }
  })
  .then(res => res.json())
  .then(data => {
    if (data.status === 'ok') {
      const card = document.getElementById(`notification-${id}`);
      const readBtn = card.querySelector('.mark-read-btn');
      const unreadBtn = card.querySelector('.mark-unread-btn');
      
      if (isRead) {
        card.classList.add('is-read');
        readBtn.classList.add('is-hidden');
        unreadBtn.classList.remove('is-hidden');
      } else {
        card.classList.remove('is-read');
        readBtn.classList.remove('is-hidden');
        unreadBtn.classList.add('is-hidden');
      }

      // If we are filtering by unread and just marked it as read, fade it out
      const urlParams = new URLSearchParams(window.location.search);
      const isReadingAll = urlParams.get('show_read') === 'true';
      
      if (isRead && !isReadingAll) {
        card.style.transition = 'opacity 0.6s, height 0.6s, margin 0.6s, padding 0.6s';
        card.style.opacity = '0';
        card.style.pointerEvents = 'none';
        setTimeout(() => { card.style.display = 'none'; }, 600);
      }
    }
  })
  .catch(err => console.error("Error updating notification status:", err));
}
</script>

<style>
.notification-card {
  transition: transform 0.1s, box-shadow 0.1s;
}
.notification-card:hover {
  transform: translateX(3px);
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}
.notification-card.is-read {
  opacity: 0.6;
  background-color: #fafafa;
}
.hov-success:hover {
  color: #48c774 !important;
}
.hov-unread:hover {
  color: #3273dc !important;
}
</style>
