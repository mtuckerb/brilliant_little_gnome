<% if @notifications.empty? %>
  <div class="box has-text-centered py-6">
    <span class="icon is-large has-text-grey-light mb-4">
      <i class="fas fa-bell-slash fa-2x"></i>
    </span>
    <p class="has-text-grey">No notifications found with these filters.</p>
  </div>
<% else %>
  <div class="notification-list">
    <% @notifications.each do |n| %>
      <div class="box mb-3 notification-card p-4 <%= 'is-read' if n.is_read %>" style="cursor: pointer; border-left: 5px solid <%= n.urgency == 3 ? '#ff3860' : (n.urgency == 2 ? '#ffdd57' : '#3273dc') %>;">
        <div class="columns is-mobile is-vcentered is-gapless mb-0">
          <div class="column">
            <div class="is-flex is-align-items-center mb-1">
              <span class="tag is-small is-rounded mr-2 <%= n.notification_type == 'Grade' ? 'is-success' : (n.notification_type == 'Discussion' ? 'is-warning' : 'is-link') %> is-light">
                <%= n.notification_type %>
              </span>
              <span class="has-text-grey-light is-size-7 mr-2">#<%= n.id %></span>
              <span class="is-size-7 has-text-weight-bold has-text-grey-darker">
                <%= n.course_name || (n.course_id ? "Course #{n.course_id}" : "General") %>
              </span>
              <% if n.semester %>
                <span class="is-size-7 has-text-grey ml-2">(<%= n.semester %>)</span>
              <% end %>
            </div>
            <h3 class="title is-6 mb-1" onclick="window.location='<%= n.url %>'"><%= n.title %></h3>
            <div class="content is-size-7 has-text-grey-dark mb-0" onclick="window.location='<%= n.url %>'">
              <%= n.body ? truncate_text(n.body, 150) : "No description" %>
            </div>
          </div>
          <div class="column is-narrow has-text-right">
            <p class="is-size-7 has-text-grey mb-1">
              <%= format_date(n.date, "%b %d, %Y %H:%M") rescue "Recently" %>
            </p>
            <% if n.is_personal %>
              <span class="icon is-small has-text-danger" title="Directly for you">
                <i class="fas fa-user-circle"></i>
              </span>
            <% end %>
            <div>
              <% if !n.is_read %>
                <form action="/notifications/<%= n.id %>/mark_read" method="post" style="display:inline;">
                  <button type="submit" class="button is-ghost p-0 is-small hov-success" title="Mark as Read">
                    <span class="icon is-small">
                      <i class="far fa-circle"></i>
                    </span>
                  </button>
                </form>
              <% else %>
                <form action="/notifications/<%= n.id %>/mark_unread" method="post" style="display:inline;">
                  <button type="submit" class="button is-ghost p-0 is-small hov-unread" title="Mark as Unread">
                    <span class="icon is-small has-text-link">
                      <i class="fas fa-check-circle"></i>
                    </span>
                  </button>
                </form>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @total_pages > 1 %>
    <nav class="pagination is-centered mt-6" role="navigation" aria-label="pagination">
      <% if @page > 1 %>
        <a href="<%= page_url(@page - 1) %>" class="pagination-previous">Previous</a>
      <% else %>
        <a class="pagination-previous" disabled>Previous</a>
      <% end %>

      <% if @page < @total_pages %>
        <a href="<%= page_url(@page + 1) %>" class="pagination-next">Next page</a>
      <% else %>
        <a class="pagination-next" disabled>Next page</a>
      <% end %>

      <ul class="pagination-list">
        <% (1..@total_pages).each do |p| %>
          <% if p == 1 || p == @total_pages || (p >= @page - 2 && p <= @page + 2) %>
            <li>
              <a href="<%= page_url(p) %>" class="pagination-link <%= 'is-current' if p == @page %>" aria-label="Goto page <%= p %>">
                <%= p %>
              </a>
            </li>
          <% elsif p == @page - 3 || p == @page + 3 %>
            <li><span class="pagination-ellipsis">&hellip;</span></li>
          <% end %>
        <% end %>
      </ul>
    </nav>
  <% end %>
<% end %>

<style>
.notification-card {
  transition: transform 0.1s, box-shadow 0.1s;
}
.notification-card:hover {
  transform: translateX(3px);
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}
.notification-card.is-read {
  opacity: 0.6;
  background-color: #fafafa;
}
.hov-success:hover {
  color: #48c774 !important;
}
.hov-unread:hover {
  color: #3273dc !important;
}
</style>
