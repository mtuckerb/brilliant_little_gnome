<li style="list-style-type: none;">
  <% 
     is_active = (@active_tab == "module_#{mod['ModuleId']}")
  %>
  <div class="is-flex is-align-items-center mb-1">
    <a href="/course/<%= @course_id %>/module/<%= mod['ModuleId'] %>" 
       class="<%= 'is-active slide-active' if is_active %>" 
       style="flex-grow: 1; padding: 2px 5px !important; font-size: 0.85rem; <%= is_active ? 'font-weight: bold;' : '' %>">
      <% if is_active %>
        <script>
          // Scroll active element into view on load if it's not visible
          window.addEventListener('load', () => { document.querySelector('.slide-active')?.scrollIntoView({ behavior: 'auto', block: 'nearest' }); });
        </script>
      <% end %>
      <%= mod['Title'] %>
    </a>
  </div>

  <% if mod['Modules'] && !mod['Modules'].empty? %>
    <ul class="toc-nested" style="display: block; list-style-type: none; margin-top: 0; padding-left: 1rem;">
      <% mod['Modules'].each do |sub| %>
        <%= erb :'partials/toc_recursive', locals: { mod: sub, depth: depth + 1 } %>
      <% end %>
    </ul>
  <% end %>
</li>
