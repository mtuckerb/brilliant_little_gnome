<section class="section">
  <div class="container">
    <div class="columns is-centered">
      <div class="column is-two-thirds">
        <div class="box">
          <h1 class="title"><i class="fas fa-cog mr-2"></i> Settings</h1>
          <hr>

          <% if @error %>
            <div class="notification is-danger">
              <%= @error %>
            </div>
          <% end %>

          <form action="/settings" method="POST">
            <h3 class="title is-4">Profile</h3>
            <div class="field">
              <label class="label">Display Name</label>
              <div class="control has-icons-left">
                <input class="input" type="text" name="display_name" value="<%= @user_prefs.display_name %>" required>
                <span class="icon is-small is-left">
                  <i class="fas fa-user"></i>
                </span>
              </div>
            </div>

            <div class="field">
              <label class="label">Time Zone</label>
              <div class="control">
                <div class="select is-fullwidth">
                  <select name="time_zone">
                    <option value="UTC" <%= 'selected' if @user_prefs.time_zone == 'UTC' %>>UTC</option>
                    <option value="Eastern Time (US & Canada)" <%= 'selected' if @user_prefs.time_zone == 'Eastern Time (US & Canada)' %>>Eastern Time</option>
                    <option value="Central Time (US & Canada)" <%= 'selected' if @user_prefs.time_zone == 'Central Time (US & Canada)' %>>Central Time</option>
                    <option value="Mountain Time (US & Canada)" <%= 'selected' if @user_prefs.time_zone == 'Mountain Time (US & Canada)' %>>Mountain Time</option>
                    <option value="Pacific Time (US & Canada)" <%= 'selected' if @user_prefs.time_zone == 'Pacific Time (US & Canada)' %>>Pacific Time</option>
                  </select>
                </div>
              </div>
            </div>

            <hr>
            <h3 class="title is-4">External REST API</h3>
            <div class="field">
              <label class="checkbox">
                <input type="checkbox" name="api_enabled" value="true" <%= 'checked' if @user_prefs.api_enabled %>>
                Enable REST API
              </label>
            </div>

            <div class="field">
              <label class="checkbox">
                <input type="checkbox" name="api_listen_all" value="true" <%= 'checked' if @user_prefs.api_listen_all %>>
                Listen on all interfaces (0.0.0.0) - <i>Required for external access</i>
              </label>
            </div>

            <div class="field">
              <label class="label">API Key (Optional Authentication)</label>
              <div class="control has-icons-left">
                <input class="input" type="text" name="api_key" value="<%= @user_prefs.api_key %>" placeholder="Enter a secure key or leave blank">
                <span class="icon is-small is-left">
                  <i class="fas fa-key"></i>
                </span>
              </div>
              <p class="help">If set, clients must provide this in the 'X-API-Key' or 'Authorization' header.</p>
            </div>

            <hr>
            <h3 class="title is-4">GPA Calculation (USM Scale)</h3>
            <div class="columns">
              <div class="column">
                <div class="field">
                  <label class="label">Historic GPA (Transfer/Previous)</label>
                  <div class="control has-icons-left">
                    <input class="input" type="number" step="0.001" name="historic_gpa" value="<%= @user_prefs.historic_gpa %>">
                    <span class="icon is-small is-left"><i class="fas fa-graduation-cap"></i></span>
                  </div>
                </div>
              </div>
              <div class="column">
                <div class="field">
                  <label class="label">Historic Units (Credits)</label>
                  <div class="control has-icons-left">
                    <input class="input" type="number" name="historic_units" value="<%= @user_prefs.historic_units %>">
                    <span class="icon is-small is-left"><i class="fas fa-calculator"></i></span>
                  </div>
                </div>
              </div>
            </div>

            <hr>
            <h3 class="title is-4">Brightspace Connection</h3>
            <div class="field">
              <label class="label">Brightspace Host</label>
              <div class="control has-icons-left">
                <input class="input" type="text" name="host" value="<%= @host %>">
                <span class="icon is-small is-left">
                  <i class="fas fa-globe"></i>
                </span>
              </div>
            </div>

            <div class="field">
              <label class="label">Update Cookies (Leave blank to keep current)</label>
              <div class="control">
                <textarea class="textarea" name="cookies" placeholder="Paste new cookie string here..." rows="3"></textarea>
              </div>
            </div>

            <div class="notification is-info is-light mt-4">
              <div class="level">
                <div class="level-left">
                  <div>
                    <p><strong>Magic Re-authentication</strong></p>
                    <p class="is-size-7">Launch a browser window to automatically refresh your session.</p>
                  </div>
                </div>
                <div class="level-right">
                  <button type="button" onclick="startAppLogin()" class="button is-info">
                    <span class="icon"><i class="fas fa-magic"></i></span>
                    <span><strong>Launch</strong></span>
                  </button>
                </div>
              </div>
            </div>

            <div class="message is-info is-light">
              <div class="message-body is-size-7">
                <div class="columns is-vcentered">
                  <div class="column is-narrow">
                    <span class="icon is-large has-text-info"><i class="fas fa-info-circle fa-2x"></i></span>
                  </div>
                  <div class="column">
                    <strong>Intelligent Syncing enabled:</strong> Course metadata updates will prioritize existing robust data. Historical data (like archived content or grades) is protected even if omitted from current Brightspace responses.
                  </div>
                </div>
              </div>
            </div>

            <div class="field mt-5">
              <div class="control">
                <button type="submit" class="button is-primary">
                  <strong>Save Changes</strong>
                </button>
              </div>
            </div>
          </form>

          <hr>
          <h3 class="title is-4">Maintenance Tasks</h3>
          <div class="field is-grouped is-grouped-multiline">
            <div class="control">
              <form action="/notifications/refresh_cache" method="POST">
                <button type="submit" class="button is-danger is-light" onclick="return confirm('This will clear the API cache and rebuild the notification database. Continue?')">
                  <span class="icon"><i class="fas fa-trash-alt"></i></span>
                  <span>Reset & Sync Notifications</span>
                </button>
              </form>
            </div>
            <div class="control">
              <form action="/sync/force" method="POST">
                <button type="submit" class="button is-info is-light">
                  <span class="icon"><i class="fas fa-sync-alt"></i></span>
                  <span>Re-Sync All Courses (Metadata)</span>
                </button>
              </form>
            </div>
          </div>

          <div class="message is-info is-light mt-4">
            <div class="message-body is-size-7">
              <div class="columns is-vcentered">
                <div class="column is-narrow">
                  <span class="icon is-large has-text-info"><i class="fas fa-tools fa-2x"></i></span>
                </div>
                <div class="column">
                   Use these tools to force a full re-sync if data appears stale or inconsistent between local view and Brightspace.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function startAppLogin() {
    const hostInput = document.querySelector('input[name="host"]');
    const host = (hostInput && hostInput.value) ? hostInput.value : "<%= @host %>";
    
    if (window.electron) {
      window.electron.startLogin(host);
    } else {
      // Fallback for non-electron debug
      window.location.href = `/auth/login?host=${host}`;
    }
  }

  if (window.electron) {
    window.electron.onLoginComplete((data) => {
      // Fill the manual form and submit it automatically
      const hostInput = document.querySelector('input[name="host"]');
      const cookieInput = document.querySelector('textarea[name="cookies"]');
      
      if (hostInput && cookieInput) {
        hostInput.value = data.host;
        cookieInput.value = data.cookies;
        // Auto submit the form
        document.querySelector('form[action="/settings"]').submit();
      }
    });
  }
</script>
