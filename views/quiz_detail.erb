<div class="container animate__animated animate__fadeIn">
  <div class="columns">
    <div class="column is-9">
      <div class="box">
        <div class="level">
          <div class="level-left">
            <div>
              <h1 class="title is-4"><i class="fas fa-tasks mr-2 text-primary"></i> <%= @quiz['Name'] %></h1>
              <p class="subtitle is-6 has-text-grey">Quiz Details</p>
            </div>
          </div>
          <div class="level-right">
            <a href="<%= $client.portal_url_for(:quiz, id: @quiz_id, course_id: @course_id) %>" class="button is-small is-link is-light" target="_blank">
              <span class="icon"><i class="fas fa-external-link-alt"></i></span>
              <span>Open in Brightspace</span>
            </a>
          </div>
        </div>

        <hr>

        <div class="columns mb-4">
          <div class="column">
            <div class="notification is-light">
              <p class="heading">Due Date</p>
              <p class="title is-5">
                <% if @quiz['DueDate'] %>
                  <i class="far fa-clock mr-1"></i> <%= format_date(@quiz['DueDate']) %>
                <% else %>
                  <span class="has-text-grey">No due date</span>
                <% end %>
              </p>
            </div>
          </div>
          <div class="column">
            <div class="notification is-light">
              <p class="heading">Attempts</p>
              <p class="title is-5">
                <% attLimit = @quiz['AttemptsAllowed'] || 1 %>
                <i class="fas fa-redo mr-1"></i> <%= attLimit == 0 ? "Unlimited" : attLimit %>
              </p>
            </div>
          </div>
        </div>

        <div class="content">
          <h4 class="title is-5">Description</h4>
          <% if @quiz['Description'] && @quiz['Description']['Text'] && !@quiz['Description']['Text'].empty? %>
            <%= @quiz['Description']['Text'] %>
          <% elsif @quiz['Header'] && @quiz['Header']['Text'] && !@quiz['Header']['Text'].empty? %>
             <%= @quiz['Header']['Text'] %>
          <% else %>
            <p class="has-text-grey italic">No description provided for this quiz.</p>
          <% end %>
        </div>
        
        <% if @quiz['Instructions'] && @quiz['Instructions']['Text'] && !@quiz['Instructions']['Text'].empty? %>
          <div class="content mt-5">
            <h4 class="title is-5">Instructions</h4>
            <%= @quiz['Instructions']['Text'] %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="column is-3">
       <div class="box p-3">
          <p class="heading has-text-weight-bold mb-2">Quiz Status</p>
          <div class="tags">
             <% if @quiz['IsActive'] %>
               <span class="tag is-success is-light">Active</span>
             <% else %>
               <span class="tag is-danger is-light">Inactive</span>
             <% end %>
             
             <% if @quiz['IsAutoSubmit'] %>
               <span class="tag is-info is-light">Auto-Submit</span>
             <% end %>
          </div>
          
          <% if @quiz['TimeLimit'] %>
             <p class="is-size-7 mt-3"><strong>Time Limit:</strong> <%= @quiz['TimeLimit'] %> minutes</p>
          <% end %>
       </div>
    </div>
  </div>
</div>
