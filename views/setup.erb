<section class="section">
  <div class="container">
    <div class="columns is-centered">
      <div class="column is-half">
        <div class="box">
          <h1 class="title has-text-centered">Setup Brilliant</h1>
          <p class="subtitle has-text-centered">Connect to your Brightspace instance</p>
          
          <div class="notification is-info is-light">
            <h4 class="title is-5">Option 1: Bright Space Login (Recommended)</h4>
            <p>Click the button below to open a login window. Once you sign in and see your Brightspace home page, Brilliant will automatically capture your session.</p>
            
            <input type="hidden" id="login-host-source" value="<%= @host || 'courses.maine.edu' %>">
            <div class="field mt-4">
              <button type="button" onclick="startAppLogin()" class="button is-info is-fullwidth">
                <span class="icon"><i class="fas fa-magic"></i></span>
                <span><strong>Bright Space Login</strong></span>
              </button>
            </div>
          </div>

          <div class="is-divider" data-content="OR"></div>

          <div class="notification is-success is-light">
            <h4 class="title is-5">Option 2: Browser Extension (Remote Users)</h4>
            <p>If you're connecting to Brilliant from another computer, use a browser extension to send your Brightspace session cookies.</p>

            <h6 class="mt-4 mb-2"><strong>Firefox</strong> (Recommended)</h6>
            <ol style="margin-left: 1.2em; font-size: 0.9em;">
              <li>Download the <a href="/firefox-extension" target="_blank"><strong>firefox-extension folder</strong></a></li>
              <li>Open <code>about:debugging#/runtime/this-firefox</code></li>
              <li>Click <strong>Load Temporary Add-on</strong> and select any file in the folder</li>
              <li>Log into <a href="https://courses.maine.edu" target="_blank">Brightspace</a>, then click the extension icon</li>
            </ol>

            <h6 class="mt-4 mb-2"><strong>Chrome</strong></h6>
            <ol style="margin-left: 1.2em; font-size: 0.9em;">
              <li>Download the <a href="/extension" target="_blank"><strong>extension folder</strong></a></li>
              <li>Open <code>chrome://extensions</code> and enable <strong>Developer Mode</strong></li>
              <li>Click <strong>Load Unpacked</strong> and select the folder</li>
              <li>Log into <a href="https://courses.maine.edu" target="_blank">Brightspace</a>, then click the extension icon</li>
            </ol>
            <p class="mt-2" style="font-size: 0.85em;"><em>Note: Chrome may block connections to local IPs. Use Firefox if you see connection errors.</em></p>
          </div>

          <div class="is-divider" data-content="OR"></div>

          <h4 class="title is-5">Option 3: Manual Setup</h4>
          <% if @error %>
            <div class="notification is-danger">
              <%= @error %>
            </div>
          <% end %>

          <form action="/setup" method="POST">
            <div class="field">
              <label class="label">Brightspace Host</label>
              <div class="control has-icons-left">
                <input class="input" type="text" name="host" placeholder="e.g. courses.maine.edu" required value="<%= @host %>">
                <span class="icon is-small is-left">
                  <i class="fas fa-globe"></i>
                </span>
              </div>
              <p class="help">The domain where you access Brightspace.</p>
            </div>

            <div class="field">
              <label class="label">Authentication Cookie</label>
              <div class="control">
                <textarea class="textarea" name="cookies" placeholder="Paste your raw cookie string here..." rows="5" required></textarea>
              </div>
              <p class="help">Open DevTools (F12) in your browser, go to any Brightspace page, copy the <code>Cookie</code> header from any request in the Network tab.</p>
            </div>

            <div class="field mt-5">
              <div class="control">
                <button type="submit" class="button is-primary is-fullwidth">
                  <strong>Save & Connect</strong>
                </button>
              </div>
            </div>
          </form>

          <hr>
          <div class="content is-size-7 has-text-grey">
            <p><strong>Security Tip:</strong> Your cookies are stored locally and are used to authenticate requests to the LMS on your behalf. Keep them private.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function startAppLogin() {
    const hostInput = document.querySelector('input[name="host"]');
    let host = (hostInput && hostInput.value) ? hostInput.value.trim() : document.getElementById('login-host-source').value;
    
    // Safety check: Don't allow localhost/127.0.0.1 as the Brightspace host
    if (host === '127.0.0.1' || host === 'localhost' || host.startsWith('127.0.0.1:')) {
      alert("Error: '" + host + "' appears to be your local machine, not a Brightspace host. Please enter the domain where you access your courses (e.g., courses.maine.edu).");
      if (hostInput) hostInput.focus();
      return;
    }
    
    if (window.electron) {
      window.electron.startLogin(host);
    } else {
      // Use the new Magic Login route for web browsers
      window.location.href = `/auth/magic?host=${encodeURIComponent(host)}`;
    }
  }

  if (window.electron) {
    window.electron.onLoginComplete((data) => {
      // Fill the manual form and submit it automatically
      const hostInput = document.querySelector('input[name="host"]');
      const cookieInput = document.querySelector('textarea[name="cookies"]');
      
      if (hostInput && cookieInput) {
        hostInput.value = data.host;
        cookieInput.value = data.cookies;
        // Auto submit the form
        document.querySelector('form[action="/setup"]').submit();
      }
    });
  }
</script>
