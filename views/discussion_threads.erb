<%= erb :'partials/course_detail_header' %>
<div class="columns">
  <div class="column is-3">
    <%= erb :'partials/sidebar' %>
  </div>
  <div class="column is-9">
    <div class="box">
      <div class="topic-header mb-6">
        <div class="level mb-2">
          <div class="level-left">
            <h4 class="title is-4"><i class="fas fa-comments mr-2"></i> <%= @topic['Name'] %></h4>
          </div>
          <div class="level-right">
            <form action="" method="get" class="mr-2">
              <input type="hidden" name="force_refresh" value="true">
              <button type="submit" class="button is-small is-white has-text-grey"><i class="fas fa-sync mr-1"></i> Refresh</button>
            </form>
            <a href="<%= $client.portal_url_for(:discussion_topic, {course_id: @course_id, id: @topic_id}) %>" class="button is-small is-link is-light" target="_blank">
              <span class="icon is-small"><i class="fas fa-external-link-alt"></i></span>
              <span>View in Brightspace</span>
            </a>
          </div>
        </div>

        <div class="tags">
          <% if @topic['EndDate'] %>
            <span class="tag is-danger is-light">
              <i class="fas fa-calendar-times mr-1"></i> Due: <%= format_date(@topic["EndDate"]) %>
            </span>
          <% end %>
          <% if @topic['StartDate'] %>
            <span class="tag is-info is-light">
              <i class="fas fa-calendar-check mr-1"></i> Available: <%= format_date(@topic["StartDate"], "%b %d, %Y") %>
            </span>
          <% end %>
          <span class="tag is-white">
            <i class="fas fa-reply-all mr-1"></i> <%= @topic['PostCount'] %> Posts
          </span>
        </div>

        <div class="content box is-light is-size-6 py-4 px-5">
           <p class="has-text-weight-bold mb-2">Instructions / Description:</p>
           <% 
              desc = @topic['Description']
              desc_html = desc.is_a?(Hash) ? (desc['Html'] || desc['Text']) : desc.to_s
           %>
           <%= desc_html && !desc_html.strip.empty? ? desc_html : "<p class='has-text-grey italic'>No description provided.</p>" %>
        </div>

        <%# Instructor Feedback / Evaluation Section %>
        <% if @evaluation %>
          <div class="notification is-success is-light">
            <p class="has-text-weight-bold"><i class="fas fa-comment-dots mr-2"></i> Instructor Feedback:</p>
            <% if @evaluation['Feedback'] %>
              <div class="content mt-2">
                <%= @evaluation['Feedback']['Html'] || @evaluation['Feedback']['Text'] %>
              </div>
            <% end %>
            <% if @evaluation['Score'] %>
              <div class="mt-2">
                <span class="tag is-success">Score: <%= @evaluation['Score'] %></span>
              </div>
            <% end %>
          </div>
        <% elsif @topic['Feedback'] %>
          <div class="notification is-success is-light">
            <p class="has-text-weight-bold"><i class="fas fa-comment-dots mr-2"></i> Instructor Feedback:</p>
            <div class="content mt-2">
              <%= @topic['Feedback']['Html'] || @topic['Feedback']['Text'] %>
            </div>
          </div>
        <% end %>
      </div>

      <style>
        .thread-container { border-top: 2px solid #f5f5f5; padding-top: 2rem; margin-top: 3rem; }
        .post-replies { margin-left: 1.5rem; border-left: 2px solid #f0f4f8; padding-left: 1rem; position: relative; }
        .post-card { border: 1px solid #eee; border-radius: 6px; margin-bottom: 1rem; transition: all 0.2s; background: white; }
        .post-card:hover { border-color: #739AC3; }
        .post-header { background: #fafafa; padding: 0.5rem 1rem; border-bottom: 1px solid #eee; border-radius: 6px 6px 0 0; }
        .post-body { padding: 1rem; font-size: 0.95rem; line-height: 1.6; }
        .is-instructor { border-left: 4px solid #739AC3 !important; background: #f9fbfd; }
        .instructor-tag { background: #739AC3; color: white; padding: 1px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: bold; }
        .post-date { color: #888; font-size: 0.75rem; }
      </style>

      <h5 class="title is-5 mb-4">Threads</h5>
      
      <% if @threads_with_posts && @threads_with_posts.any? %>
        <% @threads_with_posts.each_with_index do |item, index| %>
          <% thread = item[:thread] %>
          <div class="thread-container" id="thread-<%= thread['ThreadId'] %>">
            <div class="is-clickable py-3" onclick="toggleThread('<%= thread['ThreadId'] %>')" style="cursor: pointer; border-bottom: 1px solid #f5f5f5;">
              <div class="is-flex is-align-items-start">
                <span id="icon-<%= thread['ThreadId'] %>" class="mt-1"><i class="fas fa-chevron-right mr-3 has-text-grey-light"></i></span>
                <div style="flex: 1;">
                  <h5 class="title is-5 mb-1">
                    <%= thread['IsPinned'] ? '<i class="fas fa-thumbtack mr-2 has-text-primary"></i>' : '' %>
                    <%= thread['Subject'] || thread['Title'] %>
                  </h5>
                  <div class="is-size-7 has-text-grey">
                    <span class="has-text-weight-semibold author-name"><i class="fas fa-user-circle mr-1"></i> <%= author_name(thread) %></span>
                    <% if thread['LastModified'] %>
                      <span class="mx-2">&bull;</span>
                      <i class="fas fa-clock mr-1"></i> <span><%= format_date(thread["LastModified"]) %></span>
                    <% end %>
                    <% if thread['ReplyCount'] %>
                      <span class="mx-2">&bull;</span>
                      <span class="tag is-white py-0 px-0"><i class="fas fa-comments mr-1"></i> <%= thread['ReplyCount'] %> replies</span>
                    <% end %>
                    
                    <a href="<%= $client.portal_url_for(:discussion_thread, {course_id: @course_id, id: thread['ThreadId']}) %>" 
                       class="button is-ghost is-small py-0 px-2 has-text-grey" 
                       target="_blank" 
                       onclick="event.stopPropagation();" 
                       style="height: auto; vertical-align: baseline;">
                       <i class="fas fa-external-link-alt is-size-7"></i>
                    </a>
                  </div>
                </div>
              </div>
            </div>
            
            <div id="content-<%= thread['ThreadId'] %>" class="discussion-timeline is-hidden ml-5 mt-4">
              <% item[:post_tree].each do |post| %>
                <%= erb :'partials/discussion_post', locals: { post: post, depth: 1 } %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="has-text-grey">No threads found in this topic.</p>
      <% end %>

      <script>
        function toggleThread(id) {
          const content = document.getElementById('content-' + id);
          const icon = document.getElementById('icon-' + id);
          if (content.classList.contains('is-hidden')) {
            content.classList.remove('is-hidden');
            icon.innerHTML = '<i class="fas fa-chevron-down mr-2 has-text-grey"></i>';
          } else {
            content.classList.add('is-hidden');
            icon.innerHTML = '<i class="fas fa-chevron-right mr-2 has-text-grey-light"></i>';
          }
        }
      </script>

      <div class="notification is-info is-light mt-6">
        <i class="fas fa-info-circle mr-2"></i> All discussions for this topic are listed above. To post, use the portal.
      </div>
    </div>
  </div>
</div>
