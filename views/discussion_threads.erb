<%= erb :'partials/course_detail_header' %>
<div class="columns">
  <div class="column is-3">
    <%= erb :'partials/sidebar' %>
  </div>
  <div class="column is-9" id="topic-root">
    <div class="is-flex is-justify-content-center is-align-items-center" style="min-height: 400px;">
      <div class="has-text-centered">
        <span class="icon is-large has-text-primary mb-4">
          <i class="fas fa-circle-notch fa-spin fa-3x"></i>
        </span>
        <p class="is-size-5 has-text-grey">Loading Topic Details...</p>
      </div>
    </div>
  </div>
</div>

<script>
  const COURSE_ID = "<%= @course_id %>";
  const FORUM_ID = "<%= @forum_id %>";
  const TOPIC_ID = "<%= @topic_id %>";
  let threadData = [];
  let currentSearchQuery = "";

  async function loadTopic(forceRefresh = false) {
    const root = document.getElementById('topic-root');
    try {
      let url = `/api/v1/courses/${COURSE_ID}/discussions/${FORUM_ID}/topics/${TOPIC_ID}`;
      if (forceRefresh) url += '?force_refresh=true';
      
      const response = await fetch(url);
      if (!response.ok) throw new Error("Failed to fetch topic");
      const data = await response.json();
      threadData = data.threads_with_posts || [];
      renderTopic(data);
      
      // Load and apply persistent sort
      const savedSort = localStorage.getItem('discussion_sort_pref') || 'activity';
      const select = document.getElementById('threadSortSelect');
      if (select) select.value = savedSort;
      
      applySort();
    } catch (err) {
      console.error(err);
      root.innerHTML = `
        <div class="notification is-danger">
          <h3 class="title is-5">Error Connection Lost</h3>
          <p>Failed to load topic details. Please ensure the backend is running.</p>
          <button class="button is-white is-small mt-2" onclick="location.reload()">Retry</button>
        </div>
      `;
    }
  }

  function applySort() {
    const sortBy = document.getElementById('threadSortSelect').value;
    localStorage.setItem('discussion_sort_pref', sortBy);
    
    const container = document.getElementById('threads-list');
    if (!container) return;

    const sorted = [...threadData].sort((a, b) => {
      const tA = a.thread;
      const tB = b.thread;

      // Pins always come first if not strictly sorting by something else
      if (sortBy !== 'created' && sortBy !== 'author') {
        if (tA.IsPinned && !tB.IsPinned) return -1;
        if (!tA.IsPinned && tB.IsPinned) return 1;
      }

      if (sortBy === 'mine') {
        // 1. User is Author
        if (tA.UserIsAuthor && !tB.UserIsAuthor) return -1;
        if (!tA.UserIsAuthor && tB.UserIsAuthor) return 1;
        // 2. User participated (replied to)
        if (tA.UserParticipated && !tB.UserParticipated) return -1;
        if (!tA.UserParticipated && tB.UserParticipated) return 1;
        
        // Secondary: Most recent activity (so newest "mine" threads are at top)
        return new Date(tB.LastReplyDate || 0) - new Date(tA.LastReplyDate || 0);
      } else if (sortBy === 'created') {
        return new Date(tB.ThreadDate || 0) - new Date(tA.ThreadDate || 0);
      } else if (sortBy === 'author') {
        return (tA.PostingUserDisplayName || '').localeCompare(tB.PostingUserDisplayName || '');
      } else {
        // 'activity' - Last Reply
        return new Date(tB.LastReplyDate || 0) - new Date(tA.LastReplyDate || 0);
      }
    });

    container.innerHTML = renderThreads(sorted);
  }

  function handleSearch(query) {
    currentSearchQuery = query.toLowerCase().trim();
    applySort(); // Re-render with current sort + search
  }

  function renderTopic(data) {
    const root = document.getElementById('topic-root');
    const { forum, topic, evaluation, threads_with_posts, instructions_collapsed, feedback_collapsed, participated } = data;

    let html = `
      <div class="box">
        <div class="topic-header mb-6">
          <div class="level mb-2">
            <div class="level-left">
              <h4 class="title is-4"><i class="fas fa-comments mr-2"></i> ${topic.name}</h4>
            </div>
            <div class="level-right">
              <button class="button is-small is-white has-text-grey mr-2" onclick="loadTopic(true)">
                <i class="fas fa-sync mr-1"></i> Refresh
              </button>
              <a href="https://${window.location.host}/d2l/le/1.40/${COURSE_ID}/discussions/topics/${TOPIC_ID}/View" class="button is-small is-link is-light" target="_blank">
                <span class="icon is-small"><i class="fas fa-external-link-alt"></i></span>
                <span>View in Brightspace</span>
              </a>
            </div>
          </div>

          <div class="tags">
            ${topic.end_date ? `
              <span class="tag is-danger is-light">
                <i class="fas fa-calendar-times mr-1"></i> Due: ${new Date(topic.end_date).toLocaleString()}
              </span>
            ` : ''}
            ${topic.start_date ? `
              <span class="tag is-info is-light">
                <i class="fas fa-calendar-check mr-1"></i> Available: ${new Date(topic.start_date).toLocaleDateString()}
              </span>
            ` : ''}
            <span class="tag is-white">
              <i class="fas fa-reply-all mr-1"></i> ${topic.display_post_count || 0} Posts
            </span>
          </div>

          <div class="content box is-light is-size-6 py-4 px-5 pos-relative">
             <div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
               <p class="has-text-weight-bold mb-0">Instructions / Description:</p>
               <button class="button is-small is-ghost collapsible-trigger ${instructions_collapsed ? '' : 'is-active'}" onclick="toggleSection('instructions')">
                 <span class="icon is-small">
                   <i id="instructions-chevron" class="fas fa-chevron-right"></i>
                 </span>
               </button>
             </div>
             
             <div id="instructions-content" class="${instructions_collapsed ? 'is-hidden' : ''}">
                ${topic.description || "<p class='has-text-grey italic'>No description provided.</p>"}
             </div>
          </div>

          ${renderEvaluation(evaluation, feedback_collapsed)}
        </div>

        <div class="level mb-4">
          <div class="level-left">
            <h5 class="title is-5 mb-0">Threads</h5>
          </div>
          <div class="level-right">
            <div class="field mr-4">
              <p class="control has-icons-left">
                <input class="input is-small" type="text" placeholder="Search posts..." oninput="handleSearch(this.value)">
                <span class="icon is-small is-left">
                  <i class="fas fa-search"></i>
                </span>
              </p>
            </div>
            <div class="field has-addons">
              <p class="control">
                <span class="button is-static is-small">Sort By</span>
              </p>
              <p class="control">
                <span class="select is-small">
                  <select id="threadSortSelect" onchange="applySort()">
                    <option value="activity">Last Reply</option>
                    <option value="mine">Mine & Replied</option>
                    <option value="created">Date Created</option>
                    <option value="author">Author</option>
                  </select>
                </span>
              </p>
            </div>
          </div>
        </div>

        <div id="threads-list">
          <!-- Threads will be rendered here -->
        </div>

        <div class="notification is-info is-light mt-6">
          <i class="fas fa-info-circle mr-2"></i> All discussions for this topic are listed above. To post, use the portal.
        </div>
      </div>
    `;

    root.innerHTML = html;
  }

  function renderEvaluation(evaluation, feedback_collapsed) {
    if (!evaluation) return '';
    
    return `
      <div class="notification is-success is-light">
        <div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
          <p class="has-text-weight-bold mb-0"><i class="fas fa-comment-dots mr-2"></i> Instructor Feedback</p>
          <button class="button is-small is-ghost has-text-success collapsible-trigger ${feedback_collapsed ? '' : 'is-active'}" onclick="toggleSection('feedback')">
             <span class="icon is-small">
               <i id="feedback-chevron" class="fas fa-chevron-right"></i>
             </span>
          </button>
        </div>
        <div id="feedback-content" class="${feedback_collapsed ? 'is-hidden' : ''}">
          <div class="content mt-2">
            ${evaluation.Feedback ? (evaluation.Feedback.Html || evaluation.Feedback.Text) : ''}
          </div>
          ${evaluation.Score ? `
            <div class="mt-2">
              <span class="tag is-success">Score: ${evaluation.Score}</span>
            </div>
          ` : ''}
        </div>
      </div>
    `;
  }

    return threads.map(item => {
      const thread = item.thread;
      const isParticipated = thread.UserParticipated;

      // Search Filtering
      let isVisible = true;
      let matchedPosts = [];

      if (currentSearchQuery) {
        const subjectMatch = (thread.Subject || thread.Title || "").toLowerCase().includes(currentSearchQuery);
        const authorMatch = (thread.PostingUserDisplayName || "").toLowerCase().includes(currentSearchQuery);
        
        // Flatten and search all posts in the tree
        const findMatches = (posts) => {
          let found = [];
          posts.forEach(p => {
            const bodyMatch = (p.Message?.Html || p.Message?.Text || "").toLowerCase().includes(currentSearchQuery);
            const postAuthorMatch = (p.Author?.DisplayName || p.PostingUserDisplayName || "").toLowerCase().includes(currentSearchQuery);
            const postSubjectMatch = (p.Subject || "").toLowerCase().includes(currentSearchQuery);
            
            if (bodyMatch || postAuthorMatch || postSubjectMatch) {
              found.push(p.PostId);
            }
            if (p.Replies) found = found.concat(findMatches(p.Replies));
          });
          return found;
        };

        matchedPosts = findMatches(item.post_tree);
        isVisible = subjectMatch || authorMatch || matchedPosts.length > 0;
      }

      if (!isVisible) return '';

      const threadContentClass = (currentSearchQuery && matchedPosts.length > 0) ? 'discussion-timeline' : 'discussion-timeline is-hidden';
      const chevronIcon = (currentSearchQuery && matchedPosts.length > 0) ? 'fa-chevron-down' : 'fa-chevron-right';

      return `
        <div class="thread-container announcement-item ${currentSearchQuery ? 'is-searching' : ''}" id="thread-${thread.ThreadId}">
          <div class="is-clickable py-3 collapsible-trigger ${currentSearchQuery && matchedPosts.length > 0 ? 'is-active' : ''}" onclick="toggleThread('${thread.ThreadId}', this)" style="cursor: pointer; border-bottom: 1px solid #f5f5f5;">
            <div class="is-flex is-align-items-start">
              <span class="icon is-small mt-1 ml-4 mr-2 has-text-grey-light"><i class="fas ${chevronIcon}"></i></span>
              <div style="flex: 1;">
                <h5 class="title is-5 mb-1">
                  ${thread.IsPinned ? '<i class="fas fa-thumbtack mr-2 has-text-primary"></i>' : ''}
                  ${highlightText(thread.Subject || thread.Title, currentSearchQuery)}
                </h5>
                <div class="is-size-7 has-text-grey">
                  <span class="has-text-weight-semibold author-name"><i class="fas fa-user-circle mr-1"></i> ${highlightText(thread.PostingUserDisplayName || 'Anonymous', currentSearchQuery)}</span>
                  ${thread.ThreadDate ? `
                    <span class="mx-2">&bull;</span>
                    <i class="fas fa-calendar-plus mr-1"></i> <span>${new Date(thread.ThreadDate).toLocaleString()}</span>
                  ` : ''}
                  ${thread.LastReplyDate ? `
                    <span class="mx-2">&bull;</span>
                    <i class="fas fa-clock mr-1"></i> <span>Last reply: ${new Date(thread.LastReplyDate).toLocaleString()}</span>
                  ` : ''}
                  ${thread.ReplyCount !== undefined ? `
                    <span class="mx-2">&bull;</span>
                    <span class="tag is-white py-0 px-0"><i class="fas fa-comments mr-1"></i> ${thread.ReplyCount} replies</span>
                  ` : ''}
                  ${isParticipated ? `
                    <span class="mx-2">&bull;</span>
                    <span class="tag is-success is-light is-small"><i class="fas fa-user-check mr-1"></i> Participated</span>
                  ` : ''}
                  ${matchedPosts.length > 0 && currentSearchQuery ? `
                    <span class="mx-2">&bull;</span>
                    <span class="tag is-info is-light is-small">${matchedPosts.length} post matches</span>
                  ` : ''}
                </div>
              </div>
            </div>
          </div>
          
          <div id="content-${thread.ThreadId}" class="${threadContentClass} ml-5 mt-2 pb-4">
            ${item.post_tree.map(post => renderPost(post, 1, matchedPosts)).join('')}
          </div>
        </div>
      `;
    }).join('');
  }

  function highlightText(text, query) {
    if (!query || !text) return text;
    const parts = text.split(new RegExp(`(${query})`, 'gi'));
    return parts.map(p => p.toLowerCase() === query.toLowerCase() ? `<mark class="p-0 has-background-warning">${p}</mark>` : p).join('');
  }

  function renderPost(post, depth, matchedIds = []) {
    const isInstructor = post.IsInstructor || (post.Author && (post.Author.IsInstructor || /Instructor/i.test(post.Author.RoleName)));
    const author = post.PostingUserDisplayName || (post.Author ? post.Author.DisplayName : 'Anonymous');
    const isMatched = matchedIds.includes(post.PostId);
    
    // Auto-expand replies if searching and they have matches
    const findSubMatches = (replies) => {
       if (!replies) return false;
       return replies.some(r => matchedIds.includes(r.PostId) || findSubMatches(r.Replies));
    };
    const hasSubMatches = findSubMatches(post.Replies);
    const showReplies = currentSearchQuery && (isMatched || hasSubMatches);

    return `
      <div class="post-item ${depth > 1 ? 'post-replies' : ''} ${isMatched ? 'is-matched' : ''}">
        <div class="post-card ${isInstructor ? 'is-instructor' : ''} ${isMatched ? 'has-border-warning' : ''}" id="post-${post.PostId}">
          <div class="post-header is-flex is-align-items-center is-justify-content-space-between">
            <div class="is-flex is-align-items-center">
              <div class="image is-24x24 mr-2">
                <img class="is-rounded" src="https://ui-avatars.com/api/?name=${encodeURIComponent(author)}&background=${isInstructor ? '739AC3' : 'ddd'}&color=fff" alt="Avatar">
              </div>
              <div class="is-size-7">
                <span class="has-text-weight-bold">${highlightText(author, currentSearchQuery)}</span>
                ${isInstructor ? '<span class="instructor-tag ml-1">INSTRUCTOR</span>' : ''}
              </div>
            </div>
            <div class="post-date">${new Date(post.DatePosted).toLocaleString()}</div>
          </div>
          <div class="post-body content">
             ${highlightText(post.Message ? (post.Message.Html || post.Message.Text) : '', currentSearchQuery)}
          </div>
        </div>
        ${post.Replies && post.Replies.length > 0 ? `
          <div class="ml-4 mb-2">
            <a class="is-size-7 has-text-link is-flex is-align-items-center collapsible-trigger ${showReplies ? 'is-active' : ''}" onclick="toggleReplies('${post.PostId}', this)" data-count="${post.Replies.length}" style="cursor: pointer;">
              <span class="icon is-small mr-1"><i class="fas ${showReplies ? 'fa-chevron-down' : 'fa-chevron-right'}"></i></span>
              <span>${showReplies ? 'Hide replies' : `Show ${post.Replies.length} replies`}</span>
            </a>
            <div id="replies-${post.PostId}" class="${showReplies ? '' : 'is-hidden'} mt-2">
              ${post.Replies.map(reply => renderPost(reply, depth + 1, matchedIds)).join('')}
            </div>
          </div>
        ` : ''}
      </div>
    `;
  }

  function toggleSection(section) {
    const btn = event.currentTarget;
    const content = document.getElementById(section + '-content');
    const isActive = btn.classList.toggle('is-active');
    
    if (isActive) content.classList.remove('is-hidden');
    else content.classList.add('is-hidden');

    fetch(`/course/${COURSE_ID}/discussions/toggle_collapse`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: `topic_id=${TOPIC_ID}&section=${section}`
    });
  }

  function toggleThread(id, el) {
    const content = document.getElementById('content-' + id);
    const isActive = el.classList.toggle('is-active');
    
    if (isActive) content.classList.remove('is-hidden');
    else content.classList.add('is-hidden');
  }

  window.toggleReplies = function(id, el) {
    const list = document.getElementById('replies-' + id);
    const isActive = el.classList.toggle('is-active');
    const span = el.querySelector('span:last-child');
    const count = el.dataset.count;
    
    if (isActive) {
      list.classList.remove('is-hidden');
      span.innerText = 'Hide replies';
    } else {
      list.classList.add('is-hidden');
      span.innerText = `Show ${count} replies`;
    }
  };

  document.addEventListener('DOMContentLoaded', () => loadTopic());

  window.addEventListener('brilliant:discussion_updated', (e) => {
    const { course_id, forum_id, topic_id, post_count } = e.detail;
    const root = document.getElementById('topic-root');
    
    if (course_id == COURSE_ID && forum_id == FORUM_ID && topic_id == TOPIC_ID && root && root.querySelector('.fa-circle-notch')) {
      console.log("[SSE] Discussion updated, refreshing content...");
      loadTopic();
    }
  });
</script>

<style>
  .thread-container { border-top: 1px solid #f5f5f5; margin-top: 0.5rem; }
  .post-replies { margin-left: 1.5rem; border-left: 2px solid #f0f4f8; padding-left: 1rem; position: relative; }
  .post-card { border: 1px solid #eee; border-radius: 6px; margin-bottom: 1rem; transition: all 0.2s; background: white; }
  .post-card:hover { border-color: #739AC3; }
  .post-header { background: #fafafa; padding: 0.5rem 1rem; border-bottom: 1px solid #eee; border-radius: 6px 6px 0 0; }
  .post-body { padding: 1rem; font-size: 0.95rem; line-height: 1.6; }
  .is-instructor { border-left: 4px solid #739AC3 !important; background: #f9fbfd; }
  .instructor-tag { background: #739AC3; color: white; padding: 1px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: bold; }
  .post-date { color: #888; font-size: 0.75rem; }
  .has-border-warning { border-color: #ffdd57 !important; border-width: 2px; }
  .post-item.is-matched { background-color: rgba(255, 221, 87, 0.05); }

  .collapsible-trigger .fa-chevron-right {
    transition: transform 0.2s ease;
  }

  .collapsible-trigger.is-active .fa-chevron-right {
    transform: rotate(90deg);
  }

  .announcement-item .collapsible-trigger .fa-chevron-right {
    transition: transform 0.2s ease;
  }

  .announcement-item .collapsible-trigger.is-active .fa-chevron-right {
    transform: rotate(90deg);
  }
</style>
