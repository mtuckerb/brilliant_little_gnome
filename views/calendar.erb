<div id="calendar-root">
  <div class="calendar-header-box mb-5">
    <div class="level">
      <div class="level-left">
        <div>
          <h1 class="title is-3 is-spaced mb-1">
            <span class="icon mr-2"><i class="fas fa-calendar-alt"></i></span>
            <span id="view-title">Multi-Week List</span>
          </h1>
          <p class="subtitle is-6 has-text-grey ml-1" id="date-range-display">
            Loading...
          </p>
        </div>
      </div>
      <div class="level-right">
        <div class="mr-4">
          <button onclick="openAddAssignmentModal()" class="button is-small is-primary is-light">
            <span class="icon is-small mr-1">
              <i class="fas fa-plus"></i>
            </span>
            <span>Add Assignment</span>
          </button>
        </div>

        <div class="mr-4">
          <button id="toggle-completed-btn" onclick="toggleCompletedFilter()" class="button is-small is-white">
            <span class="icon is-small mr-1">
              <i class="fas fa-eye-slash" id="completed-icon"></i>
            </span>
            <span id="completed-text">Show Completed</span>
          </button>
        </div>

        <div class="field has-addons mr-4">
          <p class="control">
            <button onclick="setView('month')" id="month-view-btn" class="button is-small">Month</button>
          </p>
          <p class="control">
            <button onclick="setView('week')" id="week-view-btn" class="button is-small">Week</button>
          </p>
        </div>

        <div class="field has-addons">
          <p class="control">
            <button onclick="navigate('prev-week')" class="button is-white" title="Previous Week">
              <span class="icon"><i class="fas fa-angle-double-left"></i></span>
            </button>
          </p>
          <p class="control">
            <button onclick="navigate('prev-day')" class="button is-white" title="Previous Day">
              <span class="icon"><i class="fas fa-angle-left"></i></span>
            </button>
          </p>
          <p class="control">
            <button onclick="navigate('today')" class="button is-white">Today</button>
          </p>
          <p class="control">
            <button onclick="navigate('next-day')" class="button is-white" title="Next Day">
              <span class="icon"><i class="fas fa-angle-right"></i></span>
            </button>
          </p>
          <p class="control">
            <button onclick="navigate('next-week')" class="button is-white" title="Next Week">
              <span class="icon"><i class="fas fa-angle-double-right"></i></span>
            </button>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div id="calendar-view-container">
    <div class="has-text-centered py-6">
       <span class="icon is-large has-text-grey-light">
          <i class="fas fa-spinner fa-pulse fa-2x"></i>
       </span>
    </div>
  </div>
</div>

<%= erb :'partials/edit_assignment_modal' %>
<%= erb :'partials/add_assignment_modal' %>

<!-- Fallback simple date modal for Non-assignment items (Grades etc) if needed -->
<div class="modal" id="simple-date-modal">
  <div class="modal-background" onclick="closeSimpleDateModal()"></div>
  <div class="modal-card">
    <header class="modal-card-head">
      <p class="modal-card-title">Change Date</p>
      <button class="delete" aria-label="close" onclick="closeSimpleDateModal()"></button>
    </header>
    <section class="modal-card-body">
      <div class="field">
        <label class="label" id="simple-modal-item-name"></label>
        <div class="is-flex" style="gap: 10px;">
          <div class="control" style="flex: 2;">
            <input class="input" type="date" id="simple-modal-due-date">
          </div>
          <div class="control" style="flex: 1;">
            <input class="input" type="time" id="simple-modal-due-time">
          </div>
        </div>
      </div>
      <input type="hidden" id="simple-modal-item-type">
      <input type="hidden" id="simple-modal-item-id">
    </section>
    <footer class="modal-card-foot">
      <button class="button is-primary" onclick="saveSimpleDate()">Save Changes</button>
      <button class="button" onclick="closeSimpleDateModal()">Cancel</button>
    </footer>
  </div>
</div>

<script>
  let state = {
    view: '<%= params[:view] || "week" %>',
    date: '<%= params[:date] || Time.zone.today.strftime("%Y-%m-%d") %>',
    show_completed: <%= params[:show_completed] == 'true' ? 'true' : 'false' %>,
    weeks_before: <%= (params[:weeks_before] || 0).to_i %>,
    weeks_after: <%= (params[:weeks_after] || 1).to_i %>,
    data: null
  };

  async function loadCalendar() {
    const params = new URLSearchParams({
      view: state.view,
      date: state.date,
      show_completed: state.show_completed,
      weeks_before: state.weeks_before,
      weeks_after: state.weeks_after
    });

    const container = document.getElementById('calendar-view-container');
    container.style.opacity = '0.5';

    try {
      const resp = await fetch(`/api/v1/calendar?${params.toString()}`);
      state.data = await resp.json();
      renderCalendar();
      updateHeader();
    } catch (err) {
      console.error(err);
      container.innerHTML = `<div class="notification is-danger">Failed to load calendar.</div>`;
    } finally {
      container.style.opacity = '1';
    }
  }

  function updateHeader() {
    const startObj = new Date(state.data.start_date + "T12:00:00");
    const endObj = new Date(state.data.end_date + "T12:00:00");
    
    const options = { timeZone: window.BRILLIANT_TIMEZONE };
    const rangeStr = `${startObj.toLocaleDateString(undefined, { ...options, month: 'short', day: 'numeric' })} - ${endObj.toLocaleDateString(undefined, { ...options, month: 'short', day: 'numeric', year: 'numeric' })}`;
    document.getElementById('date-range-display').innerText = rangeStr;
    document.getElementById('view-title').innerText = state.view === 'month' ? "Month Grid" : "Multi-Week List";

    document.getElementById('month-view-btn').classList.toggle('is-primary', state.view === 'month');
    document.getElementById('week-view-btn').classList.toggle('is-primary', state.view === 'week');

    document.getElementById('toggle-completed-btn').classList.toggle('is-info', state.show_completed);
    document.getElementById('completed-icon').className = state.show_completed ? 'fas fa-eye' : 'fas fa-eye-slash';
    document.getElementById('completed-text').innerText = state.show_completed ? "Hide Completed" : "Show Completed";
  }

  function renderCalendar() {
    const container = document.getElementById('calendar-view-container');
    if (state.view === 'month') {
      renderMonthView(container);
    } else {
      renderWeekView(container);
    }
  }

  function renderMonthView(container) {
    let html = `<div class="calendar-grid">`;
    ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"].forEach(d => {
      html += `<div class="day-header">${d}</div>`;
    });

    const options = { timeZone: window.BRILLIANT_TIMEZONE };
    const sortedDates = Object.keys(state.data.items_by_date).sort();
    sortedDates.forEach(dateStr => {
      const items = state.data.items_by_date[dateStr];
      const [y, m, d] = dateStr.split('-').map(Number);
      const dayObj = new Date(y, m - 1, d, 12, 0, 0); // Use noon to avoid TZ shifts
      const isToday = dateStr === state.data.today;

      html += `
        <div class="calendar-day ${isToday ? 'is-today' : ''} drop-zone" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event)" data-date="${dateStr}">
          <div class="level is-mobile mb-1">
            <div class="level-left">
              <span class="is-size-7 has-text-grey-light font-weight-bold mr-1">${dayObj.toLocaleDateString(undefined, { ...options, weekday: 'short'})}</span>
              <div class="day-number ${isToday ? 'has-text-primary has-text-weight-bold' : ''}">${dayObj.getDate()}</div>
            </div>
            ${dayObj.getDate() === 1 ? `<div class="level-right"><span class="tag is-light is-size-7">${dayObj.toLocaleDateString(undefined, { ...options, month: 'short'})}</span></div>` : ''}
          </div>
          <div class="day-content">
            ${items.map(item => renderCalendarItem(item, 'tiny')).join('')}
          </div>
        </div>
      `;
    });
    html += `</div>`;
    container.innerHTML = html;
  }

  function renderWeekView(container) {
    let html = `<div class="week-list">`;
    html += `
      <div class="extend-view-row p-2 has-background-white-bis" style="border-bottom: 1px solid #eee;">
        <button onclick="extend('before')" class="button is-ghost is-fullwidth is-small has-text-grey">
          <span class="icon"><i class="fas fa-plus-circle"></i></span>
          <span>Extend View (Earlier)</span>
        </button>
      </div>
    `;

    const options = { timeZone: window.BRILLIANT_TIMEZONE };
    const sortedDates = Object.keys(state.data.items_by_date).sort();
    sortedDates.forEach(dateStr => {
      const items = state.data.items_by_date[dateStr];
      const [y, m, d] = dateStr.split('-').map(Number);
      const dayObj = new Date(y, m - 1, d, 12, 0, 0); // Use noon to avoid TZ shifts
      const isToday = dateStr === state.data.today;

      html += `
        <div class="week-row ${isToday ? 'is-today' : ''}">
          <div class="week-date-column">
            <div class="week-day-name">${dayObj.toLocaleDateString(undefined, { ...options, weekday: 'long'})}</div>
            <div class="week-day-number ${isToday ? 'has-text-primary' : ''}">${dayObj.toLocaleDateString(undefined, { ...options, month: 'short', day: '2-digit'})}</div>
          </div>
          <div class="week-items-column drop-zone" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event)" data-date="${dateStr}">
            ${items.length === 0 ? `<div class="has-text-grey-light is-size-7 mt-2 no-items-msg">No items due.</div>` : ''}
            <div class="week-items-grid">
               ${items.map(item => renderCalendarItem(item, 'large')).join('')}
            </div>
          </div>
        </div>
      `;
    });

    html += `
      <div class="extend-view-row p-2 has-background-white-bis" style="border-top: 1px solid #eee;">
        <button onclick="extend('after')" class="button is-ghost is-fullwidth is-small has-text-grey">
          <span class="icon"><i class="fas fa-plus-circle"></i></span>
          <span>Extend View (Later)</span>
        </button>
      </div>
    </div>`;
    container.innerHTML = html;
  }

  function renderCalendarItem(item, size) {
    const isCompleted = item.completed;
    const isOptional = item.optional;
    const typeClass = item.type;
    const compClass = isCompleted ? 'is-completed' : '';
    const optClass = isOptional ? 'is-optional' : '';
    
    // Safely escape quotes for data attributes
    const esc = (s) => (s || '').toString().replace(/"/g, '&quot;');
    
    const dragAttrs = `draggable="true" ondragstart="handleDragStart(event)" data-type="${esc(item.type)}" data-item-id="${esc(item.id)}" data-db-id="${esc(item.db_id)}" data-name="${esc(item.name)}" data-date="${esc(item.date)}" data-full-date="${esc(item.time)}" data-course-id="${esc(item.course_id)}"`;

    if (size === 'tiny') {
        return `
          <div class="calendar-item-wrapper" ${dragAttrs}>
            ${item.type === 'assignment' ? `
              <button class="button is-ghost is-small toggle-complete-btn p-0 mr-1" onclick="toggleComplete('${item.db_id}', event)">
                <span class="icon is-small">
                  <i class="${isCompleted ? 'fas fa-check-circle has-text-success' : 'far fa-circle has-text-grey-light'}"></i>
                </span>
              </button>` : ''}
            <div class="calendar-item ${typeClass} ${compClass} ${optClass}" onmouseenter="handleItemHover(this)" 
                 data-db-id="${item.db_id}" data-type="${item.type}" data-item-id="${item.id}" data-course-id="${item.course_id}">
              <a href="${item.url}" class="item-name has-text-dark" style="text-decoration: none;">${item.name_html}</a>
            </div>
            <button class="button is-ghost is-small edit-item-btn p-1" onclick="handleEditClick(this, event)">
              <span class="icon is-small"><i class="fas fa-edit"></i></span>
            </button>
          </div>
        `;
    }

    return `
      <div class="calendar-item-wrapper" ${dragAttrs}>
        ${item.type === 'assignment' ? `
          <button class="button is-ghost is-small toggle-complete-btn p-0 mr-2" onclick="toggleComplete('${item.db_id}', event)">
            <span class="icon">
              <i class="${isCompleted ? 'fas fa-check-circle fa-lg has-text-success' : 'far fa-circle fa-lg has-text-grey-light'}"></i>
            </span>
          </button>` : ''}
        <div class="calendar-item is-large ${typeClass} ${compClass} ${optClass}" style="${item.pill_style || ''}">
          <div class="level is-mobile mb-0">
            <div class="level-left" style="flex-shrink: 1; overflow: hidden;">
              <span class="tag is-white is-rounded mr-2">${item.time_display}</span>
              ${item.course_prefix ? `<span class="tag mr-2 has-text-weight-bold" style="background:rgba(0,0,0,0.05)">${item.course_prefix}</span>` : ''}
              <a href="${item.url}" class="item-name-full has-text-dark" style="text-decoration: none;">${item.name_html}</a>
            </div>
            <div class="level-right">
              <button class="button is-ghost is-small p-0 ml-4" onclick="expandItemSPA('${item.db_id}', event)">
                <span class="icon is-small has-text-grey-light"><i class="fas fa-chevron-right toggle-icon"></i></span>
              </button>
            </div>
          </div>
          <div id="expand-${item.db_id}" class="item-details is-hidden mt-2 pt-2" style="border-top: 1px solid rgba(0,0,0,0.05);">
            <div class="content is-size-7" id="content-${item.db_id}">
               <p>Loading details...</p>
            </div>
          </div>
        </div>
        <button class="button is-ghost is-small edit-item-btn p-1 ml-2" onclick="handleEditClick(this, event)">
          <span class="icon is-small"><i class="fas fa-edit"></i></span>
        </button>
      </div>
    `;
  }

  // Action Helpers
  function setView(v) { state.view = v; loadCalendar(); }
  function toggleCompletedFilter() { state.show_completed = !state.show_completed; loadCalendar(); }
  function extend(dir) {
    if (dir === 'before') state.weeks_before++;
    else state.weeks_after++;
    loadCalendar();
  }
  function navigate(dir) {
    const d = new Date(state.date + "T12:00:00");
    if (dir === 'prev-week') d.setDate(d.getDate() - 7);
    else if (dir === 'prev-day') d.setDate(d.getDate() - 1);
    else if (dir === 'next-day') d.setDate(d.getDate() + 1);
    else if (dir === 'next-week') d.setDate(d.getDate() + 7);
    else if (dir === 'today') {
        state.date = state.data.today;
        loadCalendar();
        return;
    }
    state.date = d.toISOString().split('T')[0];
    loadCalendar();
  }

  async function toggleComplete(dbId, event) {
    event.stopPropagation();
    try {
      const resp = await fetch(`/assignments/${dbId}/toggle_complete`, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      const data = await resp.json();
      if (data.status === 'ok') loadCalendar();
    } catch (err) { console.error(err); }
  }

  function expandItemSPA(dbId, event) {
    event.stopPropagation();
    const detailsDiv = document.getElementById(`expand-${dbId}`);
    const icon = event.currentTarget.querySelector('.toggle-icon');
    
    if (!detailsDiv.classList.contains('is-hidden')) {
      detailsDiv.classList.add('is-hidden');
      icon.classList.replace('fa-chevron-down', 'fa-chevron-right');
      return;
    }
    
    detailsDiv.classList.remove('is-hidden');
    icon.classList.replace('fa-chevron-right', 'fa-chevron-down');
    
    if (detailsDiv.dataset.loaded !== 'true') {
      const wrapper = detailsDiv.closest('.calendar-item-wrapper');
      const { type } = wrapper.dataset;
      const itemId = wrapper.dataset.itemId;
      const course_id = wrapper.dataset.courseId;
      
      fetch(`/api/v1/item_details?type=${type}&id=${itemId}&course_id=${course_id}`)
        .then(r => r.json())
        .then(data => {
            detailsDiv.querySelector('.content').innerHTML = data.html || '<p class="has-text-grey">No description.</p>';
            detailsDiv.dataset.loaded = 'true';
        });
    }
  }

  function getTZParts(date) {
    if (!date) return { date: '', time: '23:59' };
    const options = {
      timeZone: window.BRILLIANT_TIMEZONE,
      hour12: false,
      year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit'
    };
    try {
      const formatter = new Intl.DateTimeFormat('en-US', options);
      const parts = formatter.formatToParts(date);
      const getPart = (type) => parts.find(p => p.type === type).value;
      return {
        date: `${getPart('year')}-${getPart('month')}-${getPart('day')}`,
        time: `${getPart('hour')}:${getPart('minute')}`
      };
    } catch (e) {
      console.error("TZ Formatting Error", e);
      return { date: date.toISOString().split('T')[0], time: '23:59' };
    }
  }

  function handleEditClick(btn, event) {
    event.stopPropagation();
    const wrapper = btn.closest('.calendar-item-wrapper');
    const { type, name, date, fullDate } = wrapper.dataset;
    const itemId = wrapper.dataset.itemId;
    const courseId = wrapper.dataset.courseId;
    
    if (type === 'assignment') {
      fetch(`/course/${courseId}/assignments/${itemId}`, { 
        headers: {
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
        .then(r => {
          if (!r.ok) throw new Error(`HTTP ${r.status}: ${r.statusText}`);
          return r.json();
        })
        .then(assignment => {
           const dt = assignment.DueDate ? new Date(assignment.DueDate) : null;
           const tz = getTZParts(dt);
           
           openEditAssignmentModal({
             courseId: courseId,
             brightspaceId: itemId,
             name: assignment.Name || name,
             dueDate: dt ? tz.date : (date || ''),
             dueTime: dt ? tz.time : (fullDate.includes('T') ? fullDate.split('T')[1].substring(0,5) : '23:59'),
             externalUrl: assignment.ExternalUrl || '',
             description: assignment.Instructions?.Text || assignment.Description || ''
           });
        })
        .catch(err => {
          console.error('Failed to load assignment for editing:', err);
          alert('Could not load assignment details. Please try again.');
        });
    } else {
      // Fallback for non-assignments (like Grades)
      document.getElementById('simple-modal-item-name').innerText = name;
      document.getElementById('simple-modal-due-date').value = date;
      const dt = fullDate ? new Date(fullDate) : null;
      document.getElementById('simple-modal-due-time').value = dt ? getTZParts(dt).time : '23:59';
      document.getElementById('simple-modal-item-type').value = type;
      document.getElementById('simple-modal-item-id').value = itemId;
      document.getElementById('simple-date-modal').classList.add('is-active');
    }
  }

  function closeSimpleDateModal() { document.getElementById('simple-date-modal').classList.remove('is-active'); }

  async function saveSimpleDate() {
    const type = document.getElementById('simple-modal-item-type').value;
    const id = document.getElementById('simple-modal-item-id').value;
    const date = document.getElementById('simple-modal-due-date').value;
    const time = document.getElementById('simple-modal-due-time').value;
    
    try {
      const resp = await fetch('/calendar/update_due_date', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
        body: `type=${type}&id=${id}&due_date=${date}T${time}`
      });
      const data = await resp.json();
      if (data.status === 'ok') { closeSimpleDateModal(); loadCalendar(); }
    } catch (err) { console.error(err); }
  }

  // Override the saveAssignmentEdits from the partial to ensure we refresh our calendar
  // instead of assuming a location.reload() or doing nothing.
  window.saveAssignmentEdits = async function() {
    const form = document.getElementById('editAssignmentForm');
    const btn = document.getElementById('save-assignment-btn');
    const errorDiv = document.getElementById('edit-assignment-error');
    const formData = new FormData(form);
    
    errorDiv.classList.add('is-hidden');
    btn.classList.add('is-loading');
    
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: new URLSearchParams(formData)
      });
      const data = await response.json();
      if (data.status === 'ok') {
        closeEditAssignmentModal();
        loadCalendar(); // Refresh just the calendar data
      } else {
        errorDiv.innerText = data.error || data.message || "Failed to save changes.";
        errorDiv.classList.remove('is-hidden');
      }
    } catch (err) { 
      console.error(err);
      errorDiv.innerText = "A network error occurred: " + err.message;
      errorDiv.classList.remove('is-hidden');
    } finally { 
      btn.classList.remove('is-loading'); 
    }
  };

  // Drag & Drop
  function handleDragStart(event) {
    const wrapper = event.target.closest('.calendar-item-wrapper');
    if (!wrapper) return;
    
    // Set visual state
    wrapper.classList.add('is-dragging');
    
    const data = { 
      type: wrapper.dataset.type, 
      id: wrapper.dataset.itemId, 
      db_id: wrapper.dataset.dbId,
      originalDate: wrapper.dataset.date 
    };
    
    event.dataTransfer.effectAllowed = 'move';
    event.dataTransfer.setData('application/json', JSON.stringify(data));
    
    // Required for some browsers to allow the drag ghost to show before reducing opacity
    setTimeout(() => wrapper.style.opacity = '0.4', 50);
  }

  // Use a more robust global listener for cleanup
  document.addEventListener('dragend', e => { 
    document.querySelectorAll('.calendar-item-wrapper.is-dragging').forEach(w => {
      w.style.opacity = '1';
      w.classList.remove('is-dragging');
    });
    document.querySelectorAll('.drop-zone').forEach(dz => dz.classList.remove('drag-over'));
  });

  function handleDragOver(e) { 
    e.preventDefault(); 
    e.dataTransfer.dropEffect = 'move';
    const zone = e.target.closest('.drop-zone');
    if (zone) zone.classList.add('drag-over'); 
  }

  function handleDragLeave(e) { 
    const zone = e.target.closest('.drop-zone');
    if (zone) zone.classList.remove('drag-over'); 
  }

  async function handleDrop(e) {
    e.preventDefault();
    const zone = e.target.closest('.drop-zone');
    if (!zone) return;
    
    zone.classList.remove('drag-over');
    const newDate = zone.dataset.date;
    
    try {
      const rawData = e.dataTransfer.getData('application/json');
      if (!rawData) return;
      
      const data = JSON.parse(rawData);
      if (data.originalDate !== newDate) {
          // Use the more granular update Endpoint
          const resp = await fetch('/calendar/update_due_date', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: `type=${data.type}&id=${data.id}&due_date=${newDate}`
          });
          const result = await resp.json();
          if (result.status === 'ok') {
            loadCalendar();
          } else {
            console.error("Drop save failed:", result);
          }
      }
    } catch(err) {
      console.error("Drop error:", err);
    }
  }

  document.addEventListener('DOMContentLoaded', loadCalendar);
</script>

<style>
  .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); border: 1px solid #eee; background: #fff; border-radius: 8px; overflow: hidden; }
  .day-header { background: #f9f9f9; padding: 10px; text-align: center; font-weight: bold; border-right: 1px solid #eee; border-bottom: 1px solid #eee; font-size: 0.8rem; }
  .calendar-day { min-height: 120px; padding: 8px; border-right: 1px solid #eee; border-bottom: 1px solid #eee; }
  .calendar-day.is-today { background: #f0f7ff; }
