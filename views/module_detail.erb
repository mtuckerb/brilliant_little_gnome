<%= erb :'partials/course_detail_header' %>
<div class="columns">
  <div class="column is-3">
    <%= erb :'partials/sidebar' %>
  </div>
  <div class="column is-9">
    <% if @module %>
      <div class="box">
        <div class="level">
          <div class="level-left">
            <h4 class="title is-4"><%= @module['Title'] %></h4>
          </div>
          <div class="level-right">
            <% 
               # Count downloadable files
               download_count = collect_all_files(@module, "").size
            %>
            <% if download_count > 1 %>
              <a href="/course/<%= @course_id %>/module/<%= @module_id %>/download_all" class="button is-primary is-small">
                 <span class="icon is-small mr-1"><i class="fas fa-file-zipper"></i></span>
                 Download all in Module (<%= download_count %>)
              </a>
            <% end %>
          </div>
        </div>
        <div class="content mb-5">
          <% 
             desc = @module['Description']
             desc_text = desc.is_a?(Hash) ? (desc['Html'] || desc['Text'] || "") : desc.to_s
          %>
          <%= desc_text unless desc_text.empty? %>
        </div>

        <% if @module['Topics'] && !@module['Topics'].empty? %>
          <div class="list is-hoverable mb-5">
            <% @module['Topics'].each do |topic| %>
              <div class="list-item p-3">
                <div class="is-flex is-justify-content-space-between is-align-items-center">
                  <div>
                    <span class="topic-icon mr-2">
                      <% if topic['Type'] == 1 %> <!-- File -->
                        <i class="fas fa-file"></i>
                      <% elsif topic['Type'] == 3 %> <!-- Link -->
                        <i class="fas fa-link"></i>
                      <% else %>
                        <i class="fas fa-info-circle"></i>
                      <% end %>
                    </span>
                    <span class="has-text-weight-medium"><%= topic['Title'] %></span>
                  </div>
                  <% if topic['Url'] && topic['Url'].start_with?('/content/enforced/') %>
                    <a href="/course/<%= @course_id %>/topic/<%= topic['Id'] || topic['TopicId'] %>/download" class="button is-small is-link is-outlined" target="_blank">
                      <i class="fas fa-download mr-1"></i> Download
                    </a>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if @module['Modules'] && !@module['Modules'].empty? %>
          <div class="submodules-section mt-6">
            <h5 class="subtitle is-5 border-bottom pb-2">Sub-modules</h5>
            <% @module['Modules'].each do |sub| %>
              <%= erb :'partials/module_collapsible', locals: { mod: sub } %>
            <% end %>
          </div>
        <% end %>
      </div>

      <script>
        function toggleCollapsibleModule(id) {
          const content = document.getElementById('content-' + id);
          const icon = document.getElementById('icon-' + id);
          if (content.style.display === 'none') {
            content.style.display = 'block';
            icon.classList.remove('fa-chevron-right');
            icon.classList.add('fa-chevron-down');
          } else {
            content.style.display = 'none';
            icon.classList.remove('fa-chevron-down');
            icon.classList.add('fa-chevron-right');
          }
        }
      </script>

      <style>
        .border-left { border-left: 2px solid #f5f5f5; }
        .border-bottom { border-bottom: 2px solid #f5f5f5; }
      </style>
    <% else %>
      <div class="notification is-danger">Module not found.</div>
    <% end %>
  </div>
</div>
