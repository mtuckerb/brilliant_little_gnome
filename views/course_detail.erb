<%= erb :'partials/course_detail_header' %>
<div class="columns">
  <div class="column is-3">
    <%= erb :'partials/sidebar' %>
  </div>
  <div class="column is-9">
    <% if @course_upcoming && !@course_upcoming.empty? %>
      <div class="notification is-warning is-light mb-4">
        <button class="delete"></button>
        <h5 class="title is-5 mb-2"><i class="fas fa-calendar-day mr-2"></i> Upcoming Assignments (Next 7 Days)</h5>
        <% @course_upcoming.each do |a| %>
          <div class="box p-3 mb-2" style="background: rgba(255,255,255,0.5); border: 1px solid rgba(0,0,0,0.05);">
            <div class="is-flex is-justify-content-space-between is-align-items-center">
              <div class="is-flex is-align-items-center">
                <div class="control mr-3">
                  <input type="checkbox" class="assignment-checkbox" data-id="<%= a.id %>" onchange="toggleAssignmentInline(this)">
                </div>
                <strong><%= a.name %></strong>
              </div>
              <span class="has-text-danger is-size-7">
                Due: <%= format_date(a.due_date, "%A, %b %d at %I:%M %p") %>
                <a href="/course/<%= @course_id %>/assignments/<%= a.brightspace_id %>" class="button is-small is-white has-text-link ml-2">View</a>
              </span>
            </div>
          </div>
        <% end %>
      </div>
   <% end %>

    <div class="box">
      <div class="mb-5">
          <h4 class="title is-4 mb-2">Syllabus / Overview</h4>
          <div class="is-flex is-justify-content-end">
            <div class="buttons">
              <% if @overview && (@overview['HasAttachment'] || @overview['Attachment']) %>
                <a href="/course/<%= @course_id %>/overview/download" class="button is-link is-small" target="_blank">
                    <span class="icon is-small mr-1"><i class="fas fa-file-download"></i></span>
                    Syllabus File 
                </a>
              <% end %>
              <a href="/course/<%= @course_id %>/download_all" class="button is-primary is-small">
                  <span class="icon is-small mr-1"><i class="fas fa-archive"></i></span>
                  Download Everything (Zip)
              </a>
            </div>
          </div>
      </div>

      <% if @overview && ((@overview['Attachments'] && !@overview['Attachments'].empty?) || (@overview['LinkAttachments'] && !@overview['LinkAttachments'].empty?)) %>
        <div class="box is-light mb-5">
          <h5 class="subtitle is-5"><span class="icon mr-2"><i class="fas fa-paperclip"></i></span> Additional Overview Attachments</h5>
          <div class="buttons">
            <% if @overview['Attachments'] %>
              <% @overview['Attachments'].each_with_index do |att, idx| %>
                <% 
                    # Some APIs return simple strings or hashes
                    name = att['FileName'] || att['Name'] || "Attachment #{idx+1}"
                    id = att['Id'] || att['FileId']
                %>
                <a href="/course/<%= @course_id %>/download?path=<%= att['Path'] || "/d2l/api/le/1.40/#{@course_id}/overview/attachments/#{id}" %>&name=<%= URI.encode_www_form_component(name) %>" class="button is-small is-outlined is-link">
                  <span class="icon is-small"><i class="fas fa-file"></i></span>
                  <span><%= name %></span>
                </a>
              <% end %>
            <% end %>

            <% if @overview['LinkAttachments'] %>
              <% @overview['LinkAttachments'].each do |link| %>
                <a href="<%= link['Url'] %>" target="_blank" class="button is-small is-outlined is-info">
                  <span class="icon is-small"><i class="fas fa-external-link-alt"></i></span>
                  <span><%= link['Title'] || link['Url'] %></span>
                </a>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="content">
        <%# --- DESCRIPTION --- %>
        <% if @overview %>
          <% 
              desc = @overview['Description']
              desc_text = desc.is_a?(Hash) ? (desc['Html'] || desc['Text'] || "") : desc.to_s
          %>
          <% unless desc_text.strip.empty? %>
            <div class="mb-5">
              <details class="section-details">
                <summary class="is-clickable p-2 has-background-light" style="list-style: none; outline: none; border-radius: 4px;">
                  <div class="is-flex is-justify-content-space-between is-align-items-center">
                    <h5 class="title is-5 mb-0"><i class="fas fa-align-left mr-2 has-text-primary"></i> Course Description</h5>
                    <span class="icon is-small has-text-grey">
                      <i class="fas fa-chevron-down"></i>
                    </span>
                  </div>
                </summary>
                <div class="content p-4 has-background-white border-light">
                  <%= fix_links(desc_text) %>
                </div>
              </details>
            </div>
          <% end %>
        <% end %>

        <% if @syllabus_info && (@syllabus_info[:modules].any? || @syllabus_info[:topics].any?) %>
          <div class="mt-5">
            <h5 class="title is-5"><span class="icon has-text-primary mr-2"><i class="fas fa-search"></i></span> Items Found in Content</h5>
            
            <% @syllabus_info[:modules].each do |mod| %>
                <div class="box is-light">
                  <div class="is-flex is-justify-content-space-between is-align-items-center">
                    <span class="has-text-weight-bold"><%= mod['Title'] %> (Module)</span>
                    <a href="/course/<%= @course_id %>/module/<%= mod['ModuleId'] %>" class="button is-small is-primary is-outlined">View Module</a>
                  </div>
                  <% if mod['Topics'] && !mod['Topics'].empty? %>
                    <div class="list mt-2">
                      <% mod['Topics'].each do |topic| %>
                          <div class="list-item">
                            <div class="is-flex is-justify-content-space-between is-align-items-center">
                              <span>
                                <span class="icon is-small mr-2"><i class="fas fa-file-alt"></i></span>
                                <% if topic['Url'] %>
                                  <% 
                                    full_url = topic['Url']
                                    if full_url.start_with?("/") 
                                      full_url = "https://#{$client.host}#{full_url}"
                                    end
                                  %>
                                  <a href="<%= full_url %>" target="_blank"><%= topic['Title'] %></a>
                                <% else %>
                                  <%= topic['Title'] %>
                                <% end %>
                              </span>
                              <% if topic['Url'] && topic['Url'].start_with?("/content/enforced/") %>
                                <a href="/course/<%= @course_id %>/topic/<%= topic['TopicId'] || topic['Id'] || topic['Identifier'] %>/download" class="button is-small is-link is-inverted">Download</a>
                              <% end %>
                            </div>
                          </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
            <% end %>

            <% if @syllabus_info[:topics].any? %>
              <div class="list is-hoverable mt-3">
                <% @syllabus_info[:topics].each do |topic| %>
                    <div class="list-item">
                      <div class="is-flex is-justify-content-space-between is-align-items-center">
                          <div>
                            <span class="icon is-small has-text-info mr-2"><i class="fas fa-file-pdf"></i></span>
                            <span class="has-text-weight-medium">
                              <% if topic['Url'] %>
                                <% 
                                  full_url = topic['Url']
                                  if full_url.start_with?("/") 
                                    full_url = "https://#{$client.host}#{full_url}"
                                  end
                                %>
                                <a href="<%= full_url %>" target="_blank"><%= topic['Title'] %></a>
                              <% else %>
                                <%= topic['Title'] %>
                              <% end %>
                            </span>
                          </div>
                          <% if topic['Url'] && topic['Url'].start_with?("/content/enforced/") %>
                            <a href="/course/<%= @course_id %>/topic/<%= topic['Id'] || topic['TopicId'] || topic['Identifier'] %>/download" class="button is-small is-link is-outlined" target="_blank">Download</a>
                          <% end %>
                      </div>
                    </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% elsif !@overview %>
          <p class="has-text-grey-light mb-5">No specific "Overview" found and no syllabus-like items detected in course content yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
  .section-details summary::-webkit-details-marker { display: none; }
  .section-details[open] summary .fa-chevron-down { transform: rotate(180deg); }
  .section-details summary .fa-chevron-down { transition: transform 0.2s ease-in-out; }
  .border-light { border: 1px solid #eee; border-top: none; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; }
</style>

<script>
function toggleAssignmentInline(checkbox) {
  const id = checkbox.getAttribute('data-id');
  const box = checkbox.closest('.box');
  
  fetch(`/assignments/${id}/toggle_complete`, {
    method: 'POST',
    headers: { 'X-Requested-With': 'XMLHttpRequest' }
  })
  .then(response => response.json())
  .then(data => {
    if (data.status === 'ok' && data.completed) {
      box.style.opacity = '0.5';
      setTimeout(() => { box.style.display = 'none'; }, 800);
    }
  })
  .catch(err => console.error("Error toggling assignment:", err));
}
</script>
