<%= erb :'partials/course_detail_header' %>
<div class="columns">
  <div class="column is-3">
    <%= erb :'partials/sidebar' %>
  </div>
  <div class="column is-9">
    <div class="box">
      <% if @overview %>
         <div class="level">
             <div class="level-left">
                <h4 class="title is-4">Syllabus / Overview</h4>
             </div>
             <div class="level-right">
                <div class="buttons">
                  <% if @overview['HasAttachment'] || @overview['Attachment'] %>
                    <a href="/course/<%= @course_id %>/overview/download" class="button is-link is-small" target="_blank">
                       <span class="icon is-small mr-1"><i class="fas fa-file-download"></i></span>
                       Syllabus File 
                    </a>
                  <% end %>
                  <a href="/course/<%= @course_id %>/download_all" class="button is-primary is-small">
                     <span class="icon is-small mr-1"><i class="fas fa-archive"></i></span>
                     Download Everything (Zip)
                  </a>
                </div>
             </div>
         </div>

         <% if (@overview['Attachments'] && !@overview['Attachments'].empty?) || (@overview['LinkAttachments'] && !@overview['LinkAttachments'].empty?) %>
            <div class="box is-light">
              <h5 class="subtitle is-5"><span class="icon mr-2"><i class="fas fa-paperclip"></i></span> Additional Overview Attachments</h5>
              <div class="buttons">
                <% if @overview['Attachments'] %>
                  <% @overview['Attachments'].each_with_index do |att, idx| %>
                    <% 
                       # Some APIs return simple strings or hashes
                       name = att['FileName'] || att['Name'] || "Attachment #{idx+1}"
                       id = att['Id'] || att['FileId']
                    %>
                    <a href="/course/<%= @course_id %>/download?path=<%= att['Path'] || "/d2l/api/le/1.40/#{@course_id}/overview/attachments/#{id}" %>&name=<%= URI.encode_www_form_component(name) %>" class="button is-small is-outlined is-link">
                      <span class="icon is-small"><i class="fas fa-file"></i></span>
                      <span><%= name %></span>
                    </a>
                  <% end %>
                <% end %>

                <% if @overview['LinkAttachments'] %>
                  <% @overview['LinkAttachments'].each do |link| %>
                    <a href="<%= link['Url'] %>" target="_blank" class="button is-small is-outlined is-info">
                      <span class="icon is-small"><i class="fas fa-external-link-alt"></i></span>
                      <span><%= link['Title'] || link['Url'] %></span>
                    </a>
                  <% end %>
                <% end %>
              </div>
            </div>
         <% end %>

         <div class="content">
            <% 
               desc = @overview['Description']
               desc_text = desc.is_a?(Hash) ? (desc['Html'] || desc['Text'] || "") : desc.to_s
            %>
            <% unless desc_text.strip.empty? %>
              <%= desc_text %> 
            <% else %>
              <p class="has-text-grey-light">No description provided and no "Overview" attachment.</p>
            <% end %>

            <% if @syllabus_info && (@syllabus_info[:modules].any? || @syllabus_info[:topics].any?) %>
              <div class="mt-5">
                <h5 class="title is-5"><span class="icon has-text-primary mr-2"><i class="fas fa-search"></i></span> Related Course Information</h5>
                
                <% @syllabus_info[:modules].each do |mod| %>
                   <div class="box is-light">
                      <div class="is-flex is-justify-content-space-between is-align-items-center">
                        <span class="has-text-weight-bold"><%= mod['Title'] %> (Module)</span>
                        <a href="/course/<%= @course_id %>/module/<%= mod['ModuleId'] %>" class="button is-small is-primary is-outlined">View Module</a>
                      </div>
                      <% if mod['Topics'] && !mod['Topics'].empty? %>
                        <div class="list mt-2">
                          <% mod['Topics'].each do |topic| %>
                             <div class="list-item">
                               <div class="is-flex is-justify-content-space-between is-align-items-center">
                                  <span><span class="icon is-small mr-2"><i class="fas fa-file-alt"></i></span><%= topic['Title'] %></span>
                                  <a href="/course/<%= @course_id %>/topic/<%= topic['TopicId'] || topic['Id'] %>/download" class="button is-small is-link is-inverted">Download</a>
                               </div>
                             </div>
                          <% end %>
                        </div>
                      <% end %>
                   </div>
                <% end %>

                <% if @syllabus_info[:topics].any? %>
                  <div class="list is-hoverable mt-3">
                    <% @syllabus_info[:topics].each do |topic| %>
                       <div class="list-item">
                          <div class="is-flex is-justify-content-space-between is-align-items-center">
                             <div>
                               <span class="icon is-small has-text-info mr-2"><i class="fas fa-file-pdf"></i></span>
                               <span class="has-text-weight-medium"><%= topic['Title'] %></span>
                             </div>
                             <a href="/course/<%= @course_id %>/topic/<%= topic['Id'] || topic['TopicId'] %>/download" class="button is-small is-link is-outlined" target="_blank">Download</a>
                          </div>
                       </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
         </div>

      <% end %>
    </div>
  </div>
</div>
