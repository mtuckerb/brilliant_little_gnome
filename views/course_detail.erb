<%= erb :'partials/course_detail_header' %>
<div class="columns">
  <div class="column is-3">
    <%= erb :'partials/sidebar' %>
  </div>
  <div class="column is-9" id="course-root">
    <div class="is-flex is-justify-content-center is-align-items-center" style="min-height: 400px;">
      <div class="has-text-centered">
        <span class="icon is-large has-text-primary mb-4">
          <i class="fas fa-circle-notch fa-spin fa-3x"></i>
        </span>
        <p class="is-size-5 has-text-grey">Loading Course Content...</p>
      </div>
    </div>
  </div>
</div>

<script>
  const COURSE_ID = "<%= @course_id %>";

  async function loadCourse() {
    const root = document.getElementById('course-root');
    try {
      const response = await fetch(`/api/v1/courses/${COURSE_ID}/summary`);
      if (!response.ok) throw new Error("Failed to fetch");
      const data = await response.json();
      renderCourse(data);
    } catch (err) {
      console.error(err);
      root.innerHTML = `
        <div class="notification is-danger">
          <h3 class="title is-5">Error Connection Lost</h3>
          <p>Failed to load course details. Please ensure the backend is running.</p>
          <button class="button is-white is-small mt-2" onclick="location.reload()">Retry</button>
        </div>
      `;
    }
  }

  function renderCourse(data) {
    const root = document.getElementById('course-root');
    const { course, overview, syllabus_info, upcoming_assignments, grade_stats, toc } = data;

    let html = `
      <div class="box">
        <div class="mb-5">
            <div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
              <h4 class="title is-4 mb-0">Syllabus / Overview</h4>
              <div class="buttons">
                ${(overview && (overview.HasAttachment || overview.Attachment)) ? `
                  <button class="button is-info is-small" onclick="openPdfViewer('/course/${COURSE_ID}/overview/view', '/course/${COURSE_ID}/overview/download', 'Syllabus')">
                      <span class="icon is-small mr-1"><i class="fas fa-eye"></i></span>
                      View Syllabus
                  </button>
                  <a href="/course/${COURSE_ID}/overview/download" class="button is-link is-small" target="_blank">
                      <span class="icon is-small mr-1"><i class="fas fa-file-download"></i></span>
                      Download 
                  </a>
                ` : ''}
                <a href="/course/${COURSE_ID}/download_all" class="button is-primary is-small">
                    <span class="icon is-small mr-1"><i class="fas fa-archive"></i></span>
                    Download Everything (Zip)
                </a>
              </div>
            </div>

            <!-- Course Settings -->
            ${renderSettings(course)}
        </div>

        <div class="content">
          <!-- Description -->
          ${(overview && overview.description_html) ? `
            <div class="mb-5">
              <details class="section-details">
                <summary class="is-clickable p-2 has-background-light" style="list-style: none; outline: none; border-radius: 4px;">
                  <div class="is-flex is-justify-content-space-between is-align-items-center">
                    <h5 class="title is-5 mb-0"><i class="fas fa-align-left mr-2 has-text-primary"></i> Course Description</h5>
                    <span class="icon is-small has-text-grey">
                      <i class="fas fa-chevron-right"></i>
                    </span>
                  </div>
                </summary>
                <div class="content p-4 has-background-white border-light">
                  ${overview.description_html}
                </div>
              </details>
            </div>
          ` : ''}

          <!-- Upcoming Assignments -->
          ${renderUpcoming(upcoming_assignments)}

          <!-- Syllabus Items Found -->
          ${renderSyllabusItems(syllabus_info)}
        </div>
      </div>
    `;

    root.innerHTML = html;
  }

  function renderSettings(course) {
    return `
      <div class="notification is-light py-3 px-4 mb-5" style="border: 1px solid #eee; background: #fafafa;">
        <p class="is-size-7 uppercase has-text-weight-bold has-text-grey mb-3" style="text-transform: uppercase; letter-spacing: 0.5px;">
          <i class="fas fa-cog mr-1"></i> Course Settings
        </p>
        <div class="columns is-multiline is-mobile">
          <div class="column is-6-mobile is-3-tablet">
            <form action="/course/${COURSE_ID}/update_units" method="post">
              <label class="label is-size-7 mb-1">Units (Credits)</label>
              <div class="field has-addons">
                <div class="control is-expanded">
                  <input class="input is-small" type="number" name="units" value="${course.units || 3}">
                </div>
                <div class="control">
                  <button type="submit" class="button is-small is-primary">Save</button>
                </div>
              </div>
            </form>
          </div>

          <div class="column is-6-mobile is-3-tablet">
            <form action="/course/${COURSE_ID}/update_target_grade" method="post">
              <label class="label is-size-7 mb-1">Target Grade (%)</label>
              <div class="field has-addons">
                <div class="control is-expanded">
                  <input class="input is-small" type="number" step="0.1" name="target_grade" value="${course.target_grade || 93.0}">
                </div>
                <div class="control">
                  <button type="submit" class="button is-small is-info">Apply</button>
                </div>
              </div>
            </form>
          </div>

          <div class="column is-6-mobile is-3-tablet">
            <form action="/course/${COURSE_ID}/update_end_of_week" method="post">
              <label class="label is-size-7 mb-1">End of Week</label>
              <div class="field has-addons">
                <div class="control is-expanded">
                  <div class="select is-small is-fullwidth">
                    <select name="end_of_week_day">
                      ${["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"].map((day, i) => `
                        <option value="${i}" ${course.end_of_week_day === i ? 'selected' : ''}>${day}</option>
                      `).join('')}
                    </select>
                  </div>
                </div>
                <div class="control">
                  <button type="submit" class="button is-small is-success">Set</button>
                </div>
              </div>
            </form>
          </div>

          <div class="column is-6-mobile is-3-tablet">
            <form action="/course/${COURSE_ID}/update_color" method="post">
              <label class="label is-size-7 mb-1">Custom Color</label>
              <div class="field has-addons">
                <div class="control is-expanded">
                  <input class="input is-small p-0" type="color" name="custom_color" value="${course.custom_color || '#739AC3'}" style="height: 27px; width: 100%;">
                </div>
                <div class="control">
                  <button type="submit" class="button is-small is-link">Update</button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    `;
  }

  function renderUpcoming(assignments) {
    if (!assignments || assignments.length === 0) return '';
    return `
      <div class="mb-5">
        <details class="section-details" open>
          <summary class="is-clickable p-2 has-background-warning-light" style="list-style: none; outline: none; border-radius: 4px; border: 1px solid #ffe8cc;">
            <div class="is-flex is-justify-content-space-between is-align-items-center">
              <h5 class="title is-5 mb-0"><i class="fas fa-calendar-day mr-2 has-text-warning-dark"></i> Upcoming Assignments (Next 7 Days)</h5>
              <span class="icon is-small has-text-warning-dark">
                <i class="fas fa-chevron-right"></i>
              </span>
            </div>
          </summary>
          <div class="p-4 has-background-white border-light">
            ${assignments.map(a => `
              <div class="box p-3 mb-2" style="background: rgba(255,255,255,0.5); border: 1px solid rgba(0,0,0,0.05); overflow: hidden;">
                <div class="is-flex is-justify-content-space-between is-align-items-center" style="gap: 15px;">
                  <div class="is-flex is-align-items-center" style="flex: 1; min-width: 0;">
                    <div class="control mr-3">
                      <input type="checkbox" class="assignment-checkbox" data-id="${a.id}" onchange="toggleAssignmentInline(this)">
                    </div>
                    <div style="flex: 1; min-width: 0; word-wrap: break-word; overflow-wrap: break-word;">
                      <strong class="is-size-6">${a.name_html || a.name}</strong>
                    </div>
                  </div>
                  <div class="has-text-right" style="flex-shrink: 0;">
                    <p class="has-text-danger is-size-7 mb-1">
                      Due: ${new Date(a.due_date).toLocaleString()}
                    </p>
                    <div class="buttons is-right">
                      <button type="button" class="button is-small is-link is-light" onclick="showAssignmentDetail('${a.brightspace_id}')">View Details</button>
                    </div>
                  </div>
                </div>
              </div>
            `).join('')}
          </div>
        </details>
      </div>
    `;
  }

  function renderSyllabusItems(syllabus) {
    if (!syllabus || (!syllabus.modules.length && !syllabus.topics.length)) return '';
    
    let html = `
      <div class="mt-5">
        <h5 class="title is-5"><span class="icon has-text-primary mr-2"><i class="fas fa-search"></i></span> Items Found in Content</h5>
    `;

    // Render Modules
    html += syllabus.modules.map(mod => `
      <div class="box is-light mb-3">
        <div class="is-flex is-justify-content-space-between is-align-items-center">
          <div>
            <span class="tag is-info is-light mr-2">Module</span>
            <span class="has-text-weight-bold">${mod.Title}</span>
          </div>
          <a href="/course/${COURSE_ID}/module/${mod.ModuleId}" class="button is-small is-primary is-outlined">View Module</a>
        </div>
      </div>
    `).join('');

    // Render Topics
    html += syllabus.topics.map(topic => {
      const type = topic.Type;
      // Topic types: 1 = Document/HTML, 2 = File, 3 = Link
      let icon = 'fa-file-alt';
      if (type === 3 || type === 'Link') icon = 'fa-link';
      if (topic.Url && topic.Url.toLowerCase().endsWith('.pdf')) icon = 'fa-file-pdf';

      return `
        <div class="box is-light mb-3">
          <div class="is-flex is-justify-content-space-between is-align-items-center">
            <div>
              <span class="tag is-success is-light mr-2">Topic</span>
              <span class="has-text-weight-bold"><i class="fas ${icon} mr-2"></i> ${topic.Title}</span>
            </div>
            <div class="buttons">
              <button type="button" class="button is-small is-info is-light" onclick="showTopicDetail('${topic.Id || topic.TopicId}', '${topic.Title}')">View Details</button>
              <a href="/course/${COURSE_ID}/download?path=${encodeURIComponent(topic.Url)}&name=${encodeURIComponent(topic.Title)}" class="button is-small is-link is-light ${topic.Url ? '' : 'is-hidden'}">
                <i class="fas fa-download"></i>
              </a>
            </div>
          </div>
        </div>
      `;
    }).join('');

    html += `</div>`;
    return html;
  }

  document.addEventListener('DOMContentLoaded', () => loadCourse());

  window.addEventListener('brilliant:course_overview_updated', (e) => {
    const { course_id } = e.detail;
    if (course_id == COURSE_ID) {
      const root = document.getElementById('course-root');
      if (root.querySelector('.fa-circle-notch')) {
        console.log("[SSE] Initial load detected, allowing override...");
        loadCourse();
      } else {
        console.log("[SSE] Data updated in background, skipping re-render to preserve accordion state.");
      }
    }
  });
</script>

<style>
  .section-details summary::-webkit-details-marker { display: none; }
  .section-details[open] summary .fa-chevron-right { transform: rotate(90deg); }
  .section-details summary .fa-chevron-right { transition: transform 0.2s ease-in-out; }
  .border-light { border: 1px solid #eee; border-top: none; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; }
</style>

<!-- PDF Viewer Modal -->
<div id="pdfModal" class="modal">
  <div class="modal-background" onclick="closePdfModal()"></div>
  <div class="modal-card" style="width: 90%; max-width: 1000px; height: 90vh;">
    <header class="modal-card-head">
      <p class="modal-card-title" id="pdfModalTitle">PDF Viewer</p>
      <button class="delete" aria-label="close" onclick="closePdfModal()"></button>
    </header>
    <section class="modal-card-body p-0" style="overflow: hidden;">
      <iframe id="pdfFrame" src="" style="width: 100%; height: 100%; border: none;"></iframe>
    </section>
    <footer class="modal-card-foot is-justify-content-flex-end">
      <a id="pdfDownloadBtn" href="#" class="button is-link" target="_blank">
        <i class="fas fa-download mr-1"></i> Download
      </a>
      <button class="button" onclick="closePdfModal()">Close</button>
    </footer>
  </div>
</div>

<!-- Simple Detail Modal -->
<div id="detailModal" class="modal">
  <div class="modal-background" onclick="closeDetailModal()"></div>
  <div class="modal-card">
    <header class="modal-card-head">
      <p class="modal-card-title" id="detailModalTitle">Task Details</p>
      <button class="delete" aria-label="close" onclick="closeDetailModal()"></button>
    </header>
    <section class="modal-card-body">
      <div id="detailModalContent">
        <div class="has-text-centered p-6">
          <span class="icon is-large has-text-grey-light"><i class="fas fa-circle-notch fa-spin fa-2x"></i></span>
        </div>
      </div>
    </section>
    <footer class="modal-card-foot is-justify-content-flex-end">
      <button class="button" onclick="closeDetailModal()">Close</button>
    </footer>
  </div>
</div>

<script>
  async function showAssignmentDetail(id) {
    const modal = document.getElementById('detailModal');
    const content = document.getElementById('detailModalContent');
    const titleEl = document.getElementById('detailModalTitle');
    
    titleEl.innerText = "Task Details";
    content.innerHTML = '<div class="has-text-centered p-6"><span class="icon is-large has-text-grey-light"><i class="fas fa-circle-notch fa-spin fa-2x"></i></span></div>';
    
    modal.classList.add('is-active');
    document.documentElement.classList.add('is-clipped');

    try {
      const response = await fetch(`/api/v1/item_details?type=assignment&id=${id}&course_id=${COURSE_ID}`);
      const data = await response.json();
      content.innerHTML = data.html || "<p class='has-text-grey italic'>No details found.</p>";
    } catch (err) {
      content.innerHTML = "<div class='notification is-danger'>Failed to load data.</div>";
    }
  }

function closeDetailModal() {
  const modal = document.getElementById('detailModal');
  modal.classList.remove('is-active');
  document.documentElement.classList.remove('is-clipped');
}

async function showTopicDetail(id, title) {
  const modal = document.getElementById('detailModal');
  const content = document.getElementById('detailModalContent');
  const titleEl = document.getElementById('detailModalTitle');
  
  titleEl.innerText = title;
  content.innerHTML = '<div class="has-text-centered p-6"><span class="icon is-large has-text-grey-light"><i class="fas fa-circle-notch fa-spin fa-2x"></i></span></div>';
  
  modal.classList.add('is-active');
  document.documentElement.classList.add('is-clipped');

  try {
    const response = await fetch(`/api/v1/item_details?type=topic&id=${id}&course_id=${COURSE_ID}`);
    const data = await response.json();
    content.innerHTML = data.html || "<p class='has-text-grey italic'>No details found.</p>";
  } catch (err) {
    content.innerHTML = "<div class='notification is-danger'>Failed to load data.</div>";
  }
}

function openPdfViewer(viewUrl, downloadUrl, title) {
  const modal = document.getElementById('pdfModal');
  const frame = document.getElementById('pdfFrame');
  const titleEl = document.getElementById('pdfModalTitle');
  const downloadBtn = document.getElementById('pdfDownloadBtn');
  
  titleEl.innerText = title;
  downloadBtn.href = downloadUrl;
  frame.src = viewUrl;
  
  modal.classList.add('is-active');
  document.documentElement.classList.add('is-clipped');
}

function closePdfModal() {
  const modal = document.getElementById('pdfModal');
  const frame = document.getElementById('pdfFrame');
  
  modal.classList.remove('is-active');
  document.documentElement.classList.remove('is-clipped');
  frame.src = ""; 
}

function toggleAssignmentInline(checkbox) {
  const id = checkbox.getAttribute('data-id');
  const box = checkbox.closest('.box');
  
  fetch(`/assignments/${id}/toggle_complete`, {
    method: 'POST',
    headers: { 'X-Requested-With': 'XMLHttpRequest' }
  })
  .then(response => response.json())
  .then(data => {
    if (data.status === 'ok' && data.completed) {
      box.style.opacity = '0.5';
      setTimeout(() => { box.style.display = 'none'; }, 800);
    }
  });
}
</script>
