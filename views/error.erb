<div class="columns">
  <% if @course_id && @toc %>
    <div class="column is-3">
      <%= erb :'partials/sidebar' %>
    </div>
  <% end %>

  <div class="column <%= (@course_id && @toc) ? 'is-9' : 'is-12' %>">
    <% if @course_id %>
      <%= erb :'partials/course_detail_header' rescue nil %>
    <% end %>

<div class="section">
    <div class="columns <%= 'is-centered' unless @course_id %>">
      <div class="column <%= @course_id ? 'is-12' : 'is-8' %>">
        <div class="box has-background-white <%= 'p-6' unless @course_id %>" style="border-top: 5px solid #ff3860;">
          <div class="has-text-centered mb-5">
            <span class="icon is-large has-text-danger">
              <i class="fas fa-exclamation-triangle fa-3x"></i>
            </span>
            <h2 class="title is-3 mt-4"><%= @error_title || "Something went wrong" %></h2>
            <p class="subtitle is-6 has-text-grey"><%= @error_message || "Detailed error information below" %></p>
          </div>

          <% if @error %>
            <div class="message is-danger">
              <div class="message-header">
                <p><%= @error.class %></p>
              </div>
              <div class="message-body is-family-monospace is-size-7" style="max-height: 200px; overflow-y: auto;">
                <%= @error.message %>
                <hr>
                <%= @error.backtrace.join("\n") if @error.respond_to?(:backtrace) && @error.backtrace %>
              </div>
            </div>
          <% end %>

          <div class="buttons is-centered mt-6">
            <a href="javascript:history.back()" class="button is-dark is-medium">
              <span class="icon">
                <i class="fas fa-arrow-left"></i>
              </span>
              <span>Go Back</span>
            </a>
            <a href="/dashboard" class="button is-primary is-medium">
              <span class="icon">
                <i class="fas fa-home"></i>
              </span>
              <span>Return Dashboard</span>
            </a>
            <button onclick="window.location.reload()" class="button is-light is-medium">
              <span class="icon">
                <i class="fas fa-sync"></i>
              </span>
              <span>Retry</span>
            </button>
          </div>

          <p class="has-text-centered is-size-7 has-text-grey-light mt-4">
            If this keeps happening, try clearing the app cache in settings.
          </p>
        </div>
      </div>
    </div>
</div>
  </div>
</div>
