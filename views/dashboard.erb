<div class="columns">
  <div class="column is-8">
    <div id="sync-indicator" class="box mb-4" style="display: <%= @sync_status[:status] == 'syncing' ? 'block' : 'none' %>;">
      <div class="level is-mobile mb-2">
        <div class="level-left">
          <p class="is-size-7 has-text-weight-bold">
            <i class="fas fa-sync fa-spin mr-2"></i> 
            <span id="sync-task"><%= @sync_status[:current_task] %></span>
          </p>
        </div>
        <div class="level-right">
          <span id="sync-percent" class="is-size-7"><%= @sync_status[:progress] %>%</span>
        </div>
      </div>
      <progress id="sync-progress" class="progress is-small is-primary" value="<%= @sync_status[:progress] %>" max="100"><%= @sync_status[:progress] %>%</progress>
    </div>

    <% if @current_semester && @overall_gpa %>
      <div class="box has-background-primary-light mb-6 p-5" style="border-radius: 12px; border: 1px solid #739AC3;">
         <div class="is-flex is-justify-content-space-between is-align-items-center is-flex-wrap-wrap">
           <div class="mb-2" style="flex-grow: 1;">
              <h2 class="title is-3 mb-1" style="margin-bottom: 0.5rem !important;"><i class="fas fa-graduation-cap mr-2"></i> Semester Overview</h2>
              <div class="has-text-grey-dark is-uppercase has-text-weight-bold" style="letter-spacing: 1px; font-size: 0.9rem;">
                <%= @current_semester %>
              </div>
           </div>
           <div class="has-text-centered py-2 px-4" style="border-left: 2px solid rgba(115, 154, 195, 0.2); min-width: 140px;">
              <p class="heading mb-1" style="letter-spacing: 1px; color: #666;">Points Earned</p>
              <p class="title is-4 has-text-grey-darker" style="margin-bottom: 0;">
                <%= @semester_grades.sum { |sg| sg[:stats][:total_points_earned] }.round(1) %> 
                <span class="is-size-6 has-text-weight-normal has-text-grey">/ <%= @semester_grades.sum { |sg| sg[:stats][:total_points_possible] }.round(1) %></span>
              </p>
           </div>
           <div class="has-text-centered py-2 px-4" style="border-left: 2px solid rgba(115, 154, 195, 0.2); min-width: 140px;">
              <p class="heading mb-1" style="letter-spacing: 1px;">Overall GPA</p>
              <p class="title is-1 has-text-primary" style="margin-bottom: 0; line-height: 1;"><%= '%.2f' % @overall_gpa %></p>
              <% if @max_potential_gpa && @max_potential_gpa > @overall_gpa %>
                <p class="is-size-7 has-text-grey mt-1">Max Potential: <span class="has-text-weight-bold"><%= '%.2f' % @max_potential_gpa %></span></p>
              <% end %>
           </div>
         </div>
         
         <div class="columns is-multiline mt-4">
           <% @semester_grades.each do |sg| %>
             <% info = extract_course_info(sg[:course].name) %>
             <div class="column is-4">
               <div class="box is-clickable p-0 has-background-white overflow-hidden" 
                    onclick="window.location='/course/<%= sg[:course].org_unit_id %>/grades'"
                    style="border: 1px solid #eee; transition: all 0.2s; height: 100%; border-radius: 8px; overflow: hidden;">
                 
                 <% if sg[:course].banner_url %>
                   <div style="height: 100px; width: 100%; background: url('/api/proxy/banner?url=<%= ERB::Util.url_encode(sg[:course].banner_url) %>') center center; background-size: cover; border-bottom: 1px solid #eee;"></div>
                 <% else %>
                   <div style="height: 100px; width: 100%; background: linear-gradient(135deg, #739AC3 0%, #3273dc 100%); border-bottom: 1px solid #eee; opacity: 0.1;"></div>
                 <% end %>

                 <div class="p-3">
                   <div class="level is-mobile mb-1">
                     <div class="level-left">
                       <p class="is-size-7 has-text-grey-light"><%= sg[:course].code %></p>
                     </div>
                     <div class="level-right">
                       <span class="tag is-white is-paddingless has-text-grey-light" title="Confidence: <%= sg[:stats][:confidence] %>%">
                         <i class="fas fa-shield-halved mr-1 <%= confidence_color(sg[:stats][:confidence]) %>"></i> <%= sg[:stats][:confidence].to_i %>%
                       </span>
                     </div>
                   </div>
                   <p class="has-text-weight-bold is-size-6 mb-2" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= info[:course_display] %>"><%= info[:course_display] %></p>
                   <div class="level is-mobile">
                     <div class="level-left">
                        <span class="tag <%= grade_color(sg[:stats][:score]) %> is-light has-text-weight-bold">
                          <%= sg[:stats][:score] %>%
                        </span>
                     </div>
                   </div>
                   <div class="mt-2 pt-2" style="border-top: 1px dashed #eee;">
                     <p class="is-size-7 has-text-grey">
                       <span class="has-text-weight-bold has-text-grey-dark"><%= sg[:stats][:remaining_points].to_i %></span> pts remaining
                       <span class="is-pulled-right">Max: <%= sg[:stats][:max_potential_score].to_i %>%</span>
                     </p>
                   </div>
                 </div>
               </div>
             </div>
           <% end %>
         </div>
      </div>
    <% end %>

    <div class="level mb-4">
      <div class="level-left">
        <h1 class="title"><i class="fas fa-book-open mr-2"></i> My Course List</h1>
      </div>
      <div class="level-right">
        <div class="field has-addons">
          <p class="control">
            <span class="button is-static is-small">Semester</span>
          </p>
          <div class="control">
            <div class="select is-small">
              <select onchange="window.location.href='?semester=' + this.value">
                <option value="all" <%= @semester_filter == 'all' ? 'selected' : '' %>>All Semesters</option>
                <% @all_semesters.each do |sem| %>
                  <option value="<%= sem %>" <%= @semester_filter == sem ? 'selected' : '' %>>
                    <%= sem %>
                  </option>
                <% end %>
              </select>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% if @display_courses.empty? %>
      <div class="notification is-warning">No courses found matching this filter.</div>
    <% else %>
      <div class="columns is-multiline">
        <% @display_courses.each do |c| %>
          <%
             id   = c.is_a?(Hash) ? c['OrgUnit']['Id'] : c.org_unit_id
             name = c.is_a?(Hash) ? c['OrgUnit']['Name'] : c.name
             code = c.is_a?(Hash) ? c['OrgUnit']['Code'] : c.code
             banner = c.respond_to?(:banner_url) ? c.banner_url : nil
             info = extract_course_info(name)
          %>
          <div class="column is-6">
            <div class="box p-0 course-card-wide is-clickable" 
                 onclick="window.location='/course/<%= id %>'"
                 style="overflow: hidden; border: 1px solid #eee; transition: all 0.2s; height: 100%;">
              <div class="is-flex" style="height: 100%;">
                <div style="width: 140px; min-width: 140px; transition: width 0.3s; background-color: #f5f5f5;">
                  <% if banner %>
                    <div style="height: 100%; width: 100%; background: url('/api/proxy/banner?url=<%= ERB::Util.url_encode(banner) %>') center center; background-size: cover; box-shadow: inset -10px 0 15px rgba(0,0,0,0.1);"></div>
                  <% else %>
                    <div style="height: 100%; width: 100%; background: linear-gradient(135deg, #739AC3 0%, #3273dc 100%); opacity: 0.1;"></div>
                  <% end %>
                </div>
                <div class="p-4" style="flex-grow: 1;">
                  <div class="tags mb-1">
                    <% if info[:semester] %>
                      <span class="tag is-info is-light is-small"><%= info[:semester] %></span>
                    <% end %>
                    <% if info[:is_online] %>
                      <span class="tag is-success is-light is-small">Online</span>
                    <% end %>
                  </div>
                  
                  <h3 class="title is-5 mb-1"><%= info[:course_display] %></h3>
                  <p class="is-size-7 has-text-grey-light mb-3"><%= code %></p>
                  
                  <div class="has-text-right">
                    <span class="is-size-7 has-text-link">Open Course <i class="fas fa-chevron-right ml-1"></i></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="column is-4">
    <h2 class="title is-4"><i class="fas fa-bullhorn mr-2"></i> Recent Updates</h2>
    <% if @recent_notifications && !@recent_notifications.empty? %>
      <% @recent_notifications.each do |n| %>
        <div class="box mb-4 notification-card-small" onclick="window.location='<%= n.url %>'" style="cursor:pointer; border-left: 4px solid <%= n.urgency == 3 ? '#ff3860' : (n.urgency == 2 ? '#ffdd57' : '#3273dc') %>;">
          <p class="is-size-7 has-text-primary has-text-weight-bold mb-1">
            <%= n.course_name ? extract_course_info(n.course_name)[:course_display] : "General" %>
          </p>
          <h6 class="title is-6 mb-2"><%= n.title %></h6>
          <div class="content is-size-7 mb-2">
            <%= n.body ? truncate_text(n.body.gsub(/<[^>]*>/, '').strip, 80) : "No description" %>
          </div>
          <div class="level is-mobile">
            <div class="level-left">
              <span class="is-size-7 has-text-grey">
                <%= format_date(n.date, "%b %d") rescue "Recently" %>
              </span>
              <span class="tag is-small is-rounded ml-2 is-light">
                <%= n.notification_type %>
              </span>
            </div>
            <div class="level-right">
              <a href="<%= n.url %>" class="button is-small is-white has-text-link">View</a>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="has-text-grey italic">No recent updates found.</p>
    <% end %>
    <div class="mt-4 has-text-centered">
      <a href="/notifications" class="button is-small is-fullwidth is-light">
        View All Notifications <i class="fas fa-arrow-right ml-2"></i>
      </a>
    </div>
  </div>
</div>

<style>
.notification-card-small {
  transition: transform 0.1s;
}
.notification-card-small:hover {
  transform: translateX(3px);
  background-color: #f9f9f9;
}
.box.is-clickable:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(115, 154, 195, 0.15);
  border-color: #739AC3 !important;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const indicator = document.getElementById('sync-indicator');
  const taskText = document.getElementById('sync-task');
  const percentText = document.getElementById('sync-percent');
  const progressBar = document.getElementById('sync-progress');

  function checkSyncStatus() {
    fetch('/sync/status')
      .then(response => response.json())
      .then(data => {
        if (data.status === 'syncing') {
          indicator.style.display = 'block';
          taskText.innerText = data.current_task;
          percentText.innerText = data.progress + '%';
          progressBar.value = data.progress;
          setTimeout(checkSyncStatus, 2000); // Check every 2s
        } else if (data.status === 'completed') {
          taskText.innerText = "Sync complete!";
          percentText.innerText = '100%';
          progressBar.value = 100;
          setTimeout(() => { indicator.style.display = 'none'; }, 3000);
        } else {
          indicator.style.display = 'none';
        }
      })
      .catch(err => console.error("Sync check error:", err));
  }

  // Initial trigger if dashboard shows it is active
  if (indicator.style.display !== 'none') {
    checkSyncStatus();
  }
});
</script>
