<div id="dashboard-root">
  <div class="is-flex is-justify-content-center is-align-items-center" style="min-height: 400px;">
    <div class="has-text-centered">
      <span class="icon is-large has-text-primary mb-4">
        <i class="fas fa-circle-notch fa-spin fa-3x"></i>
      </span>
      <p class="is-size-5 has-text-grey">Initializing Dashboard...</p>
    </div>
  </div>
</div>

<script>
  // Helper: Grade Colors
  function getGradeColor(score) {
    if (score >= 90) return 'is-success';
    if (score >= 80) return 'is-info';
    if (score >= 70) return 'is-warning';
    return 'is-danger';
  }

  // Helper: Confidence Colors
  function getConfidenceColor(confidence) {
    if (confidence >= 80) return 'has-text-success';
    if (confidence >= 50) return 'has-text-info';
    return 'has-text-warning';
  }

  // Helper: Course Pill Style
  function getCoursePillStyle(name) {
    const hash = name.split('').reduce((acc, char) => char.charCodeAt(0) + ((acc << 5) - acc), 0);
    const color = `hsl(${Math.abs(hash % 360)}, 60%, 45%)`;
    return `background-color: ${color}; color: white;`;
  }

  // Helper: Format Date
  function formatDate(dateStr, format = 'short') {
    if (!dateStr) return 'Recently';
    const date = new Date(dateStr);
    if (isNaN(date.getTime())) return 'Recently';

    if (format === 'short') {
      return date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
    }
    return date.toLocaleDateString(undefined, { 
      weekday: 'long', 
      month: 'short', 
      day: 'numeric', 
      hour: 'numeric', 
      minute: '2-digit' 
    });
  }

  async function loadDashboard(overviewSemester = null) {
    const root = document.getElementById('dashboard-root');
    let url = '/api/v1/dashboard/summary';
    if (overviewSemester) {
      url += `?overview_semester=${encodeURIComponent(overviewSemester)}`;
    }

    try {
      const response = await fetch(url);
      const data = await response.json();
      renderDashboard(data);
    } catch (err) {
      console.error("Failed to load dashboard:", err);
      root.innerHTML = `
        <div class="notification is-danger mt-4">
          <h3 class="title is-5">Error Connection Lost</h3>
          <p>Failed to load dashboard data. Please ensure the backend is running.</p>
          <button class="button is-white is-small mt-2" onclick="location.reload()">Retry</button>
        </div>
      `;
    }
  }

  function renderDashboard(data) {
    const root = document.getElementById('dashboard-root');
    const hasSidebar = data.show_upcoming_assignments || data.show_recent_updates;
    
    let html = "";
    
    if (hasSidebar) {
      html = `
        <div class="columns">
          <div class="column is-8">
            <!-- Semester Overview -->
            ${data.semester ? renderSemesterOverview(data) : ''}

            <!-- Course List -->
            ${data.show_course_list ? renderCourseList(data) : ''}
          </div>

          <div class="column is-4">
            <!-- Upcoming Assignments -->
            ${data.show_upcoming_assignments ? renderUpcomingAssignments(data) : ''}

            <!-- Recent Updates -->
            ${data.show_recent_updates ? renderRecentUpdates(data) : ''}
          </div>
        </div>
      `;
    } else {
      html = `
        <div class="columns is-centered">
          <div class="column is-10-desktop is-12-tablet">
            <!-- Semester Overview -->
            ${data.semester ? renderSemesterOverview(data) : ''}

            <!-- Course List -->
            ${data.show_course_list ? renderCourseList(data) : ''}
          </div>
        </div>
      `;
    }

    root.innerHTML = html;
  }

  function renderSemesterOverview(data) {
    const semGrades = data.semester_grades || [];
    
    return `
      <div class="box has-background-primary-light mb-6 p-5" style="border-radius: 12px; border: 1px solid #739AC3;">
         <div class="is-flex is-justify-content-space-between is-align-items-center is-flex-wrap-wrap">
           <div class="mb-2" style="flex-grow: 1;">
              <h2 class="title is-3 mb-1" style="margin-bottom: 0.5rem !important;"><i class="fas fa-graduation-cap mr-2"></i> Semester Overview</h2>
              <div class="control has-icons-left">
                <div class="select is-small is-ghost">
                  <select onchange="loadDashboard(this.value)" style="background: transparent; border: none; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; color: #4a4a4a; padding-left: 0; outline: none; cursor: pointer;">
                    ${data.all_semesters.reverse().map(sem => `
                      <option value="${sem}" ${sem === data.semester ? 'selected' : ''}>${sem}</option>
                    `).join('')}
                  </select>
                </div>
              </div>
           </div>
           <div class="has-text-centered py-2 px-4" style="border-left: 2px solid rgba(115, 154, 195, 0.2); min-width: 140px;">
              <p class="heading mb-1" style="letter-spacing: 1px; color: #666;">Points Earned</p>
              <p class="title is-4 has-text-grey-darker" style="margin-bottom: 0;">
                ${data.cumulative_points_earned.toFixed(1)} 
                <span class="is-size-6 has-text-weight-normal has-text-grey">/ ${data.cumulative_points_possible.toFixed(1)}</span>
              </p>
           </div>
           <div class="has-text-centered py-2 px-4" style="border-left: 2px solid rgba(115, 154, 195, 0.2); min-width: 140px;">
              <p class="heading mb-1" style="letter-spacing: 1px;">Overall GPA</p>
              <p class="title is-1 has-text-primary" style="margin-bottom: 0; line-height: 1;">${data.overall_gpa.toFixed(2)}</p>
              ${data.max_potential_gpa > data.overall_gpa ? `
                <p class="is-size-7 has-text-grey mt-1">Max Potential: <span class="has-text-weight-bold">${data.max_potential_gpa.toFixed(2)}</span></p>
              ` : ''}
           </div>
         </div>
         
         <div class="columns is-multiline mt-4">
           ${semGrades.map(sg => `
             <div class="column is-4">
               <div class="box is-clickable p-0 has-background-white overflow-hidden" 
                    onclick="window.location='/course/${sg.org_unit_id}'"
                    style="border: 1px solid #eee; transition: all 0.2s; height: 100%; border-radius: 8px; overflow: hidden;">
                 
                 ${sg.banner_url ? `
                   <div style="height: 80px; width: 100%; background: url('/api/proxy/banner?url=${encodeURIComponent(sg.banner_url)}') center center; background-size: cover; border-bottom: 1px solid #eee;"></div>
                 ` : `
                   <div style="height: 80px; width: 100%; background: linear-gradient(135deg, #739AC3 0%, #3273dc 100%); border-bottom: 1px solid #eee; opacity: 0.1;"></div>
                 `}

                 <div class="p-3">
                   <div class="level is-mobile mb-1">
                     <div class="level-left">
                       <p class="is-size-7 has-text-grey-light">${sg.code || ''}</p>
                     </div>
                     <div class="level-right">
                       <span class="tag is-white is-paddingless has-text-grey-light" title="Confidence: ${sg.stats.confidence}%">
                         <i class="fas fa-shield-halved mr-1 ${getConfidenceColor(sg.stats.confidence)}"></i> ${Math.round(sg.stats.confidence)}%
                       </span>
                     </div>
                   </div>
                   <div class="mb-2">
                     <p class="has-text-weight-bold is-size-6 mb-1" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${sg.name}">${sg.short_name || sg.name}</p>
                     ${sg.prefix ? `<div><span class="px-1" style="border-radius: 3px; font-size: 0.7rem; font-weight: bold; ${sg.pill_style || getCoursePillStyle(sg.name)}">${sg.prefix}</span></div>` : ''}
                   </div>
                   <div class="level is-mobile">
                     <div class="level-left">
                        <span class="tag ${getGradeColor(sg.stats.score)} is-light has-text-weight-bold">
                          ${sg.stats.score}%
                        </span>
                     </div>
                   </div>
                   <div class="mt-2 pt-2" style="border-top: 1px dashed #eee;">
                     <p class="is-size-7 has-text-grey">
                       <span class="has-text-weight-bold has-text-grey-dark">${Math.round(sg.stats.remaining_points)}</span> pts remaining
                       <span class="is-pulled-right">Max: ${Math.round(sg.stats.max_potential_score)}%</span>
                     </p>
                   </div>
                 </div>
               </div>
             </div>
           `).join('')}
         </div>
      </div>
    `;
  }

  function renderCourseList(data) {
    // Basic filter implementation locally
    const filter = new URLSearchParams(window.location.search).get('semester') || data.semester || 'all';
    const courses = filter === 'all' ? data.courses : data.courses.filter(c => c.semester === filter);

    return `
      <div class="level mb-4">
        <div class="level-left">
          <h1 class="title"><i class="fas fa-book-open mr-2"></i> My Course List</h1>
        </div>
        <div class="level-right">
          <div class="field has-addons">
            <p class="control">
              <span class="button is-static is-small">Semester</span>
            </p>
            <div class="control">
              <div class="select is-small">
                <select onchange="const url = new URL(window.location); url.searchParams.set('semester', this.value); window.history.pushState({}, '', url); loadDashboard('${data.semester}')">
                  <option value="all" ${filter === 'all' ? 'selected' : ''}>All Semesters</option>
                  ${data.all_semesters.map(sem => `
                    <option value="${sem}" ${filter === sem ? 'selected' : ''}>${sem}</option>
                  `).join('')}
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>

      ${courses.length === 0 ? `
        <div class="notification is-warning">No courses found matching this filter.</div>
      ` : `
        <div class="columns is-multiline">
          ${courses.map(c => `
            <div class="column is-6">
              <div class="box p-0 course-card-wide is-clickable" 
                   onclick="window.location='/course/${c.org_unit_id}'"
                   style="overflow: hidden; border: 1px solid #eee; transition: all 0.2s; height: 100%;">
                <div class="is-flex" style="height: 100%;">
                  <div style="width: 120px; min-width: 120px; background-color: #f5f5f5;">
                    ${c.banner_url ? `
                      <div style="height: 100%; width: 100%; background: url('/api/proxy/banner?url=${encodeURIComponent(c.banner_url)}') center center; background-size: cover; box-shadow: inset -5px 0 10px rgba(0,0,0,0.05);"></div>
                    ` : `
                      <div style="height: 100%; width: 100%; background: linear-gradient(135deg, #739AC3 0%, #3273dc 100%); opacity: 0.1;"></div>
                    `}
                  </div>
                  <div class="p-4" style="flex-grow: 1;">
                    ${c.is_pinned ? `<div class="is-pulled-right"><span class="tag is-warning is-light is-small"><i class="fas fa-thumbtack"></i></span></div>` : ''}
                    
                    <div class="mb-2">
                      <h3 class="title is-6 mb-1" style="line-height: 1.2;">${c.short_name || c.name}</h3>
                      ${c.prefix ? `<div><span class="px-1" style="border-radius: 3px; font-size: 0.7rem; font-weight: bold; ${c.pill_style || getCoursePillStyle(c.name)}">${c.prefix}</span></div>` : ''}
                    </div>
                    <div class="tags mb-1">
                      ${c.semester ? `<span class="tag is-white is-small has-text-grey" style="font-size: 0.65rem; padding-left: 0;">${c.semester}</span>` : ''}
                    </div>
                    <div class="my-3"></div>
                    <div class="has-text-right">
                      <span class="is-size-7 has-text-link">Open <i class="fas fa-chevron-right ml-1"></i></span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          `).join('')}
        </div>
      `}
    `;
  }

  function renderUpcomingAssignments(data) {
    if (!data.upcoming_assignments || data.upcoming_assignments.length === 0) return '';

    return `
      <h2 class="title is-4"><i class="fas fa-calendar-check mr-2"></i> Upcoming Assignments</h2>
      ${data.upcoming_assignments.map(a => `
        <div class="box mb-4 ${a.optional ? 'has-background-white-bis' : 'has-background-warning-light'} p-4" 
             onclick="window.location='/course/${a.course_id}/assignments/${a.brightspace_id}'" 
             style="cursor:pointer; border: 1px solid ${a.optional ? '#dbdbdb' : '#ffdd57'}; position: relative; ${a.optional ? 'border-left: 4px solid #dbdbdb;' : ''}">
          <div class="columns is-mobile is-vcentered">
            <div class="column is-narrow">
              <div class="control" onclick="event.stopPropagation()">
                <label class="checkbox">
                  <input type="checkbox" class="assignment-checkbox" data-id="${a.id}" onchange="toggleAssignment(this)">
                </label>
              </div>
            </div>
            <div class="column">
              <div class="is-flex is-justify-content-space-between is-align-items-start">
                <div>
                  <div class="is-flex is-align-items-center mb-1">
                    ${a.course_prefix ? `<span class="px-1 mr-2" style="border-radius: 3px; font-size: 0.65rem; font-weight: bold; ${a.pill_style || getCoursePillStyle(a.course_name)}">${a.course_prefix}</span>` : ''}
                    <span class="is-size-7 has-text-grey-dark" style="font-weight: 600;">${a.course_short_name || a.course_name || 'Unknown Course'}</span>
                    ${a.semester ? `<span class="tag is-white is-small has-text-grey" style="font-size: 0.65rem;">${a.semester}</span>` : ''}
                  </div>
                  <h6 class="title is-6 mb-0">${a.name_html || a.name}</h6>
                </div>
                ${a.optional ? '<span class="tag is-light is-small"><i class="fas fa-hand-paper mr-1"></i> Optional</span>' : ''}
              </div>
              <p class="is-size-7 has-text-danger mb-0" onclick="event.stopPropagation()">
                Due: <span>${formatDate(a.due_date, 'long')}</span>
              </p>
            </div>
          </div>
        </div>
      `).join('')}
      <hr>
    `;
  }

  function renderRecentUpdates(data) {
    return `
      <h2 class="title is-4"><i class="fas fa-bullhorn mr-2"></i> Recent Updates</h2>
      ${data.recent_notifications && data.recent_notifications.length > 0 ? data.recent_notifications.map(n => `
        <div class="box mb-4 notification-card-small" onclick="window.location='/notifications/${n.id}/view'" style="cursor:pointer; border-left: 4px solid ${n.urgency === 3 ? '#ff3860' : (n.urgency === 2 ? '#ffdd57' : '#3273dc')};">
          <div class="is-flex is-align-items-center mb-1">
            ${n.course_prefix ? `<span class="px-1 mr-2" style="border-radius: 3px; font-size: 0.65rem; font-weight: bold; ${n.pill_style || getCoursePillStyle(n.course_name)}">${n.course_prefix}</span>` : ''}
            <span class="is-size-7 has-text-grey-dark" style="font-weight: 600;">${n.course_short_name || n.course_name || 'General'}</span>
            ${n.semester ? `<span class="tag is-white is-small has-text-grey" style="font-size: 0.65rem;">${n.semester}</span>` : ''}
          </div>
          <h6 class="title is-6 mb-2">${n.title}</h6>
          <div class="level is-mobile">
            <div class="level-left">
              <span class="is-size-7 has-text-grey">${formatDate(n.date)}</span>
              <span class="tag is-small is-rounded ml-2 is-light">${n.notification_type}</span>
            </div>
          </div>
        </div>
      `).join('') : '<p class="has-text-grey italic">No recent updates found.</p>'}
      <div class="mt-4 has-text-centered">
        <a href="/notifications" class="button is-small is-fullwidth is-light">
          View All Notifications <i class="fas fa-arrow-right ml-2"></i>
        </a>
      </div>
    `;
  }

  // --- Actions ---

  window.toggleAssignment = function(checkbox) {
    const id = checkbox.getAttribute('data-id');
    const box = checkbox.closest('.box');
    
    fetch(`/assignments/${id}/toggle_complete`, {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(response => response.json())
    .then(data => {
      if (data.status === 'ok' && data.completed) {
        box.style.opacity = '0.4';
        box.style.pointerEvents = 'none';
        setTimeout(() => { box.style.display = 'none'; }, 800);
      }
    });
  };

  // Initial Load
  document.addEventListener('DOMContentLoaded', () => loadDashboard());

  window.addEventListener('brilliant:notification_received', (e) => {
    console.log("[SSE] Notification received, refreshing dashboard...");
    loadDashboard();
  });

  window.addEventListener('brilliant:notifications_synced', (e) => {
    console.log("[SSE] Notifications synced, refreshing dashboard...");
    loadDashboard();
  });
</script>

<style>
  .notification-card-small { transition: transform 0.1s; }
  .notification-card-small:hover { transform: translateX(3px); background-color: #f9f9f9; }
  .box.is-clickable:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(115, 154, 195, 0.15); border-color: #739AC3 !important; }
  .select.is-ghost select:hover { color: #739AC3 !important; }
</style>
