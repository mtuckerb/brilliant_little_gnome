<div class="columns">
  <div class="column is-8">
    <div class="level mb-6">
      <div class="level-left">
        <h1 class="title"><i class="fas fa-book-open mr-2"></i> My Course List</h1>
      </div>
    </div>

    <% if @courses.empty? %>
      <div class="notification is-warning">No active courses found.</div>
    <% else %>
      <div class="box p-0">
        <table class="table is-fullwidth is-hoverable">
          <thead>
            <tr>
              <th>Course Name</th>
              <th class="has-text-right">Action</th>
            </tr>
          </thead>
          <tbody>
            <% @courses.each do |c| %>
              <tr class="course-row" onclick="window.location='/course/<%= c['OrgUnit']['Id'] %>'">
                <td class="py-4">
                  <% 
                    full_name = c['OrgUnit']['Name']
                    
                    # Pattern: SWO 370:0001-Human Behav (Online) (2026 Spring)
                    regex = /^(\w{3}\s\d{3}):\d{4}-(.*?)\s*(\(Online\))?\s*(\(\d{4}\s+(?:Spring|Fall|Summer|Winter)\))$/i
                    match = full_name.match(regex)
                    
                    if match
                      course_display = "#{match[1]} - #{match[2].strip}"
                      is_online = !match[3].to_s.empty?
                      semester = match[4].to_s.gsub(/[()]/, '').strip
                    else 
                      # Fallback logic
                      course_display = full_name
                      is_online = full_name.downcase.include?('online')
                      semester_match = full_name.match(/(\(?(?:\d{4}\s+(?:Spring|Fall|Summer|Winter))\)?)/i)
                      semester = semester_match ? semester_match[1].gsub(/[()]/, '').strip : nil
                      
                      # Clean up course_display for fallback
                      if semester
                        course_display = course_display.gsub(/\(#{Regexp.escape(semester)}\)/, '').gsub(semester, '').strip
                      end
                      course_display = course_display.gsub('(Online)', '').strip
                    end
                  %>
                  <div class="has-text-weight-bold is-size-5 mb-1">
                    <%= course_display %>
                  </div>
                  
                  <div class="tags mb-2">
                    <% if semester %>
                      <span class="tag is-info is-light"><%= semester %></span>
                    <% end %>
                    
                    <% if is_online %>
                      <span class="tag is-success is-light">Online</span>
                    <% end %>
                    
                    <%# Check for building/classroom in OrgUnit Code or other fields if available %>
                    <% if c['OrgUnit']['Location'] %>
                      <span class="tag is-warning is-light"><%= c['OrgUnit']['Location'] %></span>
                    <% end %>
                  </div>

                  <div class="is-size-7 has-text-grey-light has-text-weight-normal">
                    <%= c['OrgUnit']['Code'] %>
                  </div>
                </td>
                <td class="has-text-right is-vcentered">
                  <a href="/course/<%= c['OrgUnit']['Id'] %>" class="button is-small is-primary is-light">
                    View <i class="fas fa-arrow-right ml-2"></i>
                  </a>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <div class="column is-4">
    <h2 class="title is-4"><i class="fas fa-bullhorn mr-2"></i> Recent Updates</h2>
    <% if @all_news && !@all_news.empty? %>
      <% @all_news.each do |news| %>
        <div class="box mb-4">
          <p class="is-size-7 has-text-primary has-text-weight-bold mb-1">
            <%= news['CourseName'] %>
          </p>
          <h6 class="title is-6 mb-2"><%= news['Title'] %></h6>
          <div class="content is-size-7 mb-2">
            <% 
               desc = news['Body']
               desc_text = desc.is_a?(Hash) ? (desc['Html'] || desc['Text'] || "") : desc.to_s
               # Strip tags for a clean preview
               preview = desc_text.gsub(/<[^>]*>/, '').strip.slice(0..100)
            %>
            <%= preview %><%= "..." if desc_text.length > 100 %>
          </div>
          <div class="level is-mobile">
            <div class="level-left">
              <span class="is-size-7 has-text-grey">
                <%= Time.parse(news['StartDate']).strftime("%b %d") %>
              </span>
            </div>
            <div class="level-right">
              <a href="/course/<%= news['CourseId'] %>/announcements" class="button is-small is-white has-text-link">View Full</a>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="has-text-grey italic">No recent updates found.</p>
    <% end %>
  </div>
</div>
