<div class="columns">
  <div class="column is-8">
    <div id="sync-indicator" class="box mb-4" style="display: <%= @sync_status[:status] == 'syncing' ? 'block' : 'none' %>;">
      <div class="level is-mobile mb-2">
        <div class="level-left">
          <p class="is-size-7 has-text-weight-bold">
            <i class="fas fa-sync fa-spin mr-2"></i> 
            <span id="sync-task"><%= @sync_status[:current_task] %></span>
          </p>
        </div>
        <div class="level-right">
          <span id="sync-percent" class="is-size-7"><%= @sync_status[:progress] %>%</span>
        </div>
      </div>
      <progress id="sync-progress" class="progress is-small is-primary" value="<%= @sync_status[:progress] %>" max="100"><%= @sync_status[:progress] %>%</progress>
    </div>

    <div class="level mb-6">
      <div class="level-left">
        <h1 class="title"><i class="fas fa-book-open mr-2"></i> My Course List</h1>
      </div>
    </div>

    <% if @courses.empty? %>
      <div class="notification is-warning">No active courses found.</div>
    <% else %>
      <div class="box p-0">
        <table class="table is-fullwidth is-hoverable">
          <thead>
            <tr>
              <th>Course Name</th>
              <th class="has-text-right">Action</th>
            </tr>
          </thead>
          <tbody>
            <% @courses.each do |c| %>
              <%
                 id   = c.is_a?(Hash) ? c['OrgUnit']['Id'] : c.org_unit_id
                 name = c.is_a?(Hash) ? c['OrgUnit']['Name'] : c.name
                 code = c.is_a?(Hash) ? c['OrgUnit']['Code'] : c.code
                 loc  = c.is_a?(Hash) ? c['OrgUnit']['Location'] : nil
              %>
              <tr class="course-row" onclick="window.location='/course/<%= id %>'">
                <td class="py-4">
                  <% info = extract_course_info(name) %>
                  <div class="has-text-weight-bold is-size-5 mb-1">
                    <%= info[:course_display] %>
                  </div>
                  
                  <div class="tags mb-2">
                    <% if info[:semester] %>
                      <span class="tag is-info is-light"><%= info[:semester] %></span>
                    <% end %>
                    
                    <% if info[:is_online] %>
                      <span class="tag is-success is-light">Online</span>
                    <% end %>
                    
                    <%# Online or Location Tag %>
                    <% if loc %>
                      <span class="tag is-warning is-light"><%= loc %></span>
                    <% end %>
                  </div>

                  <div class="is-size-7 has-text-grey-light has-text-weight-normal">
                    <%= code %>
                  </div>
                </td>
                <td class="has-text-right is-vcentered">
                  <a href="/course/<%= id %>" class="button is-small is-primary is-light">
                    View <i class="fas fa-arrow-right ml-2"></i>
                  </a>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <div class="column is-4">
    <h2 class="title is-4"><i class="fas fa-bullhorn mr-2"></i> Recent Updates</h2>
    <% if @recent_notifications && !@recent_notifications.empty? %>
      <% @recent_notifications.each do |n| %>
        <div class="box mb-4 notification-card-small" onclick="window.location='<%= n.url %>'" style="cursor:pointer; border-left: 4px solid <%= n.urgency == 3 ? '#ff3860' : (n.urgency == 2 ? '#ffdd57' : '#3273dc') %>;">
          <p class="is-size-7 has-text-primary has-text-weight-bold mb-1">
            <%= n.course_name ? extract_course_info(n.course_name)[:course_display] : "General" %>
          </p>
          <h6 class="title is-6 mb-2"><%= n.title %></h6>
          <div class="content is-size-7 mb-2">
            <%= n.body ? truncate_text(n.body.gsub(/<[^>]*>/, '').strip, 80) : "No description" %>
          </div>
          <div class="level is-mobile">
            <div class="level-left">
              <span class="is-size-7 has-text-grey">
                <%= format_date(n.date, "%b %d") rescue "Recently" %>
              </span>
              <span class="tag is-small is-rounded ml-2 is-light">
                <%= n.notification_type %>
              </span>
            </div>
            <div class="level-right">
              <a href="<%= n.url %>" class="button is-small is-white has-text-link">View</a>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="has-text-grey italic">No recent updates found.</p>
    <% end %>
    <div class="mt-4 has-text-centered">
      <a href="/notifications" class="button is-small is-fullwidth is-light">
        View All Notifications <i class="fas fa-arrow-right ml-2"></i>
      </a>
    </div>
  </div>
</div>

<style>
.notification-card-small {
  transition: transform 0.1s;
}
.notification-card-small:hover {
  transform: translateX(3px);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const indicator = document.getElementById('sync-indicator');
  const taskText = document.getElementById('sync-task');
  const percentText = document.getElementById('sync-percent');
  const progressBar = document.getElementById('sync-progress');

  function checkSyncStatus() {
    fetch('/sync/status')
      .then(response => response.json())
      .then(data => {
        if (data.status === 'syncing') {
          indicator.style.display = 'block';
          taskText.innerText = data.current_task;
          percentText.innerText = data.progress + '%';
          progressBar.value = data.progress;
          setTimeout(checkSyncStatus, 2000); // Check every 2s
        } else if (data.status === 'completed') {
          taskText.innerText = "Sync complete!";
          percentText.innerText = '100%';
          progressBar.value = 100;
          setTimeout(() => { indicator.style.display = 'none'; }, 3000);
        } else {
          indicator.style.display = 'none';
        }
      })
      .catch(err => console.error("Sync check error:", err));
  }

  // Initial trigger if dashboard shows it is active
  if (indicator.style.display !== 'none') {
    checkSyncStatus();
  }
});
</script>
