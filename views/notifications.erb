<div class="columns">
  <div class="column is-3">
    <div class="box">
      <h3 class="title is-5 mb-4"><i class="fas fa-filter mr-2"></i> Filters</h3>
      
      <form action="/notifications" method="get">
        <div class="field mb-3">
          <label class="label is-size-7">Sort By</label>
          <div class="control">
            <div class="select is-fullwidth is-small">
              <select name="sort" onchange="this.form.submit()">
                <option value="date" <%= 'selected' if params[:sort] == 'date' %>>Newest First</option>
                <option value="urgency" <%= 'selected' if params[:sort] == 'urgency' %>>Urgency First</option>
              </select>
            </div>
          </div>
        </div>

        <div class="field mb-3">
          <label class="label is-size-7">Semester</label>
          <div class="control">
            <div class="select is-fullwidth is-small">
              <select name="semester" onchange="this.form.submit()">
                <option value="">All Semesters</option>
                <% 
                  semesters = Notification.where.not(semester: [nil, ""]).pluck(:semester).uniq.sort
                  semesters.each do |s| 
                %>
                  <option value="<%= s %>" <%= 'selected' if params[:semester] == s %>>
                    <%= s %>
                  </option>
                <% end %>
              </select>
            </div>
          </div>
        </div>

        <div class="field mb-3">
          <label class="label is-size-7">Course</label>
          <div class="control">
            <div class="select is-fullwidth is-small">
              <select name="course_id" onchange="this.form.submit()">
                <option value="">All Courses</option>
                <% @courses.each do |c| %>
                  <% info = extract_course_info(c['OrgUnit']['Name']) %>
                  <option value="<%= c['OrgUnit']['Id'] %>" <%= 'selected' if params[:course_id] == c['OrgUnit']['Id'].to_s %>>
                    <%= info[:course_display] %>
                  </option>
                <% end %>
              </select>
            </div>
          </div>
        </div>

        <div class="field mb-3">
          <label class="label is-size-7">Urgency</label>
          <div class="control">
            <div class="select is-fullwidth is-small">
              <select name="urgency" onchange="this.form.submit()">
                <option value="">Any Urgency</option>
                <option value="3" <%= 'selected' if params[:urgency] == '3' %>>High (Red)</option>
                <option value="2" <%= 'selected' if params[:urgency] == '2' %>>Medium (Yellow)</option>
                <option value="1" <%= 'selected' if params[:urgency] == '1' %>>Low (Blue)</option>
              </select>
            </div>
          </div>
        </div>

        <div class="field mb-4">
          <label class="checkbox is-size-7">
            <input type="checkbox" name="personal_only" value="true" <%= 'checked' if params[:personal_only] == 'true' %> onchange="this.form.submit()">
            Directly for me only
          </label>
        </div>

        <div class="field mb-4">
          <label class="checkbox is-size-7">
            <input type="checkbox" name="show_read" value="true" <%= 'checked' if params[:show_read] == 'true' %> onchange="this.form.submit()">
            Include already read
          </label>
        </div>

        <hr class="my-4">
        
        <div class="is-size-7 has-text-grey">
          <p class="mb-2"><strong>Urgency Legend:</strong></p>
          <p><span class="icon is-small has-text-danger"><i class="fas fa-circle"></i></span> High (Direct Reply / Grade)</p>
          <p><span class="icon is-small has-text-warning"><i class="fas fa-circle"></i></span> Medium (Involvement)</p>
          <p><span class="icon is-small has-text-info"><i class="fas fa-circle"></i></span> Low (Broadcast/General)</p>
        </div>
      </form>
    </div>
  </div>

  <div class="column is-9">
    <nav class="breadcrumb mr-2" aria-label="breadcrumbs">
      <ul>
        <li>
          <a href="/dashboard">
            <span class="icon is-small" style="margin-top: 5px;"><i class="fas fa-home"></i></span>
          </a>
        </li>
        <li><a href="/dashboard">Courses</a></li>
        <% if @context_course %>
          <li><a href="/course/<%= @context_course.org_unit_id %>" title="<%= @context_course.name %>"><%= truncate_text(@context_course.name, 40) %></a></li>
        <% end %>
        <li class="is-active"><a href="#" aria-current="page">Notifications</a></li>
      </ul>
    </nav>

    <div class="level mb-5">
      <div class="level-left">
        <h1 class="title">Notifications</h1>
      </div>
      <div class="level-right">
        <form action="/notifications/mark_all_read" method="post" class="mr-2">
          <button type="submit" class="button is-link is-light is-small">
            <i class="fas fa-check-double mr-2"></i> Mark All Read
          </button>
        </form>
      </div>
    </div>

    <%= erb :'partials/notifications_list' %>
  </div>
</div>
