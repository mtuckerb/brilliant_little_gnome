<%= erb :'partials/course_detail_header' %>
<div class="columns">
  <div class="column is-3">
    <%= erb :'partials/sidebar' %>
  </div>
  <div class="column is-9" id="assignments-root">
    <div class="is-flex is-justify-content-center is-align-items-center" style="min-height: 400px;">
      <div class="has-text-centered">
        <span class="icon is-large has-text-primary mb-4">
          <i class="fas fa-circle-notch fa-spin fa-3x"></i>
        </span>
        <p class="is-size-5 has-text-grey">Loading Assignments...</p>
      </div>
    </div>
  </div>
<%= erb :'partials/edit_assignment_modal' %>

</div>

<script>
  const COURSE_ID = "<%= @course_id %>";
  let showCompleted = <%= @show_completed %>;

  async function loadAssignments() {
    const root = document.getElementById('assignments-root');
    try {
      const response = await fetch(`/api/v1/courses/${COURSE_ID}/assignments/summary?show_completed=${showCompleted}`);
      if (!response.ok) throw new Error("Failed to fetch assignments");
      const data = await response.json();
      renderAssignments(data);
    } catch (err) {
      console.error(err);
      root.innerHTML = `
        <div class="notification is-danger">
          <h3 class="title is-5">Error Connection Lost</h3>
          <p>Failed to load assignments. Please ensure the backend is running.</p>
          <button class="button is-white is-small mt-2" onclick="location.reload()">Retry</button>
        </div>
      `;
    }
  }

  function renderAssignments(data) {
    const root = document.getElementById('assignments-root');
    const { assignments } = data;

    let html = `
      <div class="box">
        <div class="level">
          <div class="level-left">
            <h4 class="title is-4"><i class="fas fa-tasks mr-2"></i> Assignments</h4>
          </div>
          <div class="level-right">
            <div id="bulk-action-bar" class="is-hidden mr-4">
              <span class="has-text-grey-light is-size-7 mr-2"><span id="selected-count">0</span> selected</span>
              <div class="buttons are-small">
                <button class="button is-light" onclick="bulkOptional(true)">
                  <span class="icon is-small"><i class="fas fa-hand-paper"></i></span>
                  <span>Mark Optional</span>
                </button>
                <button class="button is-light" onclick="bulkOptional(false)">
                  <span class="icon is-small"><i class="fas fa-check-circle"></i></span>
                  <span>Mark Required</span>
                </button>
              </div>
            </div>
            <button class="button is-small ${!showCompleted ? 'is-info' : 'is-white'} mr-2" onclick="toggleShowCompleted()">
              <span class="icon is-small mr-1">
                <i class="${showCompleted ? 'fas fa-eye' : 'fas fa-eye-slash'}"></i>
              </span>
              <span>${showCompleted ? "Hide Completed" : "Show Completed"}</span>
            </button>
            <a href="/course/${COURSE_ID}/assignments/export.ics" class="button is-small is-primary is-outlined">
              <span class="icon is-small"><i class="fas fa-calendar-alt"></i></span>
              <span>Export to Calendar</span>
            </a>
          </div>
        </div>

        <table class="table is-fullwidth is-hoverable">
          <thead>
            <tr>
              <th width="40" class="has-text-centered">
                <input type="checkbox" id="select-all" onchange="toggleSelectAll(this)">
              </th>
              <th width="40" class="has-text-centered">
                <span class="icon is-small has-text-grey-light" title="Status"><i class="fas fa-check"></i></span>
              </th>
              <th>Assignment</th>
              <th class="has-text-right">Action</th>
            </tr>
          </thead>
          <tbody>
            ${assignments.length === 0 ? '<tr><td colspan="4" class="has-text-grey has-text-centered p-5">No assignments found.</td></tr>' : 
              assignments.map(a => renderAssignmentRow(a)).join('')}
          </tbody>
        </table>
      </div>
    `;

    root.innerHTML = html;
  }

  function renderAssignmentRow(a) {
    const id = a.brightspace_id;
    const db_id = a.id;
    const isCompleted = a.is_completed;
    const isOptional = a.is_optional;
    const isQuiz = a.is_quiz;
    const viewUrl = isQuiz ? `/course/${COURSE_ID}/quizzes/${id.replace('quiz_', '')}` : `/course/${COURSE_ID}/assignments/${id}`;

    return `
      <tr class="assignment-row ${isCompleted ? 'is-completed' : ''} ${isOptional ? 'is-optional' : ''}" data-id="${db_id}" data-type="assignment" data-brightspace-id="${id}">
        <td class="has-text-centered is-vcentered">
          <input type="checkbox" class="assignment-bulk-checkbox" data-id="${db_id}" onchange="updateBulkSelection()">
        </td>
        <td class="has-text-centered is-vcentered">
          <div class="completion-toggle-container">
            <input type="checkbox" id="complete-${db_id}" class="assignment-checkbox is-hidden" data-id="${db_id}" ${isCompleted ? 'checked' : ''} onchange="toggleAssignmentInline(this)">
            <label for="complete-${db_id}" class="completion-toggle-label is-clickable" style="display: inline-block; vertical-align: middle;">
              <span class="icon is-medium has-text-success status-icon-completed ${!isCompleted ? 'is-hidden' : ''}">
                <i class="fas fa-check-circle fa-lg"></i>
              </span>
              <span class="icon is-medium has-text-grey-lighter status-icon-incomplete ${isCompleted ? 'is-hidden' : ''}">
                <i class="far fa-circle fa-lg"></i>
              </span>
            </label>
          </div>
        </td>
        <td class="assignment-info">
          <div class="is-flex is-align-items-start">
            <div style="flex: 1;">
              <div class="mb-1 is-flex is-align-items-center">
                <strong>
                  <a href="${viewUrl}" class="assignment-link has-text-dark">${a.name_html}</a>
                </strong>
                ${isQuiz ? '<span class="tag is-info is-light is-small ml-2">Quiz</span>' : ''}
                <span class="tag is-light is-small ml-2 optional-tag ${!isOptional ? 'is-hidden' : ''}">
                  <i class="fas fa-hand-paper mr-1"></i> Optional
                </span>
                <button class="button is-ghost is-small p-0 ml-3" onclick="expandAssignmentRow('${db_id}', event)" style="height: auto;">
                  <span class="icon is-small has-text-grey-light"><i class="fas fa-chevron-right toggle-icon"></i></span>
                </button>
              </div>
              <div class="is-size-7 has-text-grey">
                <i class="fas fa-calendar-alt mr-1"></i> Due: 
                <span class="due-date-display is-clickable" onclick="editDueDateInline(this, '${db_id}')">
                  ${a.due_date ? new Date(a.due_date).toLocaleString() : "No due date"}
                </span>
                <input type="date" class="due-date-input is-hidden input is-small py-0 px-1" 
                       value="${a.due_date ? new Date(a.due_date).toISOString().split('T')[0] : ''}"
                       onblur="saveDueDateInline(this, '${db_id}')" style="width: 130px; display: none;">
              </div>
              <div id="expand-${db_id}" class="assignment-details-content is-hidden mt-3 p-3 has-background-white-bis" style="border-radius: 4px; border-left: 3px solid #dbdbdb;">
                <div class="content is-size-7">
                  <p class="has-text-grey">Loading details...</p>
                </div>
              </div>
            </div>
          </div>
        </td>
        <td class="has-text-right is-vcentered">
          <div class="buttons is-right">
            ${a.synthetic ? `
              <button class="button is-small is-info is-light" onclick="openEditModalFromRow('${db_id}')">
                <span class="icon is-small"><i class="fas fa-edit"></i></span>
              </button>
            ` : ''}
            <a href="${viewUrl}" class="button is-small is-primary is-light">View Details</a>
          </div>
        </td>
      </tr>
    `;
  }

  function toggleShowCompleted() {
    showCompleted = !showCompleted;
    loadAssignments();
  }

  function toggleSelectAll(checkbox) {
    const checkboxes = document.querySelectorAll('.assignment-bulk-checkbox');
    checkboxes.forEach(cb => cb.checked = checkbox.checked);
    updateBulkSelection();
  }

  function updateBulkSelection() {
    const selected = document.querySelectorAll('.assignment-bulk-checkbox:checked');
    const count = selected.length;
    const bar = document.getElementById('bulk-action-bar');
    const countSpan = document.getElementById('selected-count');
    
    if (count > 0) {
      bar.classList.remove('is-hidden');
      countSpan.textContent = count;
    } else {
      bar.classList.add('is-hidden');
    }
  }

  function bulkOptional(isOptional) {
    const selected = document.querySelectorAll('.assignment-bulk-checkbox:checked');
    const ids = Array.from(selected).map(cb => cb.getAttribute('data-id')).filter(id => id !== '');
    if (ids.length === 0) return;
    
    const formData = new URLSearchParams();
    ids.forEach(id => formData.append('ids[]', id));
    formData.append('optional', isOptional);
    
    fetch(`/course/${COURSE_ID}/assignments/bulk_optional`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: formData.toString()
    })
    .then(res => res.json())
    .then(data => {
      if (data.status === 'ok') loadAssignments();
    });
  }

  function toggleAssignmentInline(checkbox) {
    const id = checkbox.getAttribute('data-id');
    fetch(`/assignments/${id}/toggle_complete`, {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(res => res.json())
    .then(data => {
      if (data.status === 'ok') {
        const row = checkbox.closest('.assignment-row');
        if (data.completed) {
          row.classList.add('is-completed');
          row.querySelector('.status-icon-completed').classList.remove('is-hidden');
          row.querySelector('.status-icon-incomplete').classList.add('is-hidden');
        } else {
          row.classList.remove('is-completed');
          row.querySelector('.status-icon-completed').classList.add('is-hidden');
          row.querySelector('.status-icon-incomplete').classList.remove('is-hidden');
        }
      }
    });
  }

  function editDueDateInline(span, id) {
    const container = span.parentElement;
    const input = container.querySelector('.due-date-input');
    span.classList.add('is-hidden');
    span.style.display = 'none';
    input.classList.remove('is-hidden');
    input.style.display = 'inline-block';
    input.focus();
  }

  function saveDueDateInline(input, id) {
    fetch(`/assignments/${id}/update_due_date`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: `due_date=${input.value}`
    })
    .then(res => res.json())
    .then(data => {
      if (data.status === 'ok') loadAssignments();
    });
  }

  function expandAssignmentRow(dbId, event) {
    const detailsDiv = document.getElementById(`expand-${dbId}`);
    const icon = event.currentTarget.querySelector('.toggle-icon');
    
    if (!detailsDiv.classList.contains('is-hidden')) {
      detailsDiv.classList.add('is-hidden');
      icon.classList.replace('fa-chevron-down', 'fa-chevron-right');
      return;
    }
    
    detailsDiv.classList.remove('is-hidden');
    icon.classList.replace('fa-chevron-right', 'fa-chevron-down');
    
    if (detailsDiv.dataset.loaded !== 'true') {
      const row = detailsDiv.closest('.assignment-row');
      const itemId = row.dataset.brightspaceId;

      fetch(`/api/v1/item_details?type=assignment&id=${itemId}&course_id=${COURSE_ID}`)
        .then(r => r.json())
        .then(data => {
          detailsDiv.querySelector('.content').innerHTML = data.html || '<p class="has-text-grey">No description available.</p>';
          detailsDiv.dataset.loaded = 'true';
        });
    }
  }

  function openEditModalFromRow(dbId) {
    const row = document.querySelector(`.assignment-row[data-id="${dbId}"]`);
    if (!row) return;

    const itemId = row.dataset.brightspaceId;
    const name = row.querySelector('.assignment-link').innerText;
    const dueDateRaw = row.querySelector('.due-date-input').value;
    
    // To get the description, we can check if the expand div is loaded, 
    // or just fetch the assignment details via API
    fetch(`/api/v1/courses/${COURSE_ID}/assignments/summary`) // This is a bit heavy, maybe better to have a specific endpoint or use the expand div logic
      .then(r => r.json())
      .then(data => {
        // We'll just open the modal with what we have and let the user fill the rest if needed, 
        // OR we can do a proper fetch for a single assignment.
        // Actually, the assignment_controller has: get '/course/:id/assignments/:assignment_id'
        
        return fetch(`/course/${COURSE_ID}/assignments/${itemId}`, { headers: {'Accept': 'application/json'}})
      })
      .then(r => r.json())
      .then(assignment => {
         const dt = assignment.DueDate ? new Date(assignment.DueDate) : null;
         openEditAssignmentModal({
           courseId: COURSE_ID,
           brightspaceId: itemId,
           name: assignment.Name,
           dueDate: dt ? dt.toISOString().split('T')[0] : '',
           dueTime: dt ? dt.toTimeString().split(' ')[0].substring(0, 5) : '',
           externalUrl: assignment.ExternalUrl,
           description: assignment.Instructions?.Text || assignment.description || ''
         });
      });
  }

  document.addEventListener('DOMContentLoaded', () => loadAssignments());

  window.addEventListener('brilliant:assignments_updated', (e) => {
    const { course_id } = e.detail;
    if (course_id == COURSE_ID) {
      console.log("[SSE] Assignments updated, refreshing list...");
      loadAssignments();
    }
  });
</script>

<style>
  .completion-toggle-label .icon { transition: transform 0.1s ease; }
  .completion-toggle-label:hover .icon { transform: scale(1.1); }
  .assignment-row.is-completed { opacity: 0.6; background-color: #fafafa; }
  .assignment-row.is-completed strong a { text-decoration: line-through; }
  .assignment-row.is-optional { border-left: 4px solid #dbdbdb; background-color: #fcfcfc; }
</style>
