<%= erb :'partials/course_detail_header' %>
<div class="columns">
  <div class="column is-3">
    <%= erb :'partials/sidebar' %>
  </div>
  <div class="column is-9">
    <div class="box">
      <h4 class="title is-4"><i class="fas fa-poll mr-2"></i> Grades</h4>
      <% if @grades && !@grades.empty? %>
        <table class="table is-fullwidth">
          <thead>
            <tr>
              <th>Item</th>
              <th>Points</th>
              <th>Grade</th>
            </tr>
          </thead>
          <tbody>
            <% @grades.each do |g| %>
              <% 
                # Support both ActiveRecord objects and raw API Hashes
                name = g.respond_to?(:name) ? g.name : g['GradeObjectName']
                displayed = g.respond_to?(:displayed_grade) ? g.displayed_grade : g['DisplayedGrade']
                numerator = g.respond_to?(:numerator) ? g.numerator : g['PointsNumerator']
                denominator = g.respond_to?(:denominator) ? g.denominator : g['PointsDenominator']
              %>
              <tr>
                <td><%= name %></td>
                <td style="font-family: monospace;"><%= displayed %></td>
                <td>
                  <% if numerator && denominator %>
                    <span class="tag is-info"><%= numerator %> / <%= denominator %></span>
                    <% if denominator > 0 %>
                      <span class="tag is-light is-info"><%= ((numerator.to_f / denominator) * 100).round(1) %>%</span>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="has-text-grey">No grade values found yet.</p>
      <% end %>
    </div>
  </div>
</div>
