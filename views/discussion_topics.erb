<%= erb :'partials/course_detail_header' %>
<div class="columns">
  <div class="column is-3">
    <%= erb :'partials/sidebar' %>
  </div>
  <div class="column is-9">
    <div class="box">
      <div class="level">
        <div class="level-left">
          <h4 class="title is-4"><i class="fas fa-list mr-2"></i> <%= @forum ? @forum['Name'] : 'Topics' %></h4>
        </div>
        <div class="level-right">
          <a href="<%= $client.portal_url_for(:course_home, {course_id: @course_id}) %>" class="button is-small is-link is-light" target="_blank">
            <span class="icon is-small"><i class="fas fa-external-link-alt"></i></span>
            <span>View Forum in Brightspace</span>
          </a>
        </div>
      </div>
      
      <% if @topics && !@topics.empty? %>
        <div class="list is-hoverable">
          <% 
             @topics.each do |topic| 
               is_obj = topic.is_a?(DiscussionTopic)
               topic_id = is_obj ? topic.brightspace_id : topic['TopicId']
               name = is_obj ? topic.name : topic['Name']
               desc = is_obj ? topic.description : topic['Description']
               desc_text = desc.is_a?(Hash) ? (desc['Html'] || desc['Text'] || "") : (desc || "")
               thread_count = is_obj ? topic.thread_count : topic['ThreadCount']
               last_post_date = is_obj ? topic.last_post_date : (topic['LastPostDate'] ? Time.parse(topic['LastPostDate']) : nil)
               end_date = is_obj ? nil : topic['EndDate']
          %>
            <a href="/course/<%= @course_id %>/discussions/<%= @forum_id %>/topics/<%= topic_id %>" class="list-item py-4">
              <div class="is-flex is-justify-content-space-between is-align-items-center">
                <div class="content">
                  <h5 class="title is-5 mb-1"><%= name %></h5>
                  <div class="is-size-6 has-text-grey">
                    <%= desc_text.gsub(/<[^>]+>/, '').strip.slice(0..150) %><%= "..." if desc_text.length > 150 %>
                  </div>
                </div>
                <div class="has-text-right">
                  <% if end_date %>
                    <div class="is-size-7 has-text-danger mb-1">
                      <i class="fas fa-calendar-times mr-1"></i> Due: <%= format_date(end_date, "%b %d") %>
                    </div>
                  <% elsif last_post_date %>
                     <div class="is-size-7 has-text-grey mb-1">Activity: <%= format_date(last_post_date, "%b %d") %></div>
                  <% end %>
                  <span class="tag is-light"><%= thread_count || 0 %> Threads</span>
                  <span class="icon has-text-grey-light ml-2"><i class="fas fa-chevron-right"></i></span>
                </div>
              </div>
            </a>
          <% end %>
        </div>
      <% else %>
        <p class="has-text-grey">No topics found for this forum.</p>
      <% end %>
    </div>
  </div>
</div>
