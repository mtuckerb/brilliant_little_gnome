<%= erb :'partials/course_detail_header' %>
<div class="columns">
  <div class="column is-3">
    <%= erb :'partials/sidebar' %>
  </div>
  <div class="column is-9">
    <div class="box">
      <div class="mb-5">
        <div class="is-flex is-justify-content-space-between is-align-items-start mb-2">
          <div style="flex: 1; padding-right: 20px;">
            <h4 class="title is-4 mb-1"><%= render_markdown_inline(@assignment['Name']) %></h4>
            <div class="is-size-6 has-text-grey">
              <i class="fas fa-calendar-alt mr-1"></i> Due: <%= @assignment['DueDate'] ? format_date(@assignment["DueDate"]) : "No due date" %>
            </div>
          </div>
          
          <div class="is-flex is-flex-direction-column is-align-items-flex-end" style="gap: 8px;">
            <div class="buttons are-small mb-0">
              <% 
                 # Find local record to check optional status
                 local_rec = Assignment.find_by(brightspace_id: @assignment_id, course_id: @course_id)
              %>
              <% if local_rec %>
                <button class="button <%= local_rec.optional ? 'is-dark' : 'is-light' %>" onclick="toggleOptional('<%= local_rec.id %>')">
                  <span class="icon is-small"><i class="fas fa-hand-paper"></i></span>
                  <span><%= local_rec.optional ? 'Optional' : 'Mark Optional' %></span>
                </button>
              <% end %>

              <% if @assignment['Synthetic'] %>
                <button class="button is-info is-light" onclick="openEditModal()">
                  <span class="icon is-small"><i class="fas fa-edit"></i></span>
                  <span>Edit</span>
                </button>
                <form action="/course/<%= @course_id %>/assignments/<%= @assignment_id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this task?');" style="display:inline;">
                  <button type="submit" class="button is-danger is-light">
                    <span class="icon is-small"><i class="fas fa-trash"></i></span>
                  </button>
                </form>
              <% end %>
            </div>

            <% 
               portal_url = if @assignment['Synthetic'] && (ext_url = @assignment['ExternalUrl'])
                              ext_url.start_with?('/') ? "https://#{$client.host}#{ext_url}" : ext_url
                            else
                              $client.portal_url_for(:assignment, {course_id: @course_id, id: @assignment_id})
                            end
            %>
            <a href="<%= portal_url %>" class="button is-small is-link is-light" target="_blank">
              <span class="icon is-small"><i class="fas fa-external-link-alt"></i></span>
              <span>Open in Brightspace</span>
            </a>
          </div>
        </div>
      </div>

      <hr>

      <%# --- OVERALL SCORE (Top Level) --- %>
      <% 
         overall_score = nil
         if @submission_data.is_a?(Array) && !@submission_data.empty?
           overall_score = @submission_data[0]['Score']
         end
         # Fallback to grade entry if no score in submission data
         overall_score ||= @grade_entry['DisplayedGrade'] if @grade_entry
      %>
      <% if overall_score %>
        <div class="notification is-warning is-light mb-5">
          <div class="is-flex is-justify-content-space-between is-align-items-center">
            <h5 class="title is-5 mb-0"><i class="fas fa-star mr-2"></i> Overall Score</h5>
            <div class="is-size-4 has-text-weight-bold"><%= overall_score %></div>
          </div>
        </div>
      <% end %>

      <%# --- RUBRICS --- %>
      <% if @rubrics && !@rubrics.empty? %>
        <div class="mb-5">
          <div class="box is-light is-size-6 p-0 pos-relative" style="border-radius: 4px; overflow: hidden;">
            <div class="is-flex is-justify-content-space-between is-align-items-center p-2 has-background-warning-light is-clickable" onclick="toggleSection('rubric')">
              <h5 class="title is-5 mb-0"><i class="fas fa-th-list mr-2 has-text-warning-dark"></i> Evaluation Rubric</h5>
              <button class="button is-small is-ghost" title="Toggle section">
                <span class="icon is-small">
                  <i id="rubric-chevron" class="fas fa-chevron-<%= @rubric_collapsed ? 'right' : 'down' %>"></i>
                </span>
              </button>
            </div>
            <div id="rubric-content" class="p-4 has-background-white <%= 'is-hidden' if @rubric_collapsed %>">
              <% @rubrics.each do |rubric| %>
                <div class="rubric-container mb-5">
                  <h6 class="title is-6 mb-3 has-text-info"><%= rubric['Name'] %></h6>
                  
                  <% if rubric['Assessments'] %>
                    <% rubric['Assessments'].each do |assessment| %>
                      <div class="table-container">
                        <table class="table is-bordered is-striped is-narrow is-fullwidth is-size-7">
                          <thead>
                            <tr>
                              <th>Criterion</th>
                              <th>Level/Score</th>
                              <th>Feedback</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% (assessment['Criteria'] || []).each do |crit| %>
                              <tr>
                                <td style="width: 25%"><strong><%= crit['Name'] %></strong></td>
                                <td style="width: 25%">
                                  <span class="tag is-info is-light">
                                    <%= crit['SelectedLevelName'] || "N/A" %>
                                  </span>
                                  <div class="is-size-7 mt-1">Score: <%= crit['Score'] %> / <%= crit['OutOf'] %></div>
                                </td>
                                <td>
                                  <div class="content">
                                    <%= crit.dig('Feedback', 'Html') || crit.dig('Feedback', 'Text') || "No specific feedback" %>
                                  </div>
                                </td>
                              </tr>
                            <% end %>
                          </tbody>
                          <% if assessment['Score'] %>
                            <tfoot>
                              <tr class="has-background-white-ter">
                                <td colspan="2"><strong>Rubric Total</strong></td>
                                <td class="has-text-weight-bold"><%= assessment['Score'] %></td>
                              </tr>
                            </tfoot>
                          <% end %>
                        </table>
                      </div>
                    <% end %>
                  <% elsif rubric['CriteriaGroups'] %>
                    <div class="table-container">
                      <table class="table is-bordered is-striped is-narrow is-fullwidth is-size-7">
                        <thead>
                          <tr>
                            <th>Criterion</th>
                            <th>Description</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% rubric['CriteriaGroups'].each do |group| %>
                            <% (group['Criteria'] || []).each do |crit| %>
                              <tr>
                                <td style="width: 30%"><strong><%= crit['Name'] %></strong></td>
                                <td>
                                  <div class="is-size-7">
                                     Levels: <%= crit['Cells'].map { |c| c['Description']['Text'] if c['Description'] }.compact.join(' | ') %>
                                  </div>
                                </td>
                              </tr>
                            <% end %>
                          <% end %>
                        </tbody>
                      </table>
                    </div>
                    <p class="has-text-grey italic is-size-7 mt-2">Note: This is the rubric structure. Evaluation details (scores/specific feedback) will appear here once graded.</p>
                  <% else %>
                    <p class="has-text-grey italic">Rubric structure details unavailable or not yet assessed.</p>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <%# --- VIEW FEEDBACK (Official) --- %>
      <% 
         fb_text_content = ""
         if @feedback
           fb_desc = @feedback['Feedback']
           fb_text_content = fb_desc.is_a?(Hash) ? (fb_desc['Html'] || fb_desc['Text'] || "") : fb_desc.to_s
         end
         has_feedback = !fb_text_content.strip.empty? || (@feedback && @feedback['Attachments'] && !@feedback['Attachments'].empty?)
      %>
      <% if has_feedback %>
        <div class="mb-5">
          <div class="box is-light is-size-6 p-0 pos-relative" style="border-radius: 4px; overflow: hidden;">
            <div class="is-flex is-justify-content-space-between is-align-items-center p-2 has-background-success-light is-clickable" onclick="toggleSection('feedback')">
              <h5 class="title is-5 mb-0"><i class="fas fa-comment-dots mr-2 has-text-success"></i> Official Feedback</h5>
                <button class="button is-small is-ghost" title="Toggle section">
                 <span class="icon is-small">
                   <i id="feedback-chevron" class="fas fa-chevron-<%= @feedback_collapsed ? 'right' : 'down' %>"></i>
                 </span>
              </button>
            </div>
            
            <div id="feedback-content" class="p-4 has-background-white <%= 'is-hidden' if @feedback_collapsed %>">
              <div class="box has-background-white-ter shadow-sm">
                <div class="content">
                  <% if fb_text_content.strip.empty? %>
                    <p class="has-text-grey italic">No feedback text provided in official feedback slot.</p>
                  <% else %>
                    <%= render_content(fb_text_content) %>
                  <% end %>
                </div>

                <% if @feedback['Attachments'] && !@feedback['Attachments'].empty? %>
                  <div class="mt-4 pt-3" style="border-top: 1px dashed #ddd;">
                    <p class="is-size-7 has-text-weight-bold mb-2">Feedback Attachments:</p>
                    <div class="list is-hoverable">
                      <% @feedback['Attachments'].each do |att| %>
                        <div class="list-item">
                          <div class="is-flex is-justify-content-space-between is-align-items-center">
                            <span><i class="fas fa-file-pdf mr-2 has-text-danger"></i><%= att['FileName'] %></span>
                            <a href="/course/<%= @course_id %>/download?path=<%= URI.encode_www_form_component("/d2l/api/le/1.40/#{@course_id}/dropbox/folders/#{@assignment_id}/feedback/attachments/#{att['FileId']}") %>&name=<%= URI.encode_www_form_component(att['FileName']) %>" class="button is-small is-light">
                              <span class="icon is-small"><i class="fas fa-download"></i></span>
                            </a>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <%# --- INSTRUCTIONS --- %>
      <div class="mb-5">
        <div class="box is-light is-size-6 p-0 pos-relative" style="border-radius: 4px; overflow: hidden;">
          <div class="is-flex is-justify-content-space-between is-align-items-center p-2 has-background-light is-clickable" onclick="toggleSection('instructions')">
            <h5 class="title is-5 mb-0"><i class="fas fa-info-circle mr-2 has-text-primary"></i> Instructions</h5>
            <button class="button is-small is-ghost" title="Toggle section">
              <span class="icon is-small">
                <i id="instructions-chevron" class="fas fa-chevron-<%= @instructions_collapsed ? 'right' : 'down' %>"></i>
              </span>
            </button>
          </div>
          <div id="instructions-content" class="content p-4 has-background-white <%= 'is-hidden' if @instructions_collapsed %>">
            <% 
               desc = @assignment['Instructions'] || @assignment['CustomInstructions']
               desc_text = desc.is_a?(Hash) ? (desc['Html'] || desc['Text'] || "") : desc.to_s
            %>
            <div class="box is-light py-4 px-5">
              <% if desc_text.strip.empty? %>
                <p class="has-text-grey italic">No specific instructions provided.</p>
              <% else %>
                <%= render_content(desc_text) %>
              <% end %>
            </div>

            <% if @assignment['Attachments'] && !@assignment['Attachments'].empty? %>
              <div class="mt-4">
                <p class="is-size-7 has-text-weight-bold mb-2">Attachments:</p>
                <div class="list is-hoverable">
                  <% @assignment['Attachments'].each do |att| %>
                    <% 
                       download_url = "/d2l/api/le/1.40/#{@course_id}/dropbox/folders/#{@assignment_id}/attachments/#{att['FileId']}"
                    %>
                    <div class="list-item">
                      <div class="is-flex is-justify-content-space-between is-align-items-center">
                        <span><i class="fas fa-file-alt mr-2 has-text-grey"></i><%= att['FileName'] %></span>
                        <a href="/course/<%= @course_id %>/download?path=<%= URI.encode_www_form_component(download_url) %>&name=<%= URI.encode_www_form_component(att['FileName']) %>" class="button is-small is-light">
                          <span class="icon is-small"><i class="fas fa-download"></i></span>
                        </a>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if @assignment['LinkAttachments'] && !@assignment['LinkAttachments'].empty? %>
              <div class="mt-4">
                <p class="is-size-7 has-text-weight-bold mb-2">External Links:</p>
                <div class="list is-hoverable">
                  <% @assignment['LinkAttachments'].each do |link| %>
                    <div class="list-item">
                      <div class="is-flex is-justify-content-space-between is-align-items-center">
                        <span>
                          <i class="fas fa-link mr-2 has-text-grey"></i>
                          <strong><%= link['LinkName'] %></strong>
                        </span>
                        <% 
                           link_url = link['Href']
                           if link_url && link_url.start_with?("/")
                             link_url = "https://#{$client.host}#{link_url}"
                           end
                        %>
                        <a href="<%= link_url %>" class="button is-small is-primary is-light" target="_blank">
                          <span class="icon is-small"><i class="fas fa-arrow-right"></i></span>
                          <span>Open Link</span>
                        </a>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="notification is-info is-light mt-4">
        <i class="fas fa-info-circle mr-2"></i> Submissions must be handled through the official Brightspace portal.
      </div>

      <%# --- YOUR SUBMISSIONS --- %>
      <% if @submissions %>
        <div class="mb-5">
          <div class="box is-light is-size-6 p-0 pos-relative" style="border-radius: 4px; overflow: hidden;">
            <div class="is-flex is-justify-content-space-between is-align-items-center p-2 has-background-light is-clickable" onclick="toggleSection('submissions')">
              <h5 class="title is-5 mb-0"><i class="fas fa-file-upload mr-2 has-text-info"></i> Your Submissions</h5>
              <button class="button is-small is-ghost" title="Toggle section">
                <span class="icon is-small">
                  <i id="submissions-chevron" class="fas fa-chevron-<%= @submissions_collapsed ? 'right' : 'down' %>"></i>
                </span>
              </button>
            </div>
            <div id="submissions-content" class="p-4 has-background-white <%= 'is-hidden' if @submissions_collapsed %>">
              <% if @submissions.is_a?(Array) && !@submissions.empty? %>
                <% @submissions.each do |sub| %>
                  <div class="mb-4 box is-light">
                    <% if sub['SubmissionDate'] %>
                      <p class="is-size-7 has-text-grey mb-2">Submitted: <%= format_date(sub["SubmissionDate"]) %></p>
                    <% end %>
                    <% (sub['Files'] || []).each do |f| %>
                      <div class="is-flex is-justify-content-space-between is-align-items-center py-2 px-3 has-background-white mb-1" style="border: 1px solid #efefef; border-radius: 4px;">
                         <span><i class="fas fa-file mr-2 has-text-grey"></i><%= f['FileName'] %></span>
                         <a href="/course/<%= @course_id %>/download?path=<%= URI.encode_www_form_component("/d2l/api/le/1.40/#{@course_id}/dropbox/folders/#{@assignment_id}/submissions/#{sub['Id']}/files/#{f['FileId']}") %>&name=<%= URI.encode_www_form_component(f['FileName']) %>" class="button is-small is-white">
                           <span class="icon is-small"><i class="fas fa-download"></i></span>
                         </a>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              <% else %>
                 <p class="has-text-grey italic">No submission records found.</p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <script>
        function toggleSection(section) {
          const content = document.getElementById(section + '-content');
          const chevron = document.getElementById(section + '-chevron');
          const isHidden = content.classList.contains('is-hidden');
          
          if (isHidden) {
            content.classList.remove('is-hidden');
            chevron.classList.remove('fa-chevron-right');
            chevron.classList.add('fa-chevron-down');
          } else {
            content.classList.add('is-hidden');
            chevron.classList.remove('fa-chevron-down');
            chevron.classList.add('fa-chevron-right');
          }

          // Persistence via AJAX
          fetch('/course/<%= @course_id %>/discussions/toggle_collapse', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'topic_id=assignment:<%= @assignment_id %>&section=' + section
          });
        }

        function toggleOptional(id) {
          fetch(`/assignments/${id}/toggle_optional`, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          })
          .then(res => res.json())
          .then(data => {
            if (data.status === 'ok') {
              window.location.reload();
            }
          });
        }
      </script>

      <%# --- FALLBACK: GRADEBOOK COMMENTS --- %>
      <% if @grade_entry && @grade_entry['Comments'] && !(@grade_entry['Comments']['Text'] || "").strip.empty? %>
        <div class="mt-6">
           <h5 class="title is-5 mb-3"><i class="fas fa-award mr-2 has-text-warning"></i> Gradebook Comments</h5>
           <div class="box" style="border-left: 5px solid #ffdd57; background: #fffcf0;">
             <div class="content">
                <%= render_content(@grade_entry['Comments']['Html'] || @grade_entry['Comments']['Text']) %>
             </div>
             <div class="is-size-7 has-text-grey mt-2">
                Score: <strong><%= @grade_entry['DisplayedGrade'] %></strong> (<%= @grade_entry['PointsNumerator'] %> / <%= @grade_entry['PointsDenominator'] %>)
             </div>
           </div>
        </div>
      <% end %>

    </div>
  </div>
</div>

<style>
  .section-details summary::-webkit-details-marker { display: none; }
  .section-details[open] summary .fa-chevron-down { transform: rotate(180deg); }
  .section-details summary .fa-chevron-down { transition: transform 0.2s ease-in-out; }
  .border-light { border: 1px solid #eee; border-top: none; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; }
</style>

<% if @assignment['Synthetic'] %>
<!-- Edit Modal -->
<div id="editModal" class="modal">
  <div class="modal-background" onclick="closeEditModal()"></div>
  <div class="modal-card">
    <header class="modal-card-head">
      <p class="modal-card-title">Edit Synthesized Task</p>
      <button class="delete" aria-label="close" onclick="closeEditModal()"></button>
    </header>
    <section class="modal-card-body">
      <form action="/course/<%= @course_id %>/assignments/<%= @assignment_id %>/update" method="POST">
        <div class="field">
          <label class="label">Task Name</label>
          <div class="control">
            <input class="input" type="text" name="name" value="<%= @assignment['Name'] %>" required>
          </div>
        </div>

        <div class="field">
          <label class="label">Due Date & Time</label>
          <div class="is-flex" style="gap: 10px;">
            <div class="control" style="flex: 1;">
              <% 
                tz_name = @user_prefs&.time_zone || "UTC"
                dt = @assignment['DueDate'] ? Time.parse(@assignment['DueDate']).in_time_zone(tz_name) : nil
              %>
              <input class="input" type="date" name="due_date" value="<%= dt ? dt.strftime('%Y-%m-%d') : '' %>">
            </div>
            <div class="control" style="flex: 1;">
              <input class="input" type="time" name="due_time" value="<%= dt ? dt.strftime('%H:%M') : '' %>">
            </div>
          </div>
          <p class="help">Time Zone: <%= tz_name %></p>
        </div>

        <div class="field">
          <label class="label">External URL / Reference</label>
          <div class="control">
            <input class="input" type="text" name="external_url" value="<%= @assignment['ExternalUrl'] %>" placeholder="https://...">
          </div>
        </div>

        <div class="field">
          <label class="label">Notes / Instructions</label>
          <div class="control">
            <textarea class="textarea" name="description" rows="5"><%= @assignment.dig('Instructions', 'Text') %></textarea>
          </div>
        </div>

        <div class="buttons is-right mt-5">
          <button type="button" class="button" onclick="closeEditModal()">Cancel</button>
          <button type="submit" class="button is-primary">Save Changes</button>
        </div>
      </form>
    </section>
  </div>
</div>

<script>
function openEditModal() {
  const modal = document.getElementById('editModal');
  modal.classList.add('is-active');
  document.documentElement.classList.add('is-clipped');
}

function closeEditModal() {
  const modal = document.getElementById('editModal');
  modal.classList.remove('is-active');
  document.documentElement.classList.remove('is-clipped');
}
</script>
<% end %>

<% if @edit_mode %>
<script>
  document.addEventListener('DOMContentLoaded', openEditModal);
</script>
<% end %>
