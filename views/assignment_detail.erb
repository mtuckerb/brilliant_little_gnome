<%= erb :'partials/course_detail_header' %>
<div class="columns">
  <div class="column is-3">
    <%= erb :'partials/sidebar' %>
  </div>
  <div class="column is-9">
    <div class="box">
      <nav class="breadcrumb is-small" aria-label="breadcrumbs">
        <ul>
          <li><a href="/course/<%= @course_id %>/assignments">Assignments</a></li>
          <li class="is-active"><a href="#" aria-current="page"><%= @assignment['Name'] %></a></li>
        </ul>
      </nav>

      <div class="level">
        <div class="level-left">
          <h4 class="title is-4"><%= @assignment['Name'] %></h4>
        </div>
        <div class="level-right">
          <div class="buttons">
            <a href="<%= $client.portal_url_for(:assignment, {course_id: @course_id, id: @assignment_id}) %>" class="button is-small is-link is-light" target="_blank">
              <span class="icon is-small"><i class="fas fa-external-link-alt"></i></span>
              <span>Open in Brightspace</span>
            </a>
            <span class="tag is-primary is-medium">
              Due: <%= @assignment['DueDate'] ? Time.parse(@assignment['DueDate']).strftime("%B %d, %Y %I:%M %p") : "No due date" %>
            </span>
          </div>
        </div>
      </div>

      <hr>

      <div class="content">
        <h6 class="subtitle is-6 has-text-grey uppercase">Instructions</h6>
        <% 
           desc = @assignment['Instructions']
           desc_text = desc.is_a?(Hash) ? (desc['Html'] || desc['Text'] || "") : desc.to_s
        %>
        <% if desc_text.strip.empty? %>
          <p class="has-text-grey-light italic">No specific instructions provided.</p>
        <% else %>
          <%= desc_text %>
        <% end %>
      </div>

      <% if @assignment['Attachments'] && !@assignment['Attachments'].empty? %>
        <div class="mt-6">
          <h6 class="subtitle is-6 has-text-grey uppercase">Attachments</h6>
          <div class="list is-hoverable">
            <% @assignment['Attachments'].each do |att| %>
              <div class="list-item">
                <div class="is-flex is-justify-content-space-between is-align-items-center">
                  <span><i class="fas fa-paperclip mr-2 has-text-grey"></i><%= att['FileName'] %></span>
                  <!-- Note: Assignment attachment downloads often have separate dedicated endpoints in D2L, 
                       but linking them would depend on the specific API version. For now we show the name. -->
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="notification is-info is-light mt-6">
        <i class="fas fa-info-circle mr-2"></i> Submissions must be handled through the official Brightspace portal.
      </div>
    </div>
  </div>
</div>
